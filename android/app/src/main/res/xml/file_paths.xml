<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Las fotos que escribe la cámara para "Enviar archivos". -->
    <cache-path name="photos" path="photos/" />
    <!-- El informe de conexión. Sin esta línea `getUriForFile` lanza IllegalArgumentException
         y el botón de compartir se quedaba mudo: la carpeta existía, pero no estaba declarada
         como compartible. Nada más de la app se expone. -->
    <cache-path name="diagnostico" path="diagnostico/" />
    <!-- Copias de la bandeja de un equipo, para «Abrir con…» un documento con otra app. -->
    <cache-path name="bandeja" path="bandeja/" />
</paths>

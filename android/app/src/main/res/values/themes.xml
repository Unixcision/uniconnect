<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UniConnect" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/night</item>
    </style>
    <style name="Theme.UniConnect.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/uniconnect_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.UniConnect</item>
    </style>
</resources>

    "uniconnect.localWindow.runtime.shell.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ وكيلًا عندما تحتاج إليه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrenite agenta kad god vam zatreba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start en agent, når du har brug for en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie einen Agenten, wann immer Sie einen benötigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start an agent whenever you need one."
          }
        },
        "es": {

    "settings.settingsJSON.file.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit UniConnect-owned app settings, shortcuts, automation, sidebar, notifications, and browser behavior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 管理のアプリ設定、ショートカット、オートメーション、サイドバー、通知、ブラウザ動作を編集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect가 관리하는 앱 설정, 단축키, 자동화, 사이드바, 알림, 브라우저 동작을 편집합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحرير إعدادات التطبيق المملوكة UniConnect والاختصارات والأتمتة والشريط الجانبي والإشعارات وسلوك المتصفح."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uredite postavke aplikacije, prečice, automatizaciju, bočnu traku, obavijesti i ponašanje preglednika u vlasništvu UniConnect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger UniConnect-ejede appindstillinger, genveje, automatisering, sidebjælke, meddelelser og browseradfærd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeiten Sie UniConnecteigene App-Einstellungen, Verknüpfungen, Automatisierung, Seitenleiste, Benachrichtigungen und Browserverhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita la configuración, los atajos, la automatización, la barra lateral, las notificaciones y el comportamiento del navegador de UniConnect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez les paramètres, les raccourcis, l'automatisation, la barre latérale, les notifications et le comportement du navigateur appartenant à UniConnect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica le impostazioni, i collegamenti, l'automazione, la barra laterale, le notifiche e il comportamento del browser delle app di proprietà di UniConnect."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កែសម្រួល UniConnect ការកំណត់កម្មវិធី ដែលជាកម្មសិទ្ធិ ផ្លូវកាត់ ស្វ័យប្រវត្តិកម្ម របារចំហៀង ការជូនដំណឹង និងឥរិយាបថកម្មវិធីរុករក។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger UniConnect-eide appinnstillinger, snarveier, automatisering, sidefelt, varsler og nettleseratferd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj ustawienia aplikacji, skróty, automatyzację, pasek boczny, powiadomienia i zachowanie przeglądarki, które należą do UniConnect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite as configurações, atalhos, automação, barra lateral, notificações e comportamento do navegador de aplicativos de propriedade de UniConnect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактируйте настройки приложений, принадлежащих UniConnect, ярлыки, автоматизацию, боковую панель, уведомления и поведение браузера."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขการตั้งค่าแอป ทางลัด ระบบอัตโนมัติ แถบด้านข้าง การแจ้งเตือน และพฤติกรรมของเบราว์เซอร์ UniConnect"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect'ye ait uygulama ayarlarını, kısayolları, otomasyonu, kenar çubuğunu, bildirimleri ve tarayıcı davranışını düzenleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагувати налаштування додатків, які належать UniConnect, ярлики, автоматизацію, бічну панель, сповіщення та поведінку браузера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑UniConnect拥有的应用程序设置、快捷方式、自动化、侧边栏、通知和浏览器行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯UniConnect擁有的應用程式設定、捷徑、自動化、側邊欄、通知和瀏覽器行為。"
          }
        }
      }
    },

    "sidebar.help.feedback.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many feedback attempts. Please try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックの送信回数が多すぎます。しばらくしてからもう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занадто багато спроб надсилання відгуку. Спробуйте пізніше."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백 시도가 너무 많습니다. 나중에 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا للتعليقات.يرجى المحاولة مرة أخرى في وقت لاحق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja povratnih informacija. Molimo pokušajte ponovo kasnije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange feedbackforsøg. Prøv venligst igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Feedbackversuche. Bitte versuchen Sie es später noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de retroalimentación. Inténtelo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives de feedback. Veuillez réessayer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi di feedback. Per favore riprova più tardi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការព្យាយាមមតិកែលម្អច្រើនពេក។សូមព្យាយាមម្តងទៀតនៅពេលក្រោយ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange tilbakemeldingsforsøk. Vennligst prøv igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób uzyskania informacji zwrotnej. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas de feedback. Por favor, tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток обратной связи. Пожалуйста, повторите попытку позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พยายามแสดงความคิดเห็นมากเกินไปโปรดลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla geri bildirim girişimi. Lütfen daha sonra tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太多的反馈尝试。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太多的回饋嘗試。請稍後重試。"
          }
        }
      }
    },

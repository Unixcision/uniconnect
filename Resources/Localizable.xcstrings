    "cli.rightSidebar.usage": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux right-sidebar <command> [flags]\n\nControla la barra lateral derecha desde la CLI.\n\nComandos:\n  toggle                         Alterna la visibilidad de la barra lateral derecha\n  show                           Muestra la barra lateral derecha\n  hide                           Oculta la barra lateral derecha\n  focus                          Enfoca el modo actual de la barra lateral derecha\n  set <files|find|vault|sessions|feed|dock>\n                                 Muestra, cambia de modo y enfoca\n  mode                           Imprime {\"visible\":bool,\"mode\":string}\n  files|find|vault|sessions|feed|dock\n                                 Alias de show + set + focus\n\nOpciones:\n  --workspace <id|ref|index>     Apunta a la ventana que contiene un espacio de trabajo\n  --window <id|ref|index>        Apunta a una ventana\n  --no-focus                     Con set, cambia de modo sin mover el foco\n\nEjemplos:\n  cmux right-sidebar toggle\n  cmux right-sidebar set find\n  cmux right-sidebar set vault --no-focus\n  cmux right-sidebar mode"
          }
        }
      }
    },
    "cli.sidebar.error.allWithName": {
      "extractionState": "manual",

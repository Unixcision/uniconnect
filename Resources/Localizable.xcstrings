          "stringUnit": {
            "state": "translated",
            "value": "%@ existe y no es una extensión UniConnect; dejándolo solo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe et n'est pas une extension UniConnect ; le laisser tranquille"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esiste e non è un'estensione UniConnect; lasciandolo stare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は存在しますが、UniConnect 拡張機能ではありません。放っておいて"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មានហើយមិនមែនជាផ្នែកបន្ថែម UniConnect ទេ។ទុកវាឱ្យនៅម្នាក់ឯង"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@가 존재하며 UniConnect 확장이 아닙니다.내버려두고"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eksisterer og er ikke en UniConnect-utvidelse; lar det være i fred"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ istnieje i nie jest rozszerzeniem UniConnect; zostawiając to w spokoju"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe e não é uma extensão UniConnect; deixando isso sozinho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ существует и не является расширением UniConnect; оставив это в покое"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ มีอยู่แล้วและไม่ใช่ส่วนขยาย UniConnectทิ้งมันไว้ตามลำพัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mevcuttur ve bir UniConnect uzantısı değildir; onu yalnız bırakmak"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ існує і не є розширенням UniConnect; залишаючи це в спокої"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 存在，但不是 UniConnect 扩展；不理会它"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 存在，但不是 UniConnect 擴充；不理會它"
          }
        }
      }
    },

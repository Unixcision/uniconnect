    "update.error.noInternet.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect can't reach the update server. Check your internet connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect はアップデートサーバーに接続できません。インターネット接続を確認してもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 无法连接到更新服务器。请检查互联网连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 無法連線至更新伺服器。請檢查您的網際網路連線後再試一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect에서 업데이트 서버에 연결할 수 없습니다. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kann den Update-Server nicht erreichen. Überprüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no puede acceder al servidor de actualizaciones. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ne peut pas atteindre le serveur de mises à jour. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non riesce a raggiungere il server degli aggiornamenti. Controlla la connessione a internet e riprova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kan ikke nå opdateringsserveren. Kontroller din internetforbindelse, og prøv igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie może połączyć się z serwerem aktualizacji. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не может связаться с сервером обновлений. Проверьте подключение к интернету и повторите попытку."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ne može dosegnuti server za ažuriranje. Provjerite internetsku vezu i pokušajte ponovo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ UniConnect الوصول إلى خادم التحديثات. تحقق من اتصال الإنترنت وحاول مجددًا."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kan ikke nå oppdateringsserveren. Kontroller internettforbindelsen og prøv igjen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O UniConnect não consegue acessar o servidor de atualização. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่สามารถเข้าถึงเซิร์ฟเวอร์อัปเดตได้ ตรวจสอบการเชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect güncelleme sunucusuna ulaşamıyor. İnternet bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не може зв'язатися з сервером оновлень. Перевірте підключення до інтернету та спробуйте ще раз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect មិនអាចទៅដល់ម៉ាស៊ីនមេធ្វើបច្ចុប្បន្នភាពបានទេ។ពិនិត្យការតភ្ជាប់អ៊ីនធឺណិតរបស់អ្នក ហើយព្យាយាមម្តងទៀត។"
          }
        }
      }
    },

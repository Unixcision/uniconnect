    "cli.hooks.error.configDirectoryIsFile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect could not create the hooks directory: a file exists at %@; remove or rename the conflicting file and re-run `cmux hooks setup`"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على UniConnect إنشاء دليل hooks: يوجد ملف في %@؛قم بإزالة الملف المتعارض أو إعادة تسميته وأعد تشغيل `cmux hooks setup`"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nije mogao kreirati hooks direktorij: datoteka postoji na %@; uklonite ili preimenujte konfliktnu datoteku i ponovo pokrenite `cmux hooks setup`"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke oprette mappen hooks: Der findes en fil på %@; fjern eller omdøb den modstridende fil, og kør `cmux hooks setup` igen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect konnte das Verzeichnis hooks nicht erstellen: Eine Datei ist unter %@ vorhanden; Entfernen Sie die Konfliktdatei oder benennen Sie sie um und führen Sie `cmux hooks setup` erneut aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no pudo crear el directorio hooks: existe un archivo en %@; elimine o cambie el nombre del archivo en conflicto y vuelva a ejecutar `cmux hooks setup`"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect n'a pas pu créer le répertoire hooks : un fichier existe dans %@ ; supprimez ou renommez le fichier en conflit et réexécutez `cmux hooks setup`"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non è riuscito a creare la directory hooks: esiste un file in %@; rimuovere o rinominare il file in conflitto ed eseguire nuovamente `cmux hooks setup`"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect は hooks ディレクトリを作成できませんでした。ファイルは %@ に存在します。競合するファイルを削除するか名前を変更して、`cmux hooks setup` を再実行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect មិនអាចបង្កើតថត hooks បានទេ៖ ឯកសារមាននៅ %@; លុប ឬប្តូរឈ្មោះឯកសារដែលមានជម្លោះ ហើយដំណើរការ `cmux hooks setup` ឡើងវិញ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect가 hooks 디렉터리를 생성할 수 없습니다. 파일이 %@에 존재합니다.충돌하는 파일을 제거하거나 이름을 바꾸고 `cmux hooks setup`를 다시 실행하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke opprette hooks-katalogen: det finnes en fil på %@; fjern eller gi nytt navn til den konfliktende filen og kjør `cmux hooks setup` på nytt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie mógł utworzyć katalogu hooks: plik istnieje pod adresem %@; usuń lub zmień nazwę pliku będącego w konflikcie i uruchom ponownie `cmux hooks setup`"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect não pôde criar o diretório hooks: existe um arquivo em %@; remova ou renomeie o arquivo conflitante e execute novamente `cmux hooks setup`"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не удалось создать каталог hooks: файл существует по адресу %@; удалите или переименуйте конфликтующий файл и перезапустите `cmux hooks setup`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่สามารถสร้างไดเร็กทอรี hooks ได้: มีไฟล์อยู่ที่ %@; ลบหรือเปลี่ยนชื่อไฟล์ที่ขัดแย้งกันและรัน `cmux hooks setup` อีกครั้ง"
          }
        },

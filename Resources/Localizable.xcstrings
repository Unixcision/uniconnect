    "claudeUpdate.recovery.failureDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ UniConnect بمجلة الاسترداد وسيعيد المحاولة دون بدء جلسة مكررة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect je zadržao dnevnik oporavka i pokušat će ponovo bez pokretanja duple sesije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect beholdt genoprettelsesjournalen og vil prøve igen uden at starte en dubletsession."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect hat das Wiederherstellungsjournal beibehalten und versucht es erneut, ohne eine doppelte Sitzung zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kept the recovery journal and will retry without starting a duplicate session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect mantuvo el diario de recuperación y lo volverá a intentar sin iniciar una sesión duplicada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect a conservé le journal de récupération et réessayera sans démarrer de session en double."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ha conservato il journal di ripristino e riproverà senza avviare una sessione duplicata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect はリカバリ ジャーナルを保持しており、重複セッションを開始せずに再試行します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect បានរក្សាទុកទិនានុប្បវត្តិសង្គ្រោះ ហើយនឹងព្យាយាមម្តងទៀតដោយមិនចាប់ផ្តើមវគ្គស្ទួន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect는 복구 저널을 보관했으며 중복 세션을 시작하지 않고 다시 시도합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect beholdt gjenopprettingsjournalen og vil prøve på nytt uten å starte en duplikatøkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect zachował dziennik odzyskiwania i spróbuje ponownie bez rozpoczynania zduplikowanej sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect manteve o diário de recuperação e tentará novamente sem iniciar uma sessão duplicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect сохранил журнал восстановления и повторит попытку без запуска дублирующего сеанса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect เก็บบันทึกการกู้คืนไว้และจะลองอีกครั้งโดยไม่เริ่มเซสชันซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kurtarma günlüğünü tuttu ve yinelenen bir oturum başlatmadan yeniden deneyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect зберіг журнал відновлення та повторить спробу без повторного сеансу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 保留恢复日志并将重试而不启动重复会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 保留復原日誌並將重試而不啟動重複會話。"
          }
        }
      }
    },
    "claudeUpdate.recovery.failureTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {

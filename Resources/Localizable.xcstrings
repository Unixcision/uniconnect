    "uniconnect.import.error.backupFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pre-import recovery backup could not be created. No changes were made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la copia de recuperación previa a la importación. No se realizó ningún cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート前の復旧バックアップを作成できませんでした。変更は行われませんでした。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إنشاء النسخة الاحتياطية لاسترداد ما قبل الاستيراد. لم يتم إجراء أي تغييرات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosna kopija za oporavak prije uvoza nije mogla biti kreirana. Nisu napravljene nikakve promjene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendannelsessikkerhedskopien før import kunne ikke oprettes. Der blev ikke foretaget ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellungs-Backup vor dem Import konnte nicht erstellt werden. Es wurden keine Änderungen vorgenommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde de récupération avant importation n'a pas pu être créée. Aucune modification n'a été apportée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare il backup di ripristino pre-importazione. Non è stata apportata alcuna modifica."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការ​បម្រុង​ទុក​ការ​ងើប​ឡើង​វិញ​មុន​ការ​នាំ​ចូល​មិន​អាច​ត្រូវ​បាន​បង្កើត​ឡើង​។ គ្មានការកែប្រែណាមួយត្រូវបានធ្វើឡើងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 전 복구 백업을 생성할 수 없습니다. 변경사항이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprettingssikkerhetskopien før import kunne ikke opprettes. Ingen endringer ble gjort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można utworzyć kopii zapasowej odzyskiwania przed importem. Nie wprowadzono żadnych zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup de recuperação pré-importação não pôde ser criado. Nenhuma alteração foi feita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать резервную копию для восстановления перед импортом. Никаких изменений не произошло."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถสร้างการสำรองข้อมูลการกู้คืนก่อนนำเข้าได้ ไม่มีการเปลี่ยนแปลงใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarma öncesi kurtarma yedeği oluşturulamadı. Hiçbir değişiklik yapılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося створити резервну копію відновлення перед імпортом. Жодних змін не внесено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建导入前恢复备份。没有进行任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立匯入前復原備份。沒有進行任何更改。"
          }
        }
      }
    },
    "uniconnect.import.error.creationRolledBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workspace could not be created. UniConnect rolled back the local import state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear un espacio de trabajo. UniConnect revirtió el estado local de la importación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースを作成できませんでした。UniConnectはローカルのインポート状態を元に戻しました。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إنشاء مساحة عمل. قام UniConnect بإرجاع حالة الاستيراد المحلية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Radni prostor nije mogao biti kreiran. UniConnect je vratio stanje lokalnog uvoza."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et arbejdsområde kunne ikke oprettes. UniConnect rullede den lokale importtilstand tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Arbeitsbereich konnte nicht erstellt werden. UniConnect hat den lokalen Importstatus zurückgesetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace de travail n'a pas pu être créé. UniConnect a annulé l'état d'importation local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare uno spazio di lavoro. UniConnect ha ripristinato lo stato di importazione locale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កន្លែងធ្វើការមិនអាចបង្កើតបានទេ។ UniConnect ត្រលប់មកវិញនូវស្ថានភាពនាំចូលក្នុងស្រុក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업공간을 생성할 수 없습니다. UniConnect는 로컬 가져오기 상태를 롤백했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et arbeidsområde kunne ikke opprettes. UniConnect rullet tilbake den lokale importtilstanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można utworzyć obszaru roboczego. UniConnect wycofał stan importu lokalnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar uma área de trabalho. UniConnect reverteu o estado de importação local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать рабочую область. UniConnect откатил состояние локального импорта."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถสร้างพื้นที่ทำงานได้ UniConnect ย้อนกลับสถานะการอิมพอร์ตโลคัล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma alanı oluşturulamadı. UniConnect yerel içe aktarma durumunu geri aldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося створити робочу область. UniConnect відкотив стан локального імпорту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建工作区。 UniConnect 回滚本地导入状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立工作區。 UniConnect 回滾本機匯入狀態。"
          }
        }
      }
    },
    "uniconnect.import.error.invalidSelection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The import selection is no longer valid. Review the import again; no changes were made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección de importación ya no es válida. Revisa de nuevo la importación; no se realizó ningún cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートの選択内容が無効になりました。もう一度確認してください。変更は行われませんでした。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد اختيار الاستيراد صالحًا. قم بمراجعة الاستيراد مرة أخرى؛ لم يتم إجراء أي تغييرات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbor uvoza više nije važeći. Ponovo pregledajte uvoz; promjene nisu napravljene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importvalget er ikke længere gyldigt. Gennemgå importen igen; der blev ikke foretaget ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Importauswahl ist nicht mehr gültig. Überprüfen Sie den Import noch einmal. Es wurden keine Änderungen vorgenommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sélection d'importation n'est plus valide. Vérifiez à nouveau l'importation ; aucun changement n'a été apporté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La selezione di importazione non è più valida. Rivedi nuovamente l'importazione; non sono state apportate modifiche."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជ្រើសរើសការនាំចូលមិនមានសុពលភាពទៀតទេ។ ពិនិត្យមើលការនាំចូលម្តងទៀត; គ្មាន​ការ​ផ្លាស់​ប្តូ​រ​ត្រូវ​បាន​ធ្វើ​ឡើង​។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 선택이 더 이상 유효하지 않습니다. 가져오기를 다시 검토하세요. 변경 사항이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importvalget er ikke lenger gyldig. Gå gjennom importen på nytt; ingen endringer ble gjort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybór importu nie jest już ważny. Przejrzyj ponownie import; nie wprowadzono żadnych zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção de importação não é mais válida. Revise a importação novamente; nenhuma alteração foi feita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор импорта больше не действителен. Просмотрите импорт еще раз; никаких изменений не произошло."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลือกการนำเข้าไม่ถูกต้องอีกต่อไป ตรวจสอบการนำเข้าอีกครั้ง ไม่มีการเปลี่ยนแปลงใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarma seçimi artık geçerli değil. İçe aktarmayı tekrar gözden geçirin; hiçbir değişiklik yapılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір імпорту більше недійсний. Перегляньте імпорт ще раз; змін не було внесено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入选择不再有效。再次审核导入；没有做任何改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導入選擇不再有效。再次審核導入；沒有做任何改變。"
          }
        }
      }
    },
    "uniconnect.import.error.noHostWorkspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no main workspace available for this import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún espacio de trabajo principal disponible para esta importación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインポートに使用できるメインワークスペースがありません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة عمل رئيسية متاحة لهذا الاستيراد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema dostupnog glavnog radnog prostora za ovaj uvoz."
          }

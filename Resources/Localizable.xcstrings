        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个智能体需要你的关注"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某個代理程式需要你的注意"
          }
        }
      }
    },

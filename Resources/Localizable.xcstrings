    "settings.app.commandPaletteSearchAllSurfaces.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd+P also matches terminal, browser, and markdown surfaces across workspaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

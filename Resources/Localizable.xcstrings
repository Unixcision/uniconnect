    "uniconnect.localWindow.forget.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect will remove this saved session link from the window. The other conversation history and files in the box stay untouched."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي UniConnect إلى إزالة رابط الجلسة المحفوظة هذه من النافذة. يظل سجل المحادثات والملفات الأخرى الموجودة في المربع دون تغيير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect će ukloniti ovu sačuvanu vezu sesije iz prozora. Ostala historija razgovora i fajlovi u kutiji ostaju netaknuti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect vil fjerne dette gemte sessionslink fra vinduet. Den anden samtalehistorik og filer i boksen forbliver urørt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect entfernt diesen gespeicherten Sitzungslink aus dem Fenster. Der andere Gesprächsverlauf und die Dateien in der Box bleiben davon unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect eliminará de la ventana este enlace a la sesión guardada. El resto del historial de conversaciones y los archivos de la caja no cambiarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect supprimera ce lien de session enregistré de la fenêtre. Les autres historiques de conversations et fichiers contenus dans la boîte restent intacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect rimuoverà questo collegamento alla sessione salvata dalla finestra. L'altra cronologia delle conversazioni e i file nella casella rimangono intatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect は、この保存されたセッション リンクをウィンドウから削除します。ボックス内の他の会話履歴とファイルはそのまま残ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect នឹងលុបតំណភ្ជាប់សម័យដែលបានរក្សាទុកនេះចេញពីបង្អួច។ ប្រវត្តិសន្ទនា និងឯកសារផ្សេងទៀតនៅក្នុងប្រអប់នៅតែមិនប៉ះពាល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect은 저장된 세션 링크를 창에서 제거합니다. 상자에 있는 다른 대화 기록과 파일은 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect vil fjerne denne lagrede øktlinken fra vinduet. Den andre samtaleloggen og filene i boksen forblir urørt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect usunie z okna link do zapisanej sesji. Pozostała historia rozmów i pliki w skrzynce pozostają nietknięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect removerá este link de sessão salva da janela. O outro histórico de conversas e arquivos na caixa permanecem intactos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect удалит ссылку на сохраненный сеанс из окна. Другая история разговоров и файлы в ящике остаются нетронутыми."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect จะลบลิงก์เซสชันที่บันทึกไว้นี้ออกจากหน้าต่าง ประวัติการสนทนาและไฟล์อื่นๆ ในกล่องจะไม่ถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect bu kaydedilen oturum bağlantısını pencereden kaldıracaktır. Kutudaki diğer konuşma geçmişine ve dosyalara dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect видалить це збережене посилання сеансу з вікна. Інша історія розмов і файли в коробці залишаються недоторканими."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 将从窗口中删除此已保存的会话链接。框中的其他对话历史记录和文件保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 將從視窗中刪除此已儲存的會話連結。框中的其他對話歷史記錄和文件保持不變。"
          }
        }
      }
    },

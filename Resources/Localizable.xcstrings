        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ ملف التشخيص.انقر للكشف عنه في Finder."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijagnostički fajl je sačuvan. Kliknite da ga otkrijete u Finder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostisk fil gemt. Klik for at afsløre det i Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosedatei gespeichert. Klicken Sie, um es in Finder anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",

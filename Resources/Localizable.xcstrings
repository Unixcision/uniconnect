    "claudeUpdate.error.recoveryRequired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب استعادة جلسات Claude المعلقة قبل بدء التحديث الجديد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude sesije na čekanju moraju se vratiti prije nego što novo ažuriranje može početi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afventende Claude-sessioner skal gendannes, før en ny opdatering kan starte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausstehende Claude-Sitzungen müssen wiederhergestellt werden, bevor ein neues Update gestartet werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending Claude sessions must be restored before a new update can start."
          }
        },

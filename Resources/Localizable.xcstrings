    "socketControl.cmuxOnly.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only processes started inside UniConnect terminals can send commands."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ターミナル内で起動したプロセスのみがコマンドを送信できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅允许在 UniConnect 终端内启动的进程发送命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在 UniConnect 終端機內啟動的程序可以傳送指令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 터미널 내에서 시작된 프로세스만 명령을 보낼 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Prozesse, die in UniConnect-Terminals gestartet wurden, können Befehle senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los procesos iniciados dentro de terminales de UniConnect pueden enviar comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les processus lancés dans les terminaux UniConnect peuvent envoyer des commandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i processi avviati nei terminali UniConnect possono inviare comandi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun processer startet i UniConnect-terminaler kan sende kommandoer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko procesy uruchomione wewnątrz terminali UniConnect mogą wysyłać polecenia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только процессы, запущенные в терминалах UniConnect, могут отправлять команды."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo procesi pokrenuti unutar UniConnect terminala mogu slati naredbe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط العمليات التي بدأت داخل طرفيات UniConnect يمكنها إرسال الأوامر."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",

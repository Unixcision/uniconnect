        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការប៉ះទង្គិច hooks គោលដៅ៖ ប្រើ --agent ឬគោលដៅទីតាំង មិនមែនទាំងពីរទេ។"
          }

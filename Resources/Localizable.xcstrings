    "uniconnect.ssh.edit.error.tmuxUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux session \"%@\" is not available through the new connection. Nothing was changed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux الجلسة \"%@\" غير متاحة من خلال الاتصال الجديد.لم يتغير شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux sesija \"%@\" nije dostupna preko nove veze. Ništa nije promijenjeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux session \"%@\" er ikke tilgængelig via den nye forbindelse. Intet blev ændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux Sitzung „%@“ ist über die neue Verbindung nicht verfügbar. Es wurde nichts geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión tmux \"%@\" no está disponible mediante la nueva conexión. No se ha cambiado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session tmux \"%@\" n'est pas disponible via la nouvelle connexion. Rien n'a été changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione tmux \"%@\" non è disponibile tramite la nuova connessione. Niente è stato cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux セッション \"%@ は、新しい接続では使用できません。何も変わりませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux សម័យ \"%@\" គឺមិនមានតាមរយៈការតភ្ជាប់ថ្មីទេ។គ្មានអ្វីត្រូវបានផ្លាស់ប្តូរទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux \"%@\" 세션은 새 연결을 통해 사용할 수 없습니다.아무것도 변경되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux økten \"%@\" er ikke tilgjengelig via den nye tilkoblingen. Ingenting ble endret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux sesja \"%@\" nie jest dostępna poprzez nowe połączenie. Nic nie zostało zmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux a sessão \"%@\" não está disponível por meio da nova conexão. Nada foi alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux сеанс «%@» недоступен через новое соединение. Ничего не изменилось."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux เซสชัน \"%@\" ไม่พร้อมใช้งานผ่านการเชื่อมต่อใหม่ไม่มีอะไรเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux \"%@\" oturumu yeni bağlantı üzerinden kullanılamıyor. Hiçbir şey değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux сесія \"%@\" недоступна через нове підключення. Нічого не змінилося."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux 会话“%@”无法通过新连接使用。一切都没有改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux 會話「%@」無法透過新連線使用。一切都沒有改變。"
          }
        }
      }
    },
    "uniconnect.ssh.edit.error.vault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted credential revision could not be saved. Nothing was changed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ مراجعة بيانات الاعتماد المشفرة.لم يتغير شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovana revizija akreditiva nije mogla biti sačuvana. Ništa nije promijenjeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den krypterede legitimationsrevision kunne ikke gemmes. Intet blev ændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verschlüsselte Revision der Anmeldeinformationen konnte nicht gespeichert werden. Es wurde nichts geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la revisión de credenciales cifradas. No se cambió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La révision des informations d'identification chiffrées n'a pas pu être enregistrée. Rien n'a été changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la revisione della credenziale crittografata. Niente è stato cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された認証情報のリビジョンを保存できませんでした。何も変わりませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការកែប្រែព័ត៌មានសម្ងាត់ដែលបានអ៊ិនគ្រីបមិនអាចរក្សាទុកបានទេ។គ្មានអ្វីត្រូវបានផ្លាស់ប្តូរទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 자격 증명 개정을 저장할 수 없습니다.아무것도 변경되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den krypterte legitimasjonsrevisjonen kunne ikke lagres. Ingenting ble endret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać zaszyfrowanej wersji poświadczeń. Nic nie zostało zmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A revisão da credencial criptografada não pôde ser salva. Nada foi alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить зашифрованную версию учетных данных. Ничего не изменилось."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกการแก้ไขข้อมูลประจำตัวที่เข้ารหัสได้ไม่มีอะไรเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrelenmiş kimlik bilgisi revizyonu kaydedilemedi. Hiçbir şey değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти редакцію зашифрованих облікових даних. Нічого не змінилося."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存加密的凭据修订。一切都没有改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存加密的憑證修訂。一切都沒有改變。"
          }
        }
      }
    },

    "uniconnect.localWindow.error.actionUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That saved window action is no longer available."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد إجراء النافذة المحفوظة متاحًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta radnja sačuvanog prozora više nije dostupna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gemte vindueshandling er ikke længere tilgængelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese gespeicherte Fensteraktion ist nicht mehr verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa acción de ventana guardada ya no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action de fenêtre enregistrée n'est plus disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'azione della finestra salvata non è più disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたウィンドウ アクションは利用できなくなりました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សកម្មភាពវិនដូដែលបានរក្សាទុកនោះលែងមានទៀតហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 창 작업은 더 이상 사용할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lagrede vindushandlingen er ikke lenger tilgjengelig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisana akcja okna nie jest już dostępna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa ação de janela salva não está mais disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сохраненное действие окна больше не доступно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำงานของหน้าต่างที่บันทึกไว้นั้นไม่สามารถใช้งานได้อีกต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen bu pencere eylemi artık kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збережена дія вікна більше не доступна."
          }
        },
        "zh-Hans": {
          "stringUnit": {

    "settings.browser.customSearchEngineURLTemplate.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {query} or %s for the search terms. Without a placeholder, UniConnect appends q=."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم {query} أو %s لعبارات البحث. بدون عنصر نائب، يضيف UniConnect q=."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite {query} ili %s za pojmove pretrage. Bez rezerviranog mjesta UniConnect dodaje q=."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug {query} eller %s til søgeordene. Uden en pladsholder tilføjer UniConnect q=."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende {query} oder %s für die Suchbegriffe. Ohne Platzhalter fügt UniConnect q= hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa {query} o %s para los términos de búsqueda. Sin marcador de posición, UniConnect agrega q=."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez {query} ou %s pour les termes de recherche. Sans espace réservé, UniConnect ajoute q=."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa {query} o %s per i termini di ricerca. Senza segnaposto, UniConnect aggiunge q=."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索語には {query} または %s を使います。プレースホルダーがない場合、UniConnect は q= を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색어에는 {query} 또는 %s를 사용하세요. 자리표시자가 없으면 UniConnect가 q=를 추가합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk {query} eller %s for søkeordene. Uten plassholder legger UniConnect til q=."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj {query} lub %s dla wyszukiwanych terminów. Bez symbolu zastępczego UniConnect doda q=."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {query} ou %s para os termos de busca. Sem marcador, o UniConnect adiciona q=."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте {query} или %s для поисковых запросов. Без заполнителя UniConnect добавляет q=."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ {query} หรือ %s สำหรับคำค้นหา หากไม่มีตัวยึดตำแหน่ง UniConnect จะเพิ่ม q="
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama terimleri için {query} veya %s kullanın. Yer tutucu yoksa UniConnect q= ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте {query} або %s для пошукових запитів. Без заповнювача UniConnect додає q=."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 {query} 或 %s 作为搜索词。没有占位符时，UniConnect 会追加 q=。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 {query} 或 %s 作為搜尋詞。沒有佔位符時，UniConnect 會附加 q=。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រើ {query} ឬ %s សម្រាប់ពាក្យស្វែងរក។បើគ្មានកន្លែងដាក់ UniConnect បន្ថែម q= ។"
          }
        }
      }
    },

    "uniconnect.ssh.failure.authentication": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication was rejected. Check the user, password, or key in the connection command."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض المصادقة.تحقق من المستخدم أو كلمة المرور أو المفتاح في أمر الاتصال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentifikacija je odbijena. Provjerite korisnika, lozinku ili unesite naredbu za povezivanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkendelse blev afvist. Kontroller brugeren, adgangskoden eller indtast forbindelseskommandoen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung wurde abgelehnt. Überprüfen Sie den Benutzer, das Passwort oder den Schlüssel im Verbindungsbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha rechazado la autenticación. Comprueba el usuario, la contraseña o la clave del comando de conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification a été rejetée. Vérifiez l'utilisateur, le mot de passe ou la saisie de la commande de connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autenticazione è stata rifiutata. Controllare l'utente, la password o la chiave nel comando di connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証が拒否されました。接続コマンドのユーザー、パスワード、またはキーを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្ទៀងផ្ទាត់ត្រូវបានបដិសេធ។ពិនិត្យអ្នកប្រើប្រាស់ ពាក្យសម្ងាត់ ឬសោនៅក្នុងពាក្យបញ្ជាការតភ្ជាប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증이 거부되었습니다.연결 명령에서 사용자, 비밀번호, 키를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentisering ble avvist. Kontroller brukeren, passordet eller tast inn tilkoblingskommandoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnienie zostało odrzucone. Sprawdź użytkownika, hasło lub klucz w poleceniu połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação foi rejeitada. Verifique o usuário, senha ou chave no comando de conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутентификация была отклонена. Проверьте пользователя, пароль или ключ в команде подключения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การรับรองความถูกต้องถูกปฏิเสธตรวจสอบผู้ใช้ รหัสผ่าน หรือคีย์ในคำสั่งการเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik doğrulama reddedildi. Bağlantı komutundaki kullanıcıyı, parolayı veya anahtarı kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автентифікацію відхилено. Перевірте користувача, пароль або ключ у команді підключення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份验证被拒绝。检查连接命令中的用户、密码或密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身份驗證被拒絕。檢查連線命令中的使用者、密碼或金鑰。"
          }
        }
      }
    },
    "uniconnect.ssh.failure.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not be reached (connection refused or no response). Check the firewall, port, and network."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الوصول إلى الخادم (تم رفض الاتصال أو عدم الاستجابة). تحقق من جدار الحماية والمنفذ والشبكة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće pristupiti serveru (veza je odbijena ili nema odgovora). Provjerite zaštitni zid, port i mrežu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren kunne ikke nås (forbindelse afvist eller intet svar). Tjek firewall, port og netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server konnte nicht erreicht werden (Verbindung abgelehnt oder keine Antwort). Überprüfen Sie Firewall, Port und Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar al servidor (conexión rechazada o sin respuesta). Verifique el firewall, el puerto y la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'est pas joignable (connexion refusée ou pas de réponse). Vérifiez le pare-feu, le port et le réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il server (connessione rifiutata o nessuna risposta). Controlla il firewall, la porta e la rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに到達できませんでした (接続が拒否されたか、応答がありません)。ファイアウォール、ポート、ネットワークを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស៊ីនមេមិនអាចទាក់ទងបានទេ (ការតភ្ជាប់បានបដិសេធ ឬគ្មានការឆ្លើយតប)។ពិនិត្យជញ្ជាំងភ្លើង ច្រក និងបណ្តាញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다(연결이 거부되었거나 응답이 없음). 방화벽, 포트, 네트워크를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren kunne ikke nås (tilkoblingen ble nektet eller ingen respons). Sjekk brannmuren, porten og nettverket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie był osiągalny (odmowa połączenia lub brak odpowiedzi). Sprawdź zaporę sieciową, port i sieć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não pôde ser alcançado (conexão recusada ou nenhuma resposta). Verifique o firewall, a porta e a rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться с сервером (соединение отклонено или нет ответа). Проверьте брандмауэр, порт и сеть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเข้าถึงเซิร์ฟเวอร์ (การเชื่อมต่อถูกปฏิเสธหรือไม่ตอบสนอง)ตรวจสอบไฟร์วอลล์ พอร์ต และเครือข่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuya ulaşılamadı (bağlantı reddedildi veya yanıt yok). Güvenlik duvarını, bağlantı noktasını ve ağı kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо отримати доступ до сервера (відмова у з’єднанні або відсутність відповіді). Перевірте брандмауер, порт і мережу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问服务器（连接被拒绝或无响应）。检查防火墙、端口和网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取伺服器（連線被拒絕或無回應）。檢查防火牆、連接埠和網路。"
          }
        }
      }
    },
    "uniconnect.ssh.failure.hostResolution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host could not be resolved. Check the server name or IP address."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حل المضيف.تحقق من اسم الخادم أو عنوان IP."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Domaćin nije mogao biti riješen. Provjerite ime servera ili IP adresu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værten kunne ikke løses. Tjek servernavnet eller IP-adressen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Host konnte nicht aufgelöst werden. Überprüfen Sie den Servernamen oder die IP-Adresse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo resolver el host. Comprueba el nombre o la dirección IP del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hôte n'a pas pu être résolu. Vérifiez le nom du serveur ou l'adresse IP."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile risolvere l'host. Controlla il nome del server o l'indirizzo IP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストを解決できませんでした。サーバー名またはIPアドレスを確認してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម្ចាស់ផ្ទះមិនអាចដោះស្រាយបានទេ។ពិនិត្យឈ្មោះម៉ាស៊ីនមេ ឬអាសយដ្ឋាន IP ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트를 확인할 수 없습니다.서버 이름이나 IP 주소를 확인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verten kunne ikke løses. Sjekk servernavnet eller IP-adressen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ustalić hosta. Sprawdź nazwę serwera lub adres IP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O host não pôde ser resolvido. Verifique o nome do servidor ou endereço IP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось разрешить хост. Проверьте имя или IP-адрес сервера."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถแก้ไขโฮสต์ได้ตรวจสอบชื่อเซิร์ฟเวอร์หรือที่อยู่ IP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana makine çözülemedi. Sunucu adını veya IP adresini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося вирішити хост. Перевірте назву сервера або IP-адресу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "楼主无法解决。检查服务器名称或 IP 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "樓主無法解決。檢查伺服器名稱或 IP 位址。"
          }
        }
      }
    },
    "uniconnect.ssh.failure.packageManager": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No supported package manager was found. Install tmux manually and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على مدير حزمة مدعوم.قم بتثبيت tmux يدويًا وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije pronađen nijedan podržani upravitelj paketa. Instalirajte tmux ručno i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet nogen understøttet pakkehåndtering. Installer tmux manuelt, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein unterstützter Paketmanager gefunden. Installieren Sie tmux manuell und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún gestor de paquetes compatible. Instala tmux manualmente y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun gestionnaire de packages pris en charge n'a été trouvé. Installez tmux manuellement et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato trovato alcun gestore di pacchetti supportato. Installa tmux manualmente e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされているパッケージ マネージャーが見つかりませんでした。tmux を手動でインストールし、再試行してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រកមិនឃើញកម្មវិធីគ្រប់គ្រងកញ្ចប់ដែលគាំទ្រទេ។ដំឡើង tmux ដោយដៃ ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되는 패키지 관리자를 찾을 수 없습니다.tmux을 수동으로 설치하고 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen støttet pakkebehandling ble funnet. Installer tmux manuelt og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono obsługiwanego menedżera pakietów. Zainstaluj tmux ręcznie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum gerenciador de pacotes compatível foi encontrado. Instale tmux manualmente e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживаемый менеджер пакетов не найден. Установите tmux вручную и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบตัวจัดการแพ็คเกจที่รองรับติดตั้ง tmux ด้วยตนเองแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen paket yöneticisi bulunamadı.tmux'yi manuel olarak yükleyin ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не знайдено жодного підтримуваного менеджера пакетів. Встановіть tmux вручну та повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到受支持的包管理器。手动安装tmux并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到受支援的套件管理器。手動安裝tmux並重試。"
          }
        }
      }
    },

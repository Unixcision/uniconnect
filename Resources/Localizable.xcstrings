    "uniconnect.localWindow.missingRoot.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect did not start anything because %@ is unavailable. Choose its new folder to keep this window and all saved conversations recoverable."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect لم يبدأ أي شيء لأن %@ غير متوفر. اختر المجلد الجديد الخاص به لإبقاء هذه النافذة وجميع المحادثات المحفوظة قابلة للاسترداد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nije pokrenuo ništa jer %@ nije dostupan. Odaberite njegovu novu mapu kako biste ovaj prozor i sve sačuvane razgovore mogli oporaviti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect startede ikke noget, fordi %@ ikke er tilgængelig. Vælg dens nye mappe for at holde dette vindue og alle gemte samtaler gendannes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect hat nichts gestartet, da %@ nicht verfügbar ist. Wählen Sie den neuen Ordner aus, damit dieses Fenster und alle gespeicherten Konversationen wiederherstellbar bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no ha iniciado nada porque %@ no está disponible. Elige su nueva carpeta para conservar esta ventana y recuperar todas las conversaciones guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect n'a rien démarré car %@ n'est pas disponible. Choisissez son nouveau dossier pour conserver cette fenêtre et toutes les conversations enregistrées récupérables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non ha avviato nulla perché %@ non è disponibile. Scegli la sua nuova cartella per mantenere recuperabili questa finestra e tutte le conversazioni salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が利用できないため、UniConnect は何も開始しませんでした。このウィンドウと保存されているすべての会話を復元できるようにするには、新しいフォルダーを選択します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect មិនបានចាប់ផ្តើមអ្វីទេព្រោះ %@ មិនអាចប្រើបាន។ ជ្រើសរើសថតថ្មីរបស់វា ដើម្បីរក្សាបង្អួចនេះ និងការសន្ទនាដែលបានរក្សាទុកទាំងអស់អាចសង្គ្រោះបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect은 %@을 사용할 수 없기 때문에 아무것도 시작하지 않았습니다. 이 창과 저장된 모든 대화를 복구 가능하게 유지하려면 새 폴더를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect startet ikke noe fordi %@ er utilgjengelig. Velg den nye mappen for å holde dette vinduet og alle lagrede samtaler gjenopprettelige."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect niczego nie uruchomił, ponieważ %@ jest niedostępny. Wybierz nowy folder, aby to okno i wszystkie zapisane rozmowy można było odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect não iniciou nada porque %@ não está disponível. Escolha sua nova pasta para manter esta janela e todas as conversas salvas recuperáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ничего не запускал, поскольку %@ недоступен. Выберите новую папку, чтобы сохранить это окно и все сохраненные разговоры."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่ได้เริ่มอะไรเลยเนื่องจาก %@ ไม่พร้อมใช้งาน เลือกโฟลเดอร์ใหม่เพื่อให้หน้าต่างนี้และการสนทนาที่บันทึกไว้ทั้งหมดสามารถกู้คืนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect hiçbir şey başlatmadı çünkü %@ kullanılamıyor. Bu pencereyi ve kayıtlı tüm konuşmaları kurtarılabilir halde tutmak için yeni klasörünü seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect нічого не запустив, тому що %@ недоступний. Виберіть його нову папку, щоб зберегти це вікно та всі збережені розмови."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 没有启动任何内容，因为 %@ 不可用。选择其新文件夹以使该窗口和所有已保存的对话保持可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 沒有啟動任何內容，因為 %@ 不可用。選擇其新資料夾以使該視窗和所有已儲存的對話保持可恢復。"
          }
        }
      }
    },

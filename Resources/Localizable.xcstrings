    "uniconnect.import.preview.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review every workspace before importing. Stable identities are matched before names."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa cada espacio de trabajo antes de importar. Las identidades estables se comparan antes que los nombres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート前にすべてのワークスペースを確認してください。名前より先に安定した識別子で照合します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بمراجعة كل مساحة عمل قبل الاستيراد. تتم مطابقة الهويات الثابتة قبل الأسماء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledajte svaki radni prostor prije uvoza. Stabilni identiteti se poklapaju prije imena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgå alle arbejdsområder før import. Stabile identiteter matches før navne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie jeden Arbeitsbereich vor dem Import. Stabile Identitäten werden vor Namen abgeglichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez chaque espace de travail avant de l'importer. Les identités stables sont mises en correspondance avant les noms."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi ogni spazio di lavoro prima dell'importazione. Le identità stabili vengono abbinate prima dei nomi."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពិនិត្យរាល់កន្លែងធ្វើការមុនពេលនាំចូល។ អត្តសញ្ញាណដែលមានស្ថេរភាពត្រូវបានផ្គូផ្គងមុនឈ្មោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 전에 모든 작업공간을 검토하세요. 안정적인 ID는 이름보다 먼저 일치됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se gjennom alle arbeidsområder før import. Stabile identiteter matches foran navn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed importem przejrzyj każdy obszar roboczy. Stabilne tożsamości są dopasowywane przed nazwami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise cada área de trabalho antes de importar. Identidades estáveis ​​são correspondidas antes dos nomes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед импортом проверьте каждое рабочее пространство. Стабильные идентификаторы сопоставляются перед именами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบทุกพื้นที่ทำงานก่อนนำเข้า ข้อมูลประจำตัวที่เสถียรจะถูกจับคู่ก่อนชื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarmadan önce her çalışma alanını inceleyin. Sabit kimlikler isimlerden önce eşleştirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед імпортом перевірте кожну робочу область. Стабільні ідентифікації зіставляються перед іменами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在导入之前检查每个工作区。稳定的身份在名称之前匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在匯入之前檢查每個工作區。穩定的身份在名稱之前匹配。"
          }
        }
      }
    },

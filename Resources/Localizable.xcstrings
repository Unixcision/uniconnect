    "uniconnect.localWindow.runtime.stopped.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الخروج shell. أعد فتحه في مجلد الصندوق المحفوظ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "shell je izašao. Ponovo ga otvorite u fascikli sačuvane kutije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "shell forlod. Åbn den igen i den gemte boks-mappe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der shell wurde beendet. Öffnen Sie es erneut im gespeicherten Box-Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shell exited. Reopen it in the saved box folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El shell se cerró. Vuelve a abrirlo en la carpeta guardada de la caja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le shell est sorti. Rouvrez-le dans le dossier de la boîte enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il shell è uscito. Riaprilo nella cartella della casella salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "shell は終了しました。保存したボックスフォルダーで再度開きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "shell ចេញ។ បើកវាឡើងវិញនៅក្នុងថតប្រអប់ដែលបានរក្សាទុក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "shell이(가) 종료되었습니다. 저장된 박스 폴더에서 다시 열어보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "shell gikk ut. Åpne den på nytt i den lagrede boksmappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "shell zakończyło się. Otwórz go ponownie w folderze zapisanej skrzynki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O shell saiu. Abra-o novamente na pasta da caixa salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "shell завершился. Снова откройте его в папке сохраненного ящика."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "shell ออกแล้ว เปิดอีกครั้งในโฟลเดอร์กล่องที่บันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "shell çıktı. Kaydedilen kutu klasöründe yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "shell вийшов. Знову відкрийте його в папці збереженого ящика."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "shell 退出。在保存的 Box 文件夹中重新打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "shell 退出。在儲存的 Box 資料夾中重新開啟它。"
          }
        }
      }
    },
    "uniconnect.localWindow.runtime.stoppedWithHistory.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الخروج shell. محادثاتك المحفوظة لا تزال متاحة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "shell je izašao. Vaši sačuvani razgovori su i dalje dostupni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "shell forlod. Dine gemte samtaler er stadig tilgængelige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der shell wurde beendet. Ihre gespeicherten Konversationen sind weiterhin verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shell exited. Your saved conversations are still available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El shell se cerró. Tus conversaciones guardadas siguen disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le shell est sorti. Vos conversations enregistrées sont toujours disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il shell è uscito. Le tue conversazioni salvate sono ancora disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "shell は終了しました。保存した会話は引き続き利用できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "shell ចេញ។ ការសន្ទនាដែលបានរក្សាទុករបស់អ្នកនៅតែមាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "shell이(가) 종료되었습니다. 저장된 대화는 계속 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "shell gikk ut. De lagrede samtalene dine er fortsatt tilgjengelige."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "shell zakończyło się. Twoje zapisane rozmowy są nadal dostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O shell saiu. Suas conversas salvas ainda estão disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "shell завершился. Ваши сохраненные разговоры по-прежнему доступны."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "shell ออกแล้ว การสนทนาที่บันทึกไว้ของคุณยังคงมีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "shell çıktı. Kaydedilen görüşmeleriniz hâlâ kullanılabilir durumda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "shell вийшов. Ваші збережені розмови все ще доступні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "shell 退出。您保存的对话仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "shell 退出。您儲存的對話仍然可用。"
          }
        }
      }
    },

    "uniconnect.localWindow.runtime.missingRoot.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الموقع الجديد للمجلد لاستئناف هذه النافذة بأمان."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite novu lokaciju fascikle da biste bezbedno nastavili ovaj prozor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg mappens nye placering for at genoptage dette vindue sikkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den neuen Speicherort des Ordners, um dieses Fenster sicher fortzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder's new location to resume this window safely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la nueva ubicación de la carpeta para reanudar esta ventana de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le nouvel emplacement du dossier pour reprendre cette fenêtre en toute sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la nuova posizione della cartella per riprendere questa finestra in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィンドウを安全に再開するには、フォルダーの新しい場所を選択してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរើសទីតាំងថ្មីរបស់ថត ដើម្បីបន្តបង្អួចនេះឡើងវិញដោយសុវត្ថិភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창을 안전하게 다시 시작하려면 폴더의 새 위치를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg mappens nye plassering for å gjenoppta dette vinduet trygt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz nową lokalizację folderu, aby bezpiecznie wznowić to okno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o novo local da pasta para retomar esta janela com segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите новое местоположение папки, чтобы безопасно возобновить работу этого окна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกตำแหน่งใหม่ของโฟลเดอร์เพื่อให้หน้าต่างนี้ทำงานต่ออย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pencereyi güvenli bir şekilde sürdürmek için klasörün yeni konumunu seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть нове розташування папки, щоб безпечно відновити це вікно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件夹的新位置以安全地恢复此窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇資料夾的新位置以安全地恢復此視窗。"
          }
        }
      }
    },

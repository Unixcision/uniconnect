            "state": "translated",
            "value": "진단 파일이 저장되었습니다. Finder에서 공개하려면 클릭하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosefilen er lagret. Klikk for å avsløre den i Finder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik diagnostyczny został zapisany. Kliknij, aby odsłonić go w Finder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo de diagnóstico salvo. Clique para revelá-lo em Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностический файл сохранен. Нажмите, чтобы открыть его в Finder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไฟล์การวินิจฉัยแล้วคลิกเพื่อเปิดเผยใน Finder."
          }

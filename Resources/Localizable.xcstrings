    "uniconnect.ssh.validation.invalidSSHPasswordWrapper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With `sshpass`, the command must invoke `ssh` after the options."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "باستخدام `sshpass`، يجب أن يستدعي الأمر `ssh` بعد الخيارات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa `sshpass`, naredba mora pozvati `ssh` nakon opcija."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med `sshpass` skal kommandoen kalde `ssh` efter indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei `sshpass` muss der Befehl nach den Optionen `ssh` aufrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con `sshpass`, el comando debe invocar `ssh` después de las opciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec `sshpass`, la commande doit invoquer `ssh` après les options."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con `sshpass`, il comando deve richiamare `ssh` dopo le opzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`sshpass` を使用する場合、コマンドはオプションの後に `ssh` を呼び出す必要があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជាមួយ `sshpass` ពាក្យបញ្ជាត្រូវតែហៅ `ssh` បន្ទាប់ពីជម្រើស។"

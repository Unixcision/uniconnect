            "value": "វគ្គ Claude នៅតែត្រូវការការស្តារឡើងវិញ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 세션에는 여전히 복구가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-økter trenger fortsatt gjenoppretting"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje Claude nadal wymagają przywrócenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões Claude ainda precisam de recuperação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеансы Claude по-прежнему требуют восстановления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชัน Claude ยังคงต้องการการกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude oturumlarının hâlâ kurtarılması gerekiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесії Claude все ще потребують відновлення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 会话仍需要恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 會話仍需恢復"
          }
        }
      }
    },
    "claudeUpdate.recovery.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت استعادة %1$lld، ولا يزال %2$lld بحاجة إلى الاهتمام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld restauriran, %2$lld i dalje treba obratiti pažnju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld gendannet, %2$lld har stadig brug for opmærksomhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld wiederhergestellt, %2$lld benötigen weiterhin Aufmerksamkeit."
          }
        },
        "en": {

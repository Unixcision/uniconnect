    "uniconnect.starter.migrate.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy cmux workspaces as local boxes. cmux is left untouched."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ مساحات العمل cmux كمربعات محلية. تم ترك cmux دون تغيير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopirajte cmux radne prostore kao lokalne kutije. cmux je ostavljen netaknut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier cmux-arbejdsområder som lokale bokse. cmux efterlades urørt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren Sie cmux-Arbeitsbereiche als lokale Boxen. cmux bleibt unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie los espacios de trabajo cmux como cuadros locales. cmux no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez les espaces de travail cmux en tant que boîtes locales. cmux reste intact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia le aree di lavoro cmux come caselle locali. cmux rimane intatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux ワークスペースをローカル ボックスとしてコピーします。 cmux はそのまま残されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លងកន្លែងធ្វើការ cmux ជាប្រអប់មូលដ្ឋាន។ cmux ត្រូវបានទុកចោល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 작업공간을 로컬 상자로 복사합니다. cmux는 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier cmux-arbeidsområder som lokale bokser. cmux blir stående urørt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj obszary robocze cmux jako skrzynki lokalne. cmux pozostaje nietknięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie os espaços de trabalho cmux como caixas locais. cmux permanece intocado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте рабочие пространства cmux как локальные ящики. cmux остается нетронутым."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกเวิร์กสเปซ cmux เป็นกล่องโลคัล cmux ไม่ถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux çalışma alanlarını yerel kutular olarak kopyalayın. cmux dokunulmadan bırakılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопіюйте робочі області cmux як локальні ящики. cmux залишається недоторканим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 cmux 工作区复制为本地框。 cmux 保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 cmux 工作區複製為本機框。 cmux 維持不變。"
          }
        }
      }
    },

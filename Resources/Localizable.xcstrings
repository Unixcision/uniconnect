          }
        }
      }
    },
    "settings.notifications.command.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتشغيل أمر shell عند وصول إشعار. تم ضبط $UNICONNECT_NOTIFICATION_TITLE و$UNICONNECT_NOTIFICATION_SUBTITLE و$UNICONNECT_NOTIFICATION_BODY."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrenite naredbu ljuske kada stigne obavijest. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE i $UNICONNECT_NOTIFICATION_BODY su postavljeni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kør en shell-kommando, når der kommer en meddelelse. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE og $UNICONNECT_NOTIFICATION_BODY er indstillet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie einen Shell-Befehl aus, wenn eine Benachrichtigung eintrifft. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE und $UNICONNECT_NOTIFICATION_BODY sind eingestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a shell command when a notification arrives. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE, $UNICONNECT_NOTIFICATION_BODY are set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un comando de shell cuando llega una notificación. Se definen $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE y $UNICONNECT_NOTIFICATION_BODY."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez une commande shell lorsqu'une notification arrive. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE et $UNICONNECT_NOTIFICATION_BODY sont définis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui un comando shell quando arriva una notifica. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE e $UNICONNECT_NOTIFICATION_BODY sono impostati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が届いたときにシェルコマンドを実行します。$UNICONNECT_NOTIFICATION_TITLE、$UNICONNECT_NOTIFICATION_SUBTITLE、$UNICONNECT_NOTIFICATION_BODY が設定されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដំណើរការពាក្យបញ្ជាសែល នៅពេលការជូនដំណឹងមកដល់។ $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE និង $UNICONNECT_NOTIFICATION_BODY ត្រូវបានកំណត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 도착하면 쉘 명령을 실행하십시오. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE, $UNICONNECT_NOTIFICATION_BODY가 설정되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjør en shell-kommando når et varsel kommer. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE og $UNICONNECT_NOTIFICATION_BODY er satt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom polecenie powłoki po otrzymaniu powiadomienia. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE i $UNICONNECT_NOTIFICATION_BODY są ustawione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute um comando shell quando uma notificação chegar. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE e $UNICONNECT_NOTIFICATION_BODY estão definidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите команду оболочки при поступлении уведомления. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE и $UNICONNECT_NOTIFICATION_BODY установлены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รันคำสั่งเชลล์เมื่อมีการแจ้งเตือนมาถึง $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE และ $UNICONNECT_NOTIFICATION_BODY ได้รับการตั้งค่าแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bildirim geldiğinde kabuk komutunu çalıştırın. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE ve $UNICONNECT_NOTIFICATION_BODY ayarlanmıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконайте команду оболонки, коли надходить сповіщення. $UNICONNECT_NOTIFICATION_TITLE, $UNICONNECT_NOTIFICATION_SUBTITLE і $UNICONNECT_NOTIFICATION_BODY встановлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当通知到达时运行 shell 命令。设定$UNICONNECT_NOTIFICATION_TITLE、$UNICONNECT_NOTIFICATION_SUBTITLE、$UNICONNECT_NOTIFICATION_BODY。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當通知到達時執行 shell 命令。設定$UNICONNECT_NOTIFICATION_TITLE、$UNICONNECT_NOTIFICATION_SUBTITLE、$UNICONNECT_NOTIFICATION_BODY。"
          }
        }
      }
    },

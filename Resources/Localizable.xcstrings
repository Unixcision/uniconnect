    "uniconnect.vault.placeholder.emptySSH": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Box Without Windows\n\nCreate the first window from the UniConnect welcome page (UniConnect ▸ New tmux Window…).\n"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH الصندوق بدون ويندوز\n\nأنشئ النافذة الأولى من صفحة الترحيب UniConnect (UniConnect ▸ نافذة tmux جديدة...)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Box Without Windows\n\nKreirajte prvi prozor sa UniConnect stranice dobrodošlice (UniConnect ▸ Novi tmux prozor...)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Boks uden vinduer\n\nOpret det første vindue fra UniConnect velkomstside (UniConnect ▸ Nyt tmux vindue...)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Box ohne Fenster\n\nErstellen Sie das erste Fenster auf der Willkommensseite UniConnect (UniConnect ▸ Neues tmux Fenster…)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "# Caja SSH sin ventanas\n\nCrea la primera ventana desde la página de bienvenida de UniConnect (UniConnect ▸ Nueva ventana tmux…)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Boîte sans fenêtres\n\nCréez la première fenêtre à partir de la page d'accueil UniConnect (UniConnect ▸ Nouvelle fenêtre tmux…)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Scatola senza finestre\n\nCreare la prima finestra dalla pagina di benvenuto UniConnect (UniConnect ▸ Nuova tmux Finestra…)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH ウィンドウなしのボックス\n\nUniConnect ウェルカム ページから最初のウィンドウを作成します (UniConnect ▸ 新しい tmux ウィンドウ…)。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH ប្រអប់ដោយគ្មានវីនដូ\n\nបង្កើតបង្អួចដំបូងពី UniConnect ទំព័រស្វាគមន៍ (UniConnect ▸ ថ្មី tmux Window…)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH 창문이 없는 상자\n\nUniConnect 시작 페이지(UniConnect ▸ 새 tmux 창…)에서 첫 번째 창을 만듭니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Boks uten Windows\n\nOpprett det første vinduet fra UniConnect velkomstside (UniConnect ▸ Nytt tmux vindu...)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Pudełko bez systemu Windows\n\nUtwórz pierwsze okno z UniConnect strony powitalnej (UniConnect ▸ Nowe tmux Okno…)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Caixa Sem Janelas\n\nCrie a primeira janela da página de boas-vindas UniConnect (UniConnect ▸ Nova tmux Janela…)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Коробка без окон\n\nСоздайте первое окно со страницы приветствия UniConnect (UniConnect ▸ Новое tmux Окно…)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH กล่องไม่มี Windows\n\nสร้างหน้าต่างแรกจากหน้าต้อนรับ UniConnect (UniConnect ▸ ใหม่ tmux หน้าต่าง…)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Windows'suz Kutu\n\nUniConnect karşılama sayfasından ilk pencereyi oluşturun (UniConnect ▸ Yeni tmux Pencere…)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH Коробка без вікон\n\nСтворіть перше вікно зі сторінки привітання UniConnect (UniConnect ▸ Нове tmux вікно…)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH 没有窗户的盒子\n\n从 UniConnect 欢迎页面创建第一个窗口（UniConnect ▸ 新建 tmux 窗口...）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "# SSH 沒有窗戶的盒子\n\n從 UniConnect 歡迎頁面建立第一個視窗（UniConnect ▸ 新建 tmux 視窗...）。"
          }
        }
      }
    },
    "uniconnect.backup.saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup could not be saved: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ النسخة الاحتياطية: %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurnosna kopija nije mogla biti sačuvana: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhedskopien kunne ikke gemmes: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup konnte nicht gespeichert werden: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la copia de seguridad: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n'a pas pu être enregistrée : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il backup: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを保存できませんでした: %@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបម្រុងទុកមិនអាចត្រូវបានរក្សាទុកទេ៖ %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 저장할 수 없습니다: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhetskopien kunne ikke lagres: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać kopii zapasowej: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup não pôde ser salvo: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить резервную копию: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกข้อมูลสำรองได้: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme kaydedilemedi: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти резервну копію: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存备份：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存備份：%@"
          }
        }
      }
    },
    "uniconnect.backup.saved.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readable backup saved to:\n%@\n\nSSH connection details are stored in its encrypted companion. The complete app session was also saved."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ النسخة الاحتياطية القابلة للقراءة في:\n%@\n\nتُخزَّن تفاصيل اتصال SSH في الملف المرافق المشفّر. تم أيضًا حفظ جلسة التطبيق الكاملة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čitljiva sigurnosna kopija sačuvana je u:\n%@\n\nSSH podaci za povezivanje čuvaju se u šifrovanom pratećem fajlu. Sačuvana je i kompletna sesija aplikacije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læsbar sikkerhedskopi gemt i:\n%@\n\nSSH-forbindelsesoplysninger gemmes i den krypterede ledsagerfil. Hele appsessionen blev også gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesbare Sicherung gespeichert unter:\n%@\n\nSSH-Verbindungsdaten liegen in der zugehörigen verschlüsselten Datei. Die vollständige App-Sitzung wurde ebenfalls gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia de seguridad legible guardada en:\n%@\n\nLos datos de conexión SSH se guardan en su archivo cifrado asociado. También se guardó la sesión completa de la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde lisible enregistrée dans :\n%@\n\nLes données de connexion SSH sont stockées dans le fichier compagnon chiffré. La session complète de l’application a également été enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup leggibile salvato in:\n%@\n\nI dati di connessione SSH sono memorizzati nel file complementare crittografato. È stata salvata anche la sessione completa dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り可能なバックアップを次の場所に保存しました。\n%@\n\nSSH 接続情報は対応する暗号化ファイルに保存されます。アプリの完全なセッションも保存されました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានរក្សាទុកការបម្រុងទុកដែលអាចអានបានទៅ៖\n%@\n\nព័ត៌មានលម្អិតនៃការតភ្ជាប់ SSH ត្រូវបានរក្សាទុកក្នុងឯកសារដៃគូដែលបានអ៊ិនគ្រីប។ សម័យកម្មវិធីពេញលេញក៏ត្រូវបានរក្សាទុកផងដែរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 있는 백업을 다음 위치에 저장했습니다.\n%@\n\nSSH 연결 정보는 함께 생성된 암호화 파일에 저장됩니다. 전체 앱 세션도 저장했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesbar sikkerhetskopi lagret til:\n%@\n\nSSH-tilkoblingsdetaljer lagres i den krypterte følgefilen. Hele appøkten ble også lagret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czytelną kopię zapasową zapisano w:\n%@\n\nDane połączenia SSH są przechowywane w powiązanym zaszyfrowanym pliku. Zapisano również pełną sesję aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup legível salvo em:\n%@\n\nOs dados de conexão SSH ficam no arquivo complementar criptografado. A sessão completa do aplicativo também foi salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читаемая резервная копия сохранена в:\n%@\n\nДанные SSH-подключения хранятся в связанном зашифрованном файле. Полный сеанс приложения также сохранён."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อมูลสำรองที่อ่านได้ไว้ที่:\n%@\n\nรายละเอียดการเชื่อมต่อ SSH จะอยู่ในไฟล์คู่ที่เข้ารหัส และได้บันทึกเซสชันแอปทั้งหมดแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunabilir yedek şuraya kaydedildi:\n%@\n\nSSH bağlantı bilgileri eşlik eden şifreli dosyada tutulur. Uygulama oturumunun tamamı da kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читабельну резервну копію збережено в:\n%@\n\nДані SSH-з’єднання зберігаються у пов’язаному зашифрованому файлі. Повний сеанс програми також збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可读备份已保存到：\n%@\n\nSSH 连接信息存储在配套的加密文件中。完整的应用会话也已保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可讀備份已儲存到：\n%@\n\nSSH 連線資訊儲存在配套的加密檔案中。完整的應用程式工作階段也已儲存。"
          }
        }
      }
    },

    "settings.textBox.betaWarning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TextBox ميزة تجريبية. قد تتغير القيم الافتراضية والسلوك أثناء الاختبار."

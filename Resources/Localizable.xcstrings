        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 창 작업 디렉터리는 신뢰할 수 있는 상자 폴더 내에 있어야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lokal arbeidskatalog for vinduer må forbli i den pålitelige boksmappen."
          }
        },
        "pl": {

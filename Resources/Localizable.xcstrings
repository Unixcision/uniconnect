        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de cibles hooks : spécifiez au plus une cible agent positionnelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi target hooks: specificare al massimo uno agent posizionale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hooks ターゲットが多すぎます: 位置 agent を 1 つだけ指定してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គោលដៅ hooks ច្រើនពេក៖ បញ្ជាក់ទីតាំង agent ច្រើនបំផុតមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "hooks 대상이 너무 많습니다. 위치 agent를 하나만 지정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange hooks-mål: spesifiser maksimalt én posisjonell agent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele celów hooks: określ maksymalnie jeden pozycyjny agent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos alvos hooks: especifique no máximo um agent posicional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много целей hooks: укажите не более одного позиционного agent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป้าหมาย hooks มากเกินไป: ระบุ agent ตำแหน่งได้มากที่สุดหนึ่งตำแหน่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla hooks hedefi: en fazla bir konumsal agent belirtin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато цілей hooks: укажіть не більше одного позиційного agent."
          }
        },
        "zh-Hans": {

    "uniconnect.import.error.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import was cancelled before it could commit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء الاستيراد قبل أن يتمكن من الالتزام."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvoz je otkazan prije nego što je mogao biti urezan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importen blev annulleret, før den kunne forpligtes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import wurde abgebrochen, bevor er festgeschrieben werden konnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación se canceló antes de que pudiera confirmarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importation a été annulée avant de pouvoir être validée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importazione è stata annullata prima che potesse essere confermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートがコミットされる前にキャンセルされました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការ​នាំចូល​ត្រូវ​បាន​លុប​ចោល​មុន​ពេល​វា​អាច​ធ្វើ​បាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋하기 전에 가져오기가 취소되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importen ble kansellert før den kunne foretas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import został anulowany, zanim mógł zostać zatwierdzony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação foi cancelada antes que pudesse ser confirmada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт был отменен до того, как его удалось зафиксировать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำเข้าถูกยกเลิกก่อนที่จะสามารถดำเนินการได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarma, taahhüt edilemeden iptal edildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпорт скасовано до того, як його вдалося зафіксувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入在提交之前被取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導入在提交之前被取消。"
          }
        }
      }
    },
    "uniconnect.import.error.checkpointFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted recovery checkpoint could not be saved. No import changes were made."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ نقطة تفتيش الاسترداد المشفرة. لم يتم إجراء أي تغييرات على الاستيراد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šifrovana kontrolna tačka za oporavak nije mogla biti sačuvana. Nisu napravljene nikakve promjene u uvozu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det krypterede gendannelseskontrolpunkt kunne ikke gemmes. Der blev ikke foretaget nogen importændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verschlüsselte Wiederherstellungsprüfpunkt konnte nicht gespeichert werden. Es wurden keine Importänderungen vorgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el punto de control de recuperación cifrado. No se realizaron cambios de importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point de contrôle de récupération chiffré n'a pas pu être enregistré. Aucune modification d'importation n'a été effectuée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il checkpoint di ripristino crittografato. Non sono state apportate modifiche all'importazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化された回復チェックポイントを保存できませんでした。インポートの変更は行われませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណុចត្រួតពិនិត្យការសង្គ្រោះដែលបានអ៊ិនគ្រីបមិនអាចរក្សាទុកបានទេ។ គ្មានការផ្លាស់ប្ដូរការនាំចូលត្រូវបានធ្វើឡើងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 복구 체크포인트를 저장할 수 없습니다. 가져오기 변경사항이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det krypterte gjenopprettingssjekkpunktet kunne ikke lagres. Ingen importendringer ble gjort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać zaszyfrowanego punktu kontrolnego odzyskiwania. Nie wprowadzono żadnych zmian w imporcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ponto de verificação de recuperação criptografado não pôde ser salvo. Nenhuma alteração de importação foi feita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить зашифрованную контрольную точку восстановления. Никаких изменений импорта не было."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกจุดตรวจสอบการกู้คืนที่เข้ารหัสได้ ไม่มีการเปลี่ยนแปลงการนำเข้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrelenmiş kurtarma kontrol noktası kaydedilemedi. Hiçbir içe aktarma değişikliği yapılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти зашифровану контрольну точку відновлення. Імпорт змін не внесено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存加密的恢复检查点。没有进行任何导入更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存加密的復原檢查點。沒有進行任何導入變更。"
          }
        }
      }
    },
    "uniconnect.import.error.inProgress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another import or recovery operation is already in progress."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك عملية استيراد أو استرداد أخرى قيد التقدم بالفعل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",

    "bridge.cleanup.error.busyOrUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote integration cannot be removed safely right now. The closed item has been kept so you can retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se puede retirar la integración remota con seguridad. El elemento cerrado se ha conservado para que puedas reintentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、リモート連携を安全に削除できません。再試行できるよう、閉じた項目は保持されています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إزالة التكامل عن بعد بأمان في الوقت الحالي. تم الاحتفاظ بالعنصر المغلق حتى تتمكن من إعادة المحاولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udaljena integracija se trenutno ne može bezbedno ukloniti. Zatvorena stavka je zadržana tako da možete pokušati ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernintegrationen kan ikke fjernes sikkert lige nu. Det lukkede element er blevet opbevaret, så du kan prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Remote-Integration kann derzeit nicht sicher entfernt werden. Das geschlossene Element wurde beibehalten, sodass Sie es erneut versuchen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intégration à distance ne peut pas être supprimée en toute sécurité pour le moment. L'élément clôturé a été conservé afin que vous puissiez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non è possibile rimuovere l'integrazione remota in modo sicuro. L'elemento chiuso è stato mantenuto, quindi puoi riprovare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការរួមបញ្ចូលពីចម្ងាយមិនអាចត្រូវបានយកចេញដោយសុវត្ថិភាពទេឥឡូវនេះ។ ធាតុបិទត្រូវបានរក្សាទុក ដូច្នេះអ្នកអាចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 원격 통합을 안전하게 제거할 수 없습니다. 닫힌 항목은 보관되어 있으므로 다시 시도할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernintegrasjonen kan ikke fjernes trygt akkurat nå. Det lukkede elementet har blitt beholdt slik at du kan prøve på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz bezpiecznie usunąć zdalnej integracji. Zamknięty element został zachowany, więc możesz spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A integração remota não pode ser removida com segurança neste momento. O item fechado foi mantido para que você possa tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаленную интеграцию сейчас невозможно безопасно удалить. Закрытый элемент сохранен, поэтому вы можете повторить попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถลบการรวมระยะไกลได้อย่างปลอดภัยในขณะนี้ รายการที่ปิดถูกเก็บไว้เพื่อให้คุณลองอีกครั้งได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktan entegrasyon şu anda güvenli bir şekilde kaldırılamıyor. Tekrar deneyebilmeniz için kapatılan öğe saklandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віддалену інтеграцію зараз неможливо безпечно видалити. Закритий елемент збережено, тому ви можете повторити спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法安全删除远程集成。已关闭的项目已被保留，以便您可以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法安全刪除遠端整合。已關閉的項目已保留，以便您可以重試。"
          }
        }
      }
    },
    "bridge.cleanup.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect could not verify remote cleanup. Nothing was deleted from Closed Items; check the SSH connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no pudo verificar la retirada remota. No se ha borrado nada de Cerradas; comprueba la conexión SSH y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnectはリモートの削除を確認できませんでした。「閉じた項目」からは何も削除されていません。SSH接続を確認して再試行してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على UniConnect التحقق من التنظيف عن بعد. لم يتم حذف أي شيء من العناصر المغلقة؛ تحقق من اتصال SSH وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nije mogao provjeriti udaljeno čišćenje. Ništa nije obrisano iz zatvorenih stavki; provjerite SSH vezu i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke bekræfte fjernoprydning. Intet blev slettet fra lukkede varer; tjek SSH-forbindelsen og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect konnte die Remote-Bereinigung nicht überprüfen. Aus den geschlossenen Posten wurde nichts gelöscht; Überprüfen Sie die SSH-Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect n'a pas pu vérifier le nettoyage à distance. Rien n'a été supprimé des éléments fermés ; vérifiez la connexion SSH et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non è riuscito a verificare la pulizia remota. Non è stato eliminato nulla dagli Elementi chiusi; controllare la connessione SSH e riprovare."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect មិនអាចផ្ទៀងផ្ទាត់ការសម្អាតពីចម្ងាយបានទេ។ គ្មានអ្វីត្រូវបានលុបចេញពីធាតុដែលបានបិទទេ។ ពិនិត្យការតភ្ជាប់ SSH ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect가 원격 정리를 확인할 수 없습니다. 닫힌 항목에서는 아무것도 삭제되지 않았습니다. SSH 연결을 확인하고 다시 시도하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke bekrefte ekstern opprydding. Ingenting ble slettet fra lukkede elementer; sjekk SSH-tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie mógł zweryfikować zdalnego czyszczenia. Nic nie zostało usunięte z pozycji zamkniętych; sprawdź połączenie SSH i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect não pôde verificar a limpeza remota. Nada foi excluído dos Itens Fechados; verifique a conexão SSH e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не удалось проверить удаленную очистку. Из закрытых элементов ничего не удалено; проверьте соединение SSH и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่สามารถตรวจสอบการล้างข้อมูลจากระยะไกลได้ ไม่มีสิ่งใดถูกลบออกจากรายการที่ปิด ตรวจสอบการเชื่อมต่อ SSH แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect uzaktan temizlemeyi doğrulayamadı. Kapalı Öğeler'den hiçbir şey silinmedi; SSH bağlantısını kontrol edin ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не вдалося перевірити віддалене очищення. Із закритих елементів нічого не видалено; перевірте підключення SSH і повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 无法验证远程清理。已关闭项目中没有删除任何内容；检查 SSH 连接并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 無法驗證遠端清理。已關閉項目中沒有刪除任何內容；檢查 SSH 連線並重試。"
          }
        }
      }
    },

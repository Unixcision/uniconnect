    "settings.app.openMarkdownInCmuxViewer.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-clicking Markdown files opens the rendered UniConnect markdown viewer instead of the generic file preview."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown ファイルを Cmd+クリックすると、汎用ファイルプレビューではなくレンダリング済みの UniConnect マークダウンビューアで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown 파일을 Cmd+클릭하면 일반 파일 미리보기 대신 렌더링된 UniConnect Markdown 뷰어에서 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd+点击 Markdown 文件会在渲染后的 UniConnect Markdown 查看器中打开，而不是通用文件预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd+點擊 Markdown 檔案會在轉譯後的 UniConnect Markdown 檢視器中開啟，而不是通用檔案預覽。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-Klick auf Markdown-Dateien öffnet den gerenderten UniConnect-Markdown-Viewer statt der allgemeinen Dateivorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer Cmd+clic en archivos Markdown abre el visor de Markdown renderizado de UniConnect en lugar de la vista previa genérica de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd+clic sur les fichiers Markdown ouvre la visionneuse Markdown rendue de UniConnect au lieu de l'aperçu générique des fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd+clic sui file Markdown apre il visualizzatore Markdown renderizzato di UniConnect invece dell'anteprima file generica."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي النقر على مفتاح Cmd Markdown إلى فتح عارض تخفيض السعر UniConnect بدلاً من معاينة الملف العامة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikom na Cmd Markdown fajlovi otvaraju se prikazani UniConnect preglednik oznaka umesto generičkog pregleda datoteke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-klikker på Markdown filer åbner den renderede UniConnect markdown viewer i stedet for den generiske fil forhåndsvisning."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-clicking Markdown ឯកសារបើកកម្មវិធីបង្ហាញUniConnect markdown viewer ជំនួសឱ្យការមើលឯកសារទូទៅ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd-klikker Markdown-filer åpner den gjengitte UniConnect markdown-visningen i stedet for den generelle forhåndsvisningen av filen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknięcie plików Markdown przy użyciu polecenia cmd powoduje otwarcie renderowanej przeglądarki przecen UniConnect zamiast ogólnego podglądu plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicar com Cmd nos arquivos Markdown abre o visualizador de markdown UniConnect renderizado em vez da visualização genérica do arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щелчок Cmd по файлам Markdown открывает визуализированную программу просмотра уценок UniConnect вместо общего предварительного просмотра файла."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การคลิก Cmd ไฟล์ Markdown จะเปิดโปรแกรมดูมาร์กดาวน์ UniConnect ที่แสดงผลแทนการแสดงตัวอย่างไฟล์ทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown dosyalarına Cmd tuşuna basarak tıklamak, genel dosya önizlemesi yerine işlenmiş UniConnect işaretleme görüntüleyicisini açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацання файлів Markdown, утримуючи Cmd, відкриває відтворений засіб перегляду розміток UniConnect замість загального попереднього перегляду файлів."
          }
        }
      }
    },

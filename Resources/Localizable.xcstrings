    "claudeUpdate.error.alreadyRunning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك تحديث أو استرداد آخر لـ Claude قيد التشغيل بالفعل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još jedno ažuriranje ili oporavak Claude je već pokrenut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden Claude-opdatering eller gendannelse kører allerede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein weiteres Claude-Update oder eine andere Wiederherstellung läuft bereits."

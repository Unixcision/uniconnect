    "notifications.forwardToPhone.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجيه الإشعارات إلى الـ iPhone الخاص بي"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosljeđuj obavijesti na moj iPhone"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Videresend notifikationer til min iPhone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen an mein iPhone weiterleiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward notifications to my iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenviar notificaciones a mi iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transférer les notifications vers mon iPhone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inoltra le notifiche al mio iPhone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を iPhone に転送する"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជូនបន្តការជូនដំណឹងទៅ iPhone របស់ខ្ញុំ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 iPhone으로 알림 전달"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Videresend varsler til iPhonen min"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazuj powiadomienia na mój iPhone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaminhar notificações para o meu iPhone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересылать уведомления на мой iPhone"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งต่อการแจ้งเตือนไปยัง iPhone ของฉัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimleri iPhone’uma yönlendir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересилати сповіщення на мій iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将通知转发到我的 iPhone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將通知轉寄到我的 iPhone"
          }
        }
      }
    },
    "notifications.forwardToPhone.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال إشعارات الوكلاء إلى تطبيق UniConnect على iPhone. تكون الميزة متوقفة افتراضيًا، ولا يتم رفع أي شيء ما لم تُفعّل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šaljite obavijesti agenata u UniConnect aplikaciju za iPhone. Podrazumijevano je isključeno; ništa se ne prenosi dok ovo ne uključite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send agentnotifikationer til UniConnect-appen på iPhone. Funktionen er slået fra som standard; intet uploades, medmindre den slås til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Agent-Mitteilungen an die UniConnect-App auf dem iPhone. Standardmäßig deaktiviert; nur bei aktivierter Option wird etwas hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send agent notifications to the UniConnect iPhone app. Off by default; nothing is uploaded unless this is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía las notificaciones de agentes a la app UniConnect del iPhone. Está desactivado de forma predeterminada; no se sube nada salvo que lo actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les notifications des agents à l’app UniConnect sur iPhone. Désactivé par défaut ; rien n’est téléversé tant que cette option ne l’est pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia le notifiche degli agenti all’app UniConnect su iPhone. È disattivato per impostazione predefinita; non viene caricato nulla finché non lo attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの通知を UniConnect の iPhone アプリに送信します。デフォルトはオフで、オンにしない限り何もアップロードされません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ញើការជូនដំណឹងរបស់ agent ទៅកម្មវិធី UniConnect លើ iPhone។ វាត្រូវបានបិទតាមលំនាំដើម ហើយគ្មានអ្វីត្រូវបានផ្ទុកឡើងទេ លុះត្រាតែអ្នកបើកវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 알림을 iPhone의 UniConnect 앱으로 보냅니다. 기본적으로 꺼져 있으며, 이 옵션을 켜지 않으면 아무것도 업로드되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send agentvarsler til UniConnect-appen på iPhone. Dette er av som standard; ingenting lastes opp før du slår det på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłaj powiadomienia agentów do aplikacji UniConnect na iPhonie. Domyślnie wyłączone; nic nie jest przesyłane, dopóki nie włączysz tej opcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie notificações de agentes para o app UniConnect no iPhone. Desativado por padrão; nada é enviado enquanto esta opção não estiver ativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет уведомления агентов в приложение UniConnect на iPhone. По умолчанию выключено; пока параметр не включен, ничего не загружается."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งการแจ้งเตือนจากเอเจนต์ไปยังแอป UniConnect บน iPhone โดยค่าเริ่มต้นจะปิดอยู่ และจะไม่มีการอัปโหลดข้อมูลจนกว่าคุณจะเปิดใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan bildirimlerini iPhone’daki UniConnect uygulamasına gönderir. Varsayılan olarak kapalıdır; siz açmadıkça hiçbir şey yüklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає сповіщення агентів у застосунок UniConnect на iPhone. Типово вимкнено; доки ви не ввімкнете цю опцію, нічого не завантажується."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将智能体通知发送到 iPhone 上的 UniConnect App。默认关闭；只有开启此选项后才会上传内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將代理程式通知傳送到 iPhone 上的 UniConnect App。預設為關閉；只有開啟此選項後才會上傳內容。"
          }
        }
      }
    },
    "notifications.forwardToPhone.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone notification forwarding stays off until UniConnect's own service is configured."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل توجيه الإشعارات إلى الهاتف متوقفًا حتى يتم تكوين خدمة UniConnect الخاصة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosljeđivanje obavijesti na telefon ostaje isključeno dok se ne konfiguriše vlastita usluga UniConnecta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Videresendelse af notifikationer til telefonen forbliver slået fra, indtil UniConnects egen tjeneste er konfigureret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weiterleitung von Benachrichtigungen an das Telefon bleibt deaktiviert, bis der eigene Dienst von UniConnect konfiguriert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reenvío de notificaciones al teléfono permanece desactivado hasta que se configure el servicio propio de UniConnect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert des notifications vers le téléphone reste désactivé jusqu’à ce que le service propre à UniConnect soit configuré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inoltro delle notifiche al telefono rimane disattivato finché non viene configurato il servizio di UniConnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 独自のサービスが設定されるまで、スマートフォンへの通知転送はオフのままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបញ្ជូនបន្តការជូនដំណឹងទៅទូរស័ព្ទនឹងបិទរហូតដល់សេវាកម្មផ្ទាល់ខ្លួនរបស់ UniConnect ត្រូវបានកំណត់រចនាសម្ព័ន្ធ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 자체 서비스가 구성될 때까지 휴대전화로 알림 전달은 꺼진 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Videresending av varsler til telefonen forblir av til UniConnects egen tjeneste er konfigurert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazywanie powiadomień na telefon pozostaje wyłączone do czasu skonfigurowania własnej usługi UniConnect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O encaminhamento de notificações para o telefone permanece desativado até que o serviço próprio do UniConnect seja configurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переадресация уведомлений на телефон остается отключенной, пока не будет настроена собственная служба UniConnect."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งต่อการแจ้งเตือนไปยังโทรศัพท์จะปิดอยู่จนกว่าจะกำหนดค่าบริการของ UniConnect เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefona bildirim yönlendirme, UniConnect'in kendi hizmeti yapılandırılana kadar kapalı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересилання сповіщень на телефон залишатиметься вимкненим, доки не буде налаштовано власну службу UniConnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在配置 UniConnect 自己的服务之前，向手机转发通知将保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定 UniConnect 自己的服務之前，將通知轉寄至手機的功能會維持關閉。"
          }
        }
      }
    },
    "notifications.forwardToPhone.hideContent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء المحتوى (إرسال رسالة عامة بدلاً من نص الوحدة الطرفية)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakrij sadržaj (pošalji opću poruku umjesto teksta terminala)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul indhold (send en generisk besked i stedet for terminalteksten)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalt ausblenden (allgemeine Nachricht statt Terminaltext senden)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide content (send a generic message instead of the terminal text)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar contenido (enviar un mensaje genérico en lugar del texto del terminal)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer le contenu (envoyer un message générique à la place du texte du terminal)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi contenuto (invia un messaggio generico invece del testo del terminale)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を非表示にする（ターミナルのテキストの代わりに一般的なメッセージを送信）"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លាក់ខ្លឹមសារ (ផ្ញើសារទូទៅជំនួសអត្ថបទក្នុង terminal)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠 가리기(터미널 텍스트 대신 일반 메시지 전송)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul innhold (send en generell melding i stedet for terminalteksten)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj treść (wyślij ogólny komunikat zamiast tekstu terminala)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar conteúdo (enviar uma mensagem genérica em vez do texto do terminal)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать содержимое (отправлять общее сообщение вместо текста терминала)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนเนื้อหา (ส่งข้อความทั่วไปแทนข้อความจากเทอร์มินัล)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriği gizle (terminal metni yerine genel bir ileti gönder)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховувати вміст (надсилати загальне повідомлення замість тексту термінала)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏内容（发送通用消息，而不是终端文本）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏內容（傳送一般訊息，而不是終端機文字）"
          }
        }
      }
    },
    "notifications.open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح"
          }
        },
        "bs": {
          "stringUnit": {

            "state": "translated",
            "value": "¿Eliminar definitivamente este elemento cerrado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement cet élément fermé ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare definitivamente questo elemento chiuso?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この閉じた項目を完全に削除しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លុប​ធាតុ​បិទ​នេះ​ជា​អចិន្ត្រៃយ៍?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 닫힌 항목을 영구적으로 삭제하시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du slette dette lukkede elementet permanent?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usunąć ten zamknięty przedmiot?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir este item fechado permanentemente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот закрытый элемент навсегда?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบรายการที่ปิดนี้อย่างถาวรหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Kapalı Öğe Kalıcı Olarak Silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цей закритий елемент назавжди?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除此已关闭项目吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除此已關閉項目嗎？"
          }
        }
      }
    },
    "menu.file.recentlyClosed.delete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ولن يكون متاحًا لإعادة فتحه بعد الآن. جلسات tmux عن بعد لا تتأثر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Više neće biti dostupno za ponovno otvaranje. To ne utiče na udaljene tmux sesije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det vil ikke længere være tilgængeligt at genåbne. Fjernsessioner tmux påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Wiedereröffnung ist nicht mehr möglich. Remote-tmux-Sitzungen sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will no longer be available to reopen. Remote tmux sessions are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no se podrá volver a abrir. Las sesiones tmux remotas no se verán afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne sera plus possible de rouvrir. Les sessions tmux à distance ne sont pas affectées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sarà più disponibile per la riapertura. Le sessioni remote tmux non sono interessate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は再度開けなくなります。リモートtmuxセッションには影響しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វា​នឹង​លែង​មាន​សម្រាប់​បើក​ឡើង​វិញ​ហើយ។ វគ្គ tmux ពីចម្ងាយមិនត្រូវបានប៉ះពាល់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 다시 열 수 없습니다. 원격 tmux 세션은 영향을 받지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det vil ikke lenger være tilgjengelig for gjenåpning. Eksterne tmux økter påvirkes ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie będzie już możliwości ponownego otwarcia. Nie ma to wpływu na zdalne sesje tmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não estará mais disponível para reabertura. Sessões tmux remotas não são afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его больше нельзя будет открыть повторно. Удаленные сеансы tmux не затрагиваются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะไม่สามารถเปิดใหม่ได้อีกต่อไป เซสชันระยะไกล tmux จะไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık yeniden açılmayacak. Uzak tmux oturumları etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його більше не можна буде повторно відкрити. Віддалені сеанси tmux не впливають."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将不再可以重新打开。远程 tmux 会话不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它將不再可以重新打開。遠端 tmux 會話不受影響。"
          }
        }
      }
    },

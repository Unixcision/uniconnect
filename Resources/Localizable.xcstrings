            "state": "translated",
            "value": "Blink kort en blå kontur, når UniConnect fremhæver en rude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein blauer Umriss lässt kurz aufblinken, wenn UniConnect einen Bereich hervorhebt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",

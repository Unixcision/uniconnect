    "sidebar.help.feedback.successBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for helping improve UniConnect."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لك على المساعدة في تحسين UniConnect."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvala vam što pomažete u poboljšanju UniConnect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak, fordi du hjælper med at forbedre UniConnect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielen Dank für Ihre Hilfe bei der Verbesserung von UniConnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por ayudar a mejorar UniConnect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci d'avoir contribué à l'amélioration de UniConnect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per aver contribuito a migliorare UniConnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect の改善にご協力いただきありがとうございます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សូមអរគុណចំពោះការជួយកែលម្អ UniConnect។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 개선에 도움을 주셔서 감사합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for at du hjelper til med å forbedre UniConnect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy za pomoc w ulepszeniu UniConnect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por ajudar a melhorar UniConnect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Благодарим вас за помощь в улучшении UniConnect."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณที่ช่วยปรับปรุง UniConnect"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect'nin iyileştirilmesine yardımcı olduğunuz için teşekkür ederiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо за допомогу в покращенні UniConnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢您帮助改进UniConnect。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感謝您協助改進UniConnect。"
          }
        }
      }
    },
    "sidebar.help.feedback.successTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

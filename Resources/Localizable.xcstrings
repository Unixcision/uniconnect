    "sidebar.help.feedback.totalImagesTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These images are too large to send together. Remove a few and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの画像はまとめて送信するには大きすぎます。いくつか削除してもう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці зображення занадто великі для надсилання разом. Видаліть кілька та спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 너무 커서 함께 보낼 수 없습니다. 몇 개를 제거하고 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصور كبيرة جدًا بحيث لا يمكن إرسالها معًا.قم بإزالة القليل وحاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove slike su prevelike za slanje zajedno. Uklonite nekoliko i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse billeder er for store til at sendes sammen. Fjern nogle få og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bilder sind zu groß, um sie zusammen zu versenden. Entfernen Sie ein paar und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas imágenes son demasiado grandes para enviarlas juntas. Elimina algunos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces images sont trop volumineuses pour être envoyées ensemble. Supprimez-en quelques-uns et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste immagini sono troppo grandi per essere inviate insieme. Rimuovine alcuni e riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រូបភាពទាំងនេះមានទំហំធំពេកមិនអាចផ្ញើជាមួយគ្នាបាន។ដកពីរបីចេញ ហើយព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse bildene er for store til å sendes sammen. Fjern noen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te obrazy są zbyt duże, aby wysłać je razem. Usuń kilka i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas imagens são muito grandes para serem enviadas juntas. Remova alguns e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти изображения слишком велики, чтобы их можно было отправить вместе. Удалите несколько и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพเหล่านี้ใหญ่เกินกว่าจะส่งร่วมกันได้ลบบางส่วนออกแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu resimler birlikte gönderilemeyecek kadar büyük. Birkaçını kaldırın ve tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些图像太大，无法一起发送。删除一些并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些圖像太大，無法一起發送。刪除一些並重試。"
          }
        }
      }
    },
    "sidebar.help.feedback.validationError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your message and attachments, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージと添付ファイルを確認して、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте повідомлення та вкладення, потім спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지와 첨부 파일을 확인한 후 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من رسالتك ومرفقاتك، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite svoju poruku i priloge, a zatim pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek din besked og dine vedhæftede filer, og prøv derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Ihre Nachricht und Anhänge und versuchen Sie es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise su mensaje y sus archivos adjuntos y vuelva a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre message et vos pièces jointes, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il messaggio e gli allegati, quindi riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពិនិត្យសារ និងឯកសារភ្ជាប់របស់អ្នក បន្ទាប់មកព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk meldingen og vedleggene, og prøv på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź wiadomość i załączniki, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua mensagem e seus anexos e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте свое сообщение и вложения, а затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบข้อความและไฟล์แนบของคุณ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajınızı ve eklerini kontrol edip tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查您的消息和附件，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查您的訊息和附件，然後再試一次。"
          }
        }
      }
    },

          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni invariata la finestra esistente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のウィンドウを変更しないでください"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រក្សាបង្អួចដែលមានស្រាប់មិនផ្លាស់ប្តូរ"

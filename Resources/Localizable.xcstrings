    "uniconnect.localWindow.error.conversationAlreadyRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That conversation is already running in another local window. Exit it there before resuming it here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المحادثة قيد التشغيل بالفعل في نافذة محلية أخرى. اخرج منه هناك قبل استئنافه هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Taj razgovor se već vodi u drugom lokalnom prozoru. Izađite ga tamo prije nego što ga nastavite ovdje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den samtale kører allerede i et andet lokalt vindue. Afslut det der, før du genoptager det her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Konversation läuft bereits in einem anderen lokalen Fenster. Beenden Sie es dort, bevor Sie es hier fortsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa conversación ya se está ejecutando en otra ventana local. Salga allí antes de reanudarlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation est déjà en cours dans une autre fenêtre locale. Quittez-le là avant de le reprendre ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella conversazione è già in esecuzione in un'altra finestra locale. Esci da lì prima di riprenderlo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その会話はすでに別のローカル ウィンドウで実行されています。ここで再開する前に、そこで終了してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការ​សន្ទនា​នោះ​កំពុង​ដំណើរការ​រួច​ហើយ​នៅ​ក្នុង​បង្អួច​មូលដ្ឋាន​ផ្សេង​ទៀត។ ចាកចេញពីវានៅទីនោះ មុនពេលបន្តវានៅទីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 대화는 이미 다른 로컬 창에서 실행 중입니다. 여기에서 다시 시작하기 전에 거기서 종료하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den samtalen kjører allerede i et annet lokalt vindu. Avslutt det der før du fortsetter det her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta konwersacja jest już uruchomiona w innym oknie lokalnym. Opuść go tam, zanim wznowisz go tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa conversa já está sendo executada em outra janela local. Saia lá antes de retomá-lo aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот разговор уже ведется в другом локальном окне. Выйдите из него, прежде чем возобновить его здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนทนานั้นทำงานในหน้าต่างท้องถิ่นอื่นอยู่แล้ว ออกจากที่นั่นก่อนกลับมาดำเนินการต่อที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konuşma zaten başka bir yerel pencerede çalışıyor. Burada devam etmeden önce oradan çıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця розмова вже запущена в іншому локальному вікні. Вийдіть із нього, перш ніж відновити тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该对话已在另一个本地窗口中运行。在此处恢复之前先从那里退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該對話已在另一個本機視窗中運行。在此處恢復之前先從那裡退出。"
          }
        }
      }
    },

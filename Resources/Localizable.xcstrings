      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم تسلسل العمليات الأبوي من عمليات الخطافات. عطّله إذا كان يجب أن تطلق جلسات Codex أو Claude المتداخلة إشعارات الإكمال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi hijerarhiju procesa iz hook procesa. Isključite ako ugniježđene Codex ili Claude sesije trebaju slati obavještenja o završetku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger proceshierarki fra hook-processer. Slå fra, hvis indlejrede Codex- eller Claude-sessioner skal udløse fuldførelsesnotifikationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die Prozessabstammung der Hook-Prozesse. Deaktivieren, wenn verschachtelte Codex- oder Claude-Sitzungen Abschlussbenachrichtigungen auslösen sollen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses process ancestry from hook processes. Disable if nested Codex or Claude sessions should trigger completion notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la ascendencia de procesos de los hooks. Desactívalo si las sesiones anidadas de Codex o Claude deben generar notificaciones de finalización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise l’ascendance des processus de hooks. Désactivez cette option si les sessions Codex ou Claude imbriquées doivent déclencher des notifications de fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la gerarchia dei processi dei hook. Disattiva se le sessioni Codex o Claude annidate devono inviare notifiche di completamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックプロセスの親子関係を使用します。ネストされた Codex または Claude セッションでも完了通知を出したい場合は無効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훅 프로세스의 상위 프로세스 관계를 사용합니다. 중첩된 Codex 또는 Claude 세션도 완료 알림을 보내야 한다면 비활성화하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker prosesshierarki fra hook-prosesser. Slå av hvis innebygde Codex- eller Claude-økter skal utløse fullføringsvarsler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa hierarchii procesów hooków. Wyłącz, jeśli zagnieżdżone sesje Codex lub Claude mają wywoływać powiadomienia o zakończeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a hierarquia de processos dos hooks. Desative se sessões aninhadas do Codex ou Claude devem disparar notificações de conclusão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует иерархию процессов из hook-процессов. Отключите, если вложенные сеансы Codex или Claude должны отправлять уведомления о завершении."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ลำดับชั้นของโปรเซสจากโปรเซส hook ปิดตัวเลือกนี้หากเซสชัน Codex หรือ Claude แบบซ้อนควรส่งการแจ้งเตือนเมื่อเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook süreçlerinin üst işlem zincirini kullanır. İç içe Codex veya Claude oturumları tamamlanma bildirimi göndermeliyse kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує ієрархію процесів із hook-процесів. Вимкніть, якщо вкладені сеанси Codex або Claude мають надсилати сповіщення про завершення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 hook 进程的进程层级。若嵌套的 Codex 或 Claude 会话应触发完成通知，请将其关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 hook 程序的程序層級。若巢狀 Codex 或 Claude 工作階段應觸發完成通知，請將其關閉。"
          }
        }
      }
    },
    "settings.automation.suppressSubagentNotifications.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسل إكمالات الوكلاء الفرعيين إشعارات مثل الوكلاء الأعلى مستوى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Završeci dječijih agenata šalju obavještenja kao agenti najvišeg nivoa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Underagenters fuldførelser giver besked som topniveau-agenter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abschlüsse von Unteragenten benachrichtigen wie Top-Level-Agenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child agent completions notify like top-level agents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las finalizaciones de agentes secundarios notifican como agentes de nivel superior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fins d’agents enfants notifient comme les agents de premier niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I completamenti degli agenti figli inviano notifiche come gli agenti di primo livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "子エージェントの完了もトップレベルのエージェントと同様に通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 에이전트 완료도 최상위 에이전트처럼 알립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fullføringer fra underagenter varsler som toppnivåagenter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończenia agentów podrzędnych powiadamiają jak agenci najwyższego poziomu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclusões de agentes filhos notificam como agentes de nível superior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершения дочерних агентов уведомляют как агенты верхнего уровня."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำงานเสร็จของเอเจนต์ลูกจะแจ้งเตือนเหมือนเอเจนต์ระดับบนสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt ajan tamamlanmaları üst düzey ajanlar gibi bildirim gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершення дочірніх агентів сповіщають як агенти верхнього рівня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子代理完成时会像顶层代理一样通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "子代理完成時會像頂層代理一樣通知。"
          }
        }
      }
    },
    "settings.automation.suppressSubagentNotifications.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى إكمالات الوكلاء الفرعيين في Feed بدون إشعارات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Završeci dječijih agenata ostaju u Feed-u bez obavještenja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Underagenters fuldførelser bliver i Feed uden notifikationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abschlüsse von Unteragenten bleiben ohne Benachrichtigungen im Feed."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child agent completions stay in Feed without notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las finalizaciones de agentes secundarios permanecen en Feed sin notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fins d’agents enfants restent dans Feed sans notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I completamenti degli agenti figli restano in Feed senza notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "子エージェントの完了は通知せずFeedにのみ残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 에이전트 완료는 알림 없이 Feed에만 남습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fullføringer fra underagenter blir i Feed uten varsler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończenia agentów podrzędnych pozostają w Feed bez powiadomień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclusões de agentes filhos ficam no Feed sem notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершения дочерних агентов остаются в Feed без уведомлений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทำงานเสร็จของเอเจนต์ลูกจะอยู่ใน Feed โดยไม่มีการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt ajan tamamlanmaları bildirim olmadan Feed’de kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершення дочірніх агентів залишаються у Feed без сповіщень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子代理完成事件会留在 Feed 中且不通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "子代理完成事件會留在 Feed 中且不通知。"
          }
        }
      }
    },
    "settings.automation.cursor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cursor Integration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cursor連携"
          }

          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ogranicza wysokość rozbudowanego wejścia terminala przed przewijaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Limita a altura que a entrada rica do terminal pode atingir antes de rolar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ограничивает высоту расширенного ввода терминала до начала прокрутки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จำกัดความสูงของอินพุตเทอร์มินัลแบบ rich ก่อนที่จะเริ่มเลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zengin terminal girişinin kaymadan önce ne kadar büyüyebileceğini sınırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",

    "uniconnect.recovery.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُفتح الصناديق والنوافذ المستردة بجانب عملك الحالي. ستُدمج بيانات اعتماد SSH المفقودة من النسخة الاحتياطية المشفرة المرافقة عند توفرها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraćeni boxovi i prozori otvorit će se uz vaš trenutni rad. Nedostajući SSH podaci bit će spojeni iz prateće šifrirane kopije kada je dostupna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendannede bokse og vinduer åbnes ved siden af dit nuværende arbejde. Manglende SSH-legitimationsoplysninger flettes fra den krypterede ledsagerkopi, når den findes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhergestellte Boxen und Fenster werden zusätzlich zu Ihrer aktuellen Arbeit geöffnet. Fehlende SSH-Zugangsdaten werden, sofern vorhanden, aus der verschlüsselten Begleitkopie ergänzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovered boxes and windows will open alongside your current work. Missing SSH credentials will be merged from the encrypted companion backup when available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cajas y ventanas recuperadas se abrirán junto a tu trabajo actual. Las credenciales SSH que falten se fusionarán desde la copia cifrada asociada cuando esté disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les box et fenêtres récupérées s’ouvriront à côté de votre travail actuel. Les identifiants SSH manquants seront fusionnés depuis la copie chiffrée associée si elle est disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I box e le finestre recuperati si apriranno accanto al lavoro corrente. Le credenziali SSH mancanti verranno unite dalla copia cifrata associata, se disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元したボックスとウインドウは現在の作業と並んで開きます。不足しているSSH認証情報は、利用可能な場合に暗号化された付属バックアップから統合されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រអប់ និងបង្អួចដែលបានស្ដារនឹងបើកជាមួយការងារបច្ចុប្បន្នរបស់អ្នក។ ព័ត៌មានសម្ងាត់ SSH ដែលបាត់នឹងត្រូវបញ្ចូលពីច្បាប់ចម្លងដែលបានអ៊ិនគ្រីប ប្រសិនបើមាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구된 박스와 윈도우가 현재 작업과 함께 열립니다. 누락된 SSH 자격 증명은 가능한 경우 암호화된 동반 백업에서 병합됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprettede bokser og vinduer åpnes ved siden av arbeidet ditt. Manglende SSH-legitimasjon slås sammen fra den krypterte tilhørende kopien når den finnes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odzyskane boksy i okna zostaną otwarte obok bieżącej pracy. Brakujące dane SSH zostaną scalone z powiązanej zaszyfrowanej kopii, jeśli jest dostępna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os boxes e as janelas recuperados serão abertos junto ao trabalho atual. As credenciais SSH ausentes serão mescladas da cópia criptografada associada, quando disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановленные боксы и окна откроются рядом с текущей работой. Недостающие данные SSH будут добавлены из связанной зашифрованной копии, если она доступна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล่องและหน้าต่างที่กู้คืนจะเปิดควบคู่กับงานปัจจุบัน ข้อมูลรับรอง SSH ที่ขาดหายจะถูกรวมจากข้อมูลสำรองที่เข้ารหัสหากมี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarılan kutular ve pencereler mevcut çalışmanızın yanında açılır. Eksik SSH kimlik bilgileri, varsa ilişkili şifreli yedekten birleştirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлені бокси й вікна відкриються поруч із поточною роботою. Відсутні дані SSH буде додано з пов’язаної зашифрованої копії, якщо вона доступна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复的 Box 和窗口会与当前工作一起打开。若有加密的配套备份，将从中合并缺失的 SSH 凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原的 Box 和視窗會與目前工作一起開啟。若有加密的配套備份，將從中合併缺少的 SSH 憑證。"
          }
        }
      }
    },
    "uniconnect.recovery.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد استعادة هذه النسخة الاحتياطية؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vratiti ovu sigurnosnu kopiju?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendan denne sikkerhedskopi?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup wiederherstellen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore this backup?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar esta copia de seguridad?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurer cette sauvegarde ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinare questo backup?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップを復元しますか？"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ស្ដារច្បាប់ចម្លងនេះឬ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업을 복원할까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprette denne sikkerhetskopien?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócić tę kopię zapasową?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar este backup?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить эту резервную копию?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนข้อมูลสำรองนี้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek geri yüklensin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити цю резервну копію?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复此备份？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原此備份？"
          }
        }
      }
    },
    "uniconnect.recovery.failed.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم استبدال أي شيء. %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa nije zamijenjeno. %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet blev erstattet. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wurde ersetzt. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was replaced. %@"
          }

    "claudeUpdate.error.preflight": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على UniConnect إعداد تحديث آمن لـ Claude. لم يتم إرسال أي إدخال طرفي."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nije mogao pripremiti sigurno ažuriranje Claude. Nije poslan nikakav terminalni ulaz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke forberede en sikker Claude-opdatering. Ingen terminalindgang blev sendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect konnte kein sicheres Claude-Update vorbereiten. Es wurde keine Terminaleingabe gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect could not prepare a safe Claude update. No terminal input was sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no pudo preparar una actualización segura de Claude. No se envió ninguna entrada de terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect n'a pas pu préparer une mise à jour sécurisée de Claude. Aucune entrée de terminal n'a été envoyée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non è riuscito a preparare un aggiornamento Claude sicuro. Non è stato inviato alcun input dal terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect は安全な Claude アップデートを準備できませんでした。端末入力は送信されませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect មិនអាចរៀបចំការធ្វើបច្ចុប្បន្នភាព Claude ប្រកបដោយសុវត្ថិភាពបានទេ។ គ្មានការបញ្ចូលស្ថានីយត្រូវបានផ្ញើទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect가 안전한 Claude 업데이트를 준비할 수 없습니다. 터미널 입력이 전송되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke forberede en sikker Claude-oppdatering. Ingen terminalinngang ble sendt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie mógł przygotować bezpiecznej aktualizacji Claude. Żadne dane wejściowe terminala nie zostały wysłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect não pôde preparar uma atualização segura do Claude. Nenhuma entrada de terminal foi enviada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не удалось подготовить безопасное обновление Claude. Никакой входной сигнал терминала не был отправлен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่สามารถเตรียมการอัปเดต Claude ที่ปลอดภัยได้ ไม่มีการส่งอินพุตเทอร์มินัล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect güvenli bir Claude güncellemesi hazırlayamadı. Hiçbir terminal girişi gönderilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",

    "uniconnect.ssh.edit.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the complete connection command. UniConnect encrypts it on this Mac and verifies every open tmux window before switching."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل أمر الاتصال الكامل.يقوم UniConnect بتشفيره على جهاز Mac هذا والتحقق من كل نافذة tmux مفتوحة قبل التبديل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite kompletnu naredbu za povezivanje. UniConnect ga šifrira na ovom Macu i provjerava svaki otvoreni prozor tmux prije prebacivanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast den komplette forbindelseskommando. UniConnect krypterer det på denne Mac og verificerer hvert åbent tmux vindue, før der skiftes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie den vollständigen Verbindungsbefehl ein. UniConnect verschlüsselt es auf diesem Mac und überprüft jedes geöffnete tmux Fenster vor dem Wechsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el comando de conexión completo. UniConnect lo cifra en este Mac y verifica todas las ventanas tmux abiertas antes de cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez la commande de connexion complète. UniConnect le crypte sur ce Mac et vérifie chaque fenêtre tmux ouverte avant de changer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immettere il comando di connessione completa. UniConnect lo crittografa su questo Mac e verifica ogni finestra tmux aperta prima di cambiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な接続コマンドを入力します。UniConnect はこの Mac 上で暗号化し、切り替える前に開いているすべての tmux ウィンドウを確認します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចូលពាក្យបញ្ជាការតភ្ជាប់ពេញលេញ។UniConnect អ៊ិនគ្រីបវានៅលើ Mac នេះ ហើយផ្ទៀងផ្ទាត់រាល់បង្អួចដែលបើក tmux មុនពេលប្តូរ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전한 연결 명령을 입력하십시오. UniConnect은(는) 이 Mac에서 이를 암호화하고 전환하기 전에 열려 있는 모든 tmux 창을 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn hele tilkoblingskommandoen. UniConnect krypterer det på denne Mac-en og verifiserer hvert åpne tmux-vindu før du bytter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź pełne polecenie połączenia. UniConnect szyfruje go na tym komputerze Mac i weryfikuje każde otwarte tmux okno przed przełączeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o comando de conexão completo. UniConnect criptografa-o neste Mac e verifica todas as janelas tmux abertas antes de alternar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите полную команду подключения. UniConnect шифрует его на этом Mac и проверяет каждое открытое tmux окно перед переключением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนคำสั่งการเชื่อมต่อที่สมบูรณ์UniConnect เข้ารหัสบน Mac เครื่องนี้และตรวจสอบทุกหน้าต่าง tmux ที่เปิดอยู่ก่อนที่จะเปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam bağlantı komutunu girin. UniConnect bu Mac'te onu şifreler ve geçiş yapmadan önce tüm açık tmux pencereleri doğrular."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть повну команду підключення. UniConnect шифрує його на цьому Mac і перевіряє кожне відкрите tmux вікно перед перемиканням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入完整的连接命令。UniConnect 在此 Mac 上对其进行加密，并在切换之前验证每个打开的 tmux 窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入完整的連線命令。UniConnect 在此 Mac 上進行加密，並在切換之前驗證每個開啟的 tmux 視窗。"
          }
        }
      }
    },
    "uniconnect.ssh.edit.error.commit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect could not switch every open window, so it restored the previous connection."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect لم يتمكن من تبديل كل نافذة مفتوحة، لذلك قام باستعادة الاتصال السابق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nije mogao prebaciti svaki otvoreni prozor, pa je vratio prethodnu vezu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke skifte alle åbne vinduer, så det genoprettede den tidligere forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect konnte nicht jedes geöffnete Fenster wechseln, daher wurde die vorherige Verbindung wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no pudo cambiar todas las ventanas abiertas, por lo que restauró la conexión anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect n'a pas pu changer chaque fenêtre ouverte, il a donc restauré la connexion précédente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non è riuscito a cambiare ogni finestra aperta, quindi ha ripristinato la connessione precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect は、開いているウィンドウをすべて切り替えることができなかったため、以前の接続を復元しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect មិនអាចប្តូររាល់បង្អួចដែលបើកបានទេ ដូច្នេះវាបានស្ដារការភ្ជាប់ពីមុន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 열려 있는 모든 창을 전환할 수 없어 이전 연결을 복원했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke bytte alle åpne vinduer, så den gjenopprettet den forrige tilkoblingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie mógł przełączyć każdego otwartego okna, więc przywrócił poprzednie połączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect não conseguiu alternar todas as janelas abertas, por isso restaurou a conexão anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не удалось переключить каждое открытое окно, поэтому восстанавливалось предыдущее соединение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่สามารถสลับทุกหน้าต่างที่เปิดอยู่ได้ ดังนั้นจึงคืนค่าการเชื่อมต่อก่อนหน้านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect her açık pencereyi değiştiremedi, bu nedenle önceki bağlantıyı geri yükledi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не вдалося перемикати кожне відкрите вікно, тому було відновлено попереднє з’єднання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 无法切换每个打开的窗口，因此恢复了之前的连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 無法切換每個開啟的窗口，因此恢復了先前的連線。"
          }
        }
      }
    },
    "uniconnect.ssh.edit.error.duplicate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another UniConnect window already owns one of those SSH/tmux targets. Nothing was changed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك نافذة أخرى UniConnect تمتلك بالفعل أحد هذه الأهداف SSH/tmux.لم يتغير شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugi UniConnect prozor već posjeduje jedan od onih SSH/tmux ciljeva. Ništa nije promijenjeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et andet UniConnect vindue ejer allerede et af disse SSH/tmux mål. Intet blev ændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes UniConnect-Fenster besitzt bereits eines dieser SSH/tmux-Ziele. Es wurde nichts geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra ventana de UniConnect ya usa uno de esos destinos SSH/tmux. No se ha cambiado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre fenêtre UniConnect possède déjà une de ces cibles SSH/tmux. Rien n'a été changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra finestra UniConnect possiede già uno di questi target SSH/tmux. Niente è stato cambiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の UniConnect ウィンドウは、すでに SSH/tmux ターゲットの 1 つを所有しています。何も変わりませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្អួច UniConnect មួយ​ទៀត​ហើយ​ជា​ម្ចាស់​គោល​ដៅ SSH/tmux។គ្មានអ្វីត្រូវបានផ្លាស់ប្តូរទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또 다른 UniConnect 창은 이미 해당 SSH/tmux 대상 중 하나를 소유하고 있습니다.아무것도 변경되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et annet UniConnect-vindu eier allerede et av disse SSH/tmux-målene. Ingenting ble endret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne UniConnect okno posiada już jeden z tych SSH/tmux obiektów docelowych. Nic nie zostało zmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra janela UniConnect já possui um desses alvos SSH/tmux. Nada foi alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое окно UniConnect уже владеет одной из этих целей SSH/tmux. Ничего не изменилось."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่าง UniConnect อีกอันหนึ่งเป็นเจ้าของหนึ่งในเป้าหมาย SSH/tmux เหล่านั้นแล้วไม่มีอะไรเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir UniConnect penceresi zaten bu SSH/tmux hedeflerinden birine sahip. Hiçbir şey değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інше вікно UniConnect вже володіє одним із цих цілей SSH/tmux. Нічого не змінилося."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 UniConnect 窗口已拥有这些 SSH/tmux 目标之一。一切都没有改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 UniConnect 視窗已擁有這些 SSH/tmux 目標之一。一切都沒有改變。"
          }
        }
      }
    },
    "uniconnect.ssh.edit.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SSH command is not a supported safe connection command."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأمر SSH ليس أمر اتصال آمن مدعومًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naredba SSH nije podržana naredba sigurnog povezivanja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoen SSH er ikke en understøttet sikker forbindelseskommando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl SSH ist kein unterstützter sicherer Verbindungsbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando SSH no es un comando de conexión seguro compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande SSH n'est pas une commande de connexion sécurisée prise en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando SSH non è un comando di connessione sicura supportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH コマンドは、サポートされている安全な接続コマンドではありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពាក្យបញ្ជា SSH មិនមែនជាពាក្យបញ្ជាការតភ្ជាប់សុវត្ថិភាពដែលគាំទ្រទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 명령은 지원되는 안전 연결 명령이 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoen SSH er ikke en sikker tilkoblingskommando som støttes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie SSH nie jest obsługiwanym poleceniem bezpiecznego połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando SSH não é um comando de conexão segura suportado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда SSH не является поддерживаемой командой безопасного подключения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่ง SSH ไม่ใช่คำสั่งการเชื่อมต่อที่ปลอดภัยที่รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH komutu desteklenen bir güvenli bağlantı komutu değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда SSH не є підтримуваною командою безпечного з’єднання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 命令不是受支持的安全连接命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 指令不是受支援的安全連線指令。"
          }
        }
      }
    },
    "uniconnect.ssh.edit.error.rollback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection rollback could not be completed. Keep UniConnect open and reconnect the affected windows before quitting."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إكمال عملية التراجع عن الاتصال.أبق UniConnect مفتوحًا وأعد توصيل النوافذ المتأثرة قبل الخروج."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraćanje veze nije moglo biti dovršeno. Držite UniConnect otvorenim i ponovo povežite pogođene prozore prije nego što napustite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbageføringen af forbindelsen kunne ikke fuldføres. Hold UniConnect åben, og tilslut de berørte vinduer igen, før du afslutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verbindungs-Rollback konnte nicht abgeschlossen werden. Lassen Sie UniConnect geöffnet und schließen Sie die betroffenen Fenster erneut an, bevor Sie den Vorgang beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo revertir la conexión. Mantén UniConnect abierto y vuelve a conectar las ventanas afectadas antes de salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'annulation de la connexion n'a pas pu être effectuée. Gardez UniConnect ouvert et reconnectez les fenêtres concernées avant de quitter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare il rollback della connessione. Tieni aperto UniConnect e ricollega le finestre interessate prima di uscire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続のロールバックを完了できませんでした。UniConnect を開いたままにし、終了する前に影響を受けるウィンドウを再接続します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការភ្ជាប់ឡើងវិញមិនអាចបញ្ចប់បានទេ។រក្សា UniConnect បើក ហើយភ្ជាប់បង្អួចដែលរងផលប៉ះពាល់ឡើងវិញ មុនពេលបិទ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 롤백을 완료할 수 없습니다.종료하기 전에 UniConnect을 열어두고 영향을 받은 창을 다시 연결하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakeføringen av tilkoblingen kunne ikke fullføres. Hold UniConnect åpen og koble til de berørte vinduene igjen før du avslutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można ukończyć przywracania połączenia. Pozostaw UniConnect otwarte i podłącz ponownie okna, których to dotyczy, przed wyjściem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reversão da conexão não pôde ser concluída. Mantenha UniConnect aberto e reconecte as janelas afetadas antes de sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откат соединения не удалось завершить. Оставьте UniConnect открытым и повторно подключите затронутые окна перед выходом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถย้อนกลับการเชื่อมต่อได้สำเร็จเปิด UniConnect ไว้และเชื่อมต่อหน้าต่างที่ได้รับผลกระทบอีกครั้งก่อนที่จะออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı geri alma işlemi tamamlanamadı. Çıkmadan önce UniConnect açık tutun ve etkilenen pencereleri yeniden bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити відкат підключення. Тримайте UniConnect відкритим і знову підключіть уражені вікна перед виходом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接回滚无法完成。退出之前，请保持 UniConnect 打开并重新连接受影响的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接回滾無法完成。退出前，請保持 UniConnect 開啟並重新連接受影響的視窗。"
          }
        }
      }
    },

          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni Claude in sospeso devono essere ripristinate prima che possa iniziare un nuovo aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい更新を開始するには、保留中の Claude セッションを復元する必要があります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វគ្គ Claude ដែលកំពុងរង់ចាំត្រូវតែស្ដារឡើងវិញ មុនពេលអាប់ដេតថ្មីអាចចាប់ផ្តើម។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 업데이트를 시작하려면 보류 중인 Claude 세션을 복원해야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventende Claude-økter må gjenopprettes før en ny oppdatering kan starte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed rozpoczęciem nowej aktualizacji należy przywrócić oczekujące sesje Claude."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões Claude pendentes devem ser restauradas antes que uma nova atualização possa ser iniciada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидающие сеансы Claude должны быть восстановлены, прежде чем можно будет начать новое обновление."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซสชัน Claude ที่ค้างอยู่จะต้องได้รับการกู้คืนก่อนจึงจะสามารถเริ่มการอัปเดตใหม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir güncellemenin başlayabilmesi için, beklemedeki Claude oturumlarının geri yüklenmesi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед початком нового оновлення необхідно відновити незавершені сеанси Claude."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须先恢复挂起的 Claude 会话，然后才能开始新的更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須先恢復掛起的 Claude 會話，然後才能開始新的更新。"
          }
        }
      }
    },
    "claudeUpdate.error.unsafePlan": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف التحديث لعدم إمكانية التمييز بين نافذتين بشكل آمن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranje je zaustavljeno jer se dva prozora nisu mogla bezbedno razlikovati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdateringen blev stoppet, fordi to vinduer ikke kunne skelnes sikkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update wurde gestoppt, da zwei Fenster nicht sicher unterschieden werden konnten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update was stopped because two windows could not be distinguished safely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización se detuvo porque no se pudieron distinguir dos ventanas de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour a été arrêtée car deux fenêtres n'ont pas pu être distinguées en toute sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiornamento è stato interrotto perché non è stato possibile distinguere con sicurezza due finestre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのウィンドウを安全に区別できないため、アップデートを停止しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការអាប់ដេតត្រូវបានបញ្ឈប់ ដោយសារបង្អួចពីរមិនអាចបែងចែកដោយសុវត្ថិភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 창을 안전하게 구분하지 못해 업데이트가 중단되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdateringen ble stoppet fordi to vinduer ikke kunne skilles på en sikker måte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacja została zatrzymana, ponieważ nie można było bezpiecznie rozróżnić dwóch okien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização foi interrompida porque duas janelas não puderam ser distinguidas com segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление было остановлено, поскольку не удалось безопасно различить два окна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอัปเดตหยุดลงเนื่องจากไม่สามารถแยกแยะสองหน้าต่างได้อย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki pencere güvenli bir şekilde ayırt edilemediği için güncelleme durduruldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення зупинено, оскільки два вікна не вдалося безпечно розрізнити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于无法安全区分两个窗口，更新已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於無法安全區分兩個窗口，更新已停止。"
          }
        }
      }
    },

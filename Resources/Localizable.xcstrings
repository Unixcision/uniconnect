    "terminal.imageTransfer.error.sshpassMissing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب اتصال SSH هذا أداة sshpass، لكن UniConnect لم يعثر عليها. ثبّت sshpass ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova SSH veza zahtijeva sshpass, ali ga UniConnect nije mogao pronaći. Instalirajte sshpass i pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne SSH-forbindelse kræver sshpass, men UniConnect kunne ikke finde det. Installer sshpass, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese SSH-Verbindung benötigt sshpass, aber UniConnect konnte es nicht finden. Installiere sshpass und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This SSH connection needs sshpass, but UniConnect couldn't find it. Install sshpass and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión SSH necesita sshpass, pero UniConnect no lo ha encontrado. Instala sshpass y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion SSH nécessite sshpass, mais UniConnect ne l’a pas trouvé. Installez sshpass, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa connessione SSH richiede sshpass, ma UniConnect non è riuscito a trovarlo. Installa sshpass e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この SSH 接続には sshpass が必要ですが、UniConnect で見つかりませんでした。sshpass をインストールして、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការតភ្ជាប់ SSH នេះត្រូវការ sshpass ប៉ុន្តែ UniConnect រកវាមិនឃើញទេ។ ដំឡើង sshpass រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 SSH 연결에는 sshpass가 필요하지만 UniConnect에서 찾을 수 없습니다. sshpass를 설치한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne SSH-tilkoblingen krever sshpass, men UniConnect fant det ikke. Installer sshpass og prøv på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To połączenie SSH wymaga sshpass, ale UniConnect nie mógł go znaleźć. Zainstaluj sshpass i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexão SSH precisa do sshpass, mas o UniConnect não conseguiu encontrá-lo. Instale o sshpass e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого SSH-подключения требуется sshpass, но UniConnect не удалось его найти. Установите sshpass и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อ SSH นี้ต้องใช้ sshpass แต่ UniConnect หาไม่พบ โปรดติดตั้ง sshpass แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu SSH bağlantısı sshpass gerektiriyor, ancak UniConnect bunu bulamadı. sshpass'i yükleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього SSH-підключення потрібен sshpass, але UniConnect не вдалося його знайти. Установіть sshpass і повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 SSH 连接需要 sshpass，但 UniConnect 找不到它。请安装 sshpass 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 SSH 連線需要 sshpass，但 UniConnect 找不到它。請安裝 sshpass 後再試一次。"
          }
        }
      }
    },
    "terminal.imageTransfer.error.detachedWindow": {
      "extractionState": "manual",
      "localizations": {

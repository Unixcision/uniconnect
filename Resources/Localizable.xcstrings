        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe y no es un complemento UniConnect; dejándolo solo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe et n'est pas un plugin UniConnect ; le laisser tranquille"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esiste e non è un plugin UniConnect; lasciandolo stare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は存在しますが、UniConnect プラグインではありません。放っておいて"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មានហើយមិនមែនជាកម្មវិធីជំនួយ UniConnect ទេ។ទុកវាឱ្យនៅម្នាក់ឯង"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@가 존재하며 UniConnect 플러그인이 아닙니다.내버려두고"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eksisterer og er ikke en UniConnect-plugin; lar det være i fred"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ istnieje i nie jest wtyczką UniConnect; zostawiając to w spokoju"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe e não é um plugin UniConnect; deixando isso sozinho"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ существует и не является плагином UniConnect; оставив это в покое"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ มีอยู่แล้วและไม่ใช่ปลั๊กอิน UniConnectทิ้งมันไว้ตามลำพัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mevcuttur ve bir UniConnect eklentisi değildir; onu yalnız bırakmak"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ існує і не є плагіном UniConnect; залишаючи це в спокої"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 存在，但不是 UniConnect 插件；不理会它"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 存在，但不是 UniConnect 插件；不理會它"
          }

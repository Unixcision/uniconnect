          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun espace de travail principal n'est disponible pour cette importation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è disponibile alcuno spazio di lavoro principale per questa importazione."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនមានកន្លែងធ្វើការសំខាន់សម្រាប់ការនាំចូលនេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 가져오기에 사용할 수 있는 기본 작업공간이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke noe hovedarbeidsområde tilgjengelig for denne importen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla tego importu nie jest dostępny żaden główny obszar roboczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço de trabalho principal disponível para esta importação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого импорта нет основного рабочего пространства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีพื้นที่ทำงานหลักสำหรับการนำเข้านี้"

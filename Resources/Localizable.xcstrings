    "settings.globalHotkey.enable.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on to show or hide all UniConnect windows from any app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでも UniConnect のすべてのウィンドウを表示または非表示にするにはオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 켜면 어떤 앱에서든 모든 UniConnect 윈도우를 표시하거나 숨길 수 있습니다."
          }
        }
      }
    },
    "settings.globalHotkey.enable.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the shortcut from any app to show or hide all UniConnect windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでもこのショートカットで UniConnect のすべてのウィンドウを表示または非表示にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱에서든 단축키를 눌러 모든 UniConnect 윈도우를 표시하거나 숨깁니다."
          }
        }
      }
    },
    "settings.globalHotkey.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Command, Option, or Control with another key. No extra macOS permission is required."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command、Option、または Control と別のキーを組み合わせてください。追加の macOS 権限は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command, Option 또는 Control과 다른 키를 함께 사용하세요. 추가 macOS 권한이 필요하지 않습니다."
          }
        }
      }
    },

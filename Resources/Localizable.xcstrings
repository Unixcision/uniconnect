        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TextBox je beta funkcija. Zadane vrijednosti i ponašanje mogu se promijeniti tokom testiranja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",

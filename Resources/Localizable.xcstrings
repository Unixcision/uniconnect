    "terminal.imageTransfer.error.sourceChanged": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر الملف المحلي أثناء رفعه. حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna datoteka se promijenila tokom prijenosa. Pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale fil blev ændret under upload. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Datei wurde während des Uploads geändert. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local file changed while it was being uploaded. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo local cambió mientras se subía. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier local a été modifié pendant son envoi. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file locale è cambiato durante il caricamento. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード中にローカルファイルが変更されました。もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារមូលដ្ឋានបានផ្លាស់ប្តូរ ខណៈពេលកំពុងផ្ទុកឡើង។ សូមព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 중에 로컬 파일이 변경되었습니다. 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale filen ble endret under opplasting. Prøv på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik lokalny zmienił się podczas przesyłania. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo local foi alterado durante o envio. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный файл изменился во время загрузки. Повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ในเครื่องเปลี่ยนแปลงระหว่างการอัปโหลด โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel dosya yüklenirken değişti. Yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальний файл змінився під час завантаження. Спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地文件在上传过程中发生了更改。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機檔案在上傳過程中發生變更。請再試一次。"
          }
        }
      }
    },
    "terminal.imageTransfer.error.remoteRejected": {

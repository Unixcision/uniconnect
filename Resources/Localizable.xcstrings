    "cli.hooks.agentConfigMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required agent configuration is missing. Run `cmux hooks setup` after installing your agent CLI."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكوين agent المطلوب مفقود.قم بتشغيل `cmux hooks setup` بعد تثبيت agent CLI."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostaje potrebna konfiguracija agent. Pokrenite `cmux hooks setup` nakon instalacije vašeg agent CLI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påkrævet agent-konfiguration mangler. Kør `cmux hooks setup` efter installation af din agent CLI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erforderliche agent-Konfiguration fehlt. Führen Sie `cmux hooks setup` aus, nachdem Sie Ihre agent-CLI installiert haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la configuración agent requerida. Ejecute `cmux hooks setup` después de instalar su CLI agent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration agent requise est manquante. Exécutez `cmux hooks setup` après avoir installé votre CLI agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca la configurazione agent richiesta. Esegui `cmux hooks setup` dopo aver installato la CLI agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な agent 構成がありません。agent CLI をインストールした後、`cmux hooks setup` を実行します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការកំណត់ agent ដែលត្រូវការបានបាត់។ដំណើរការ `cmux hooks setup` បន្ទាប់ពីដំឡើង agent CLI របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필수 agent 구성이 누락되었습니다.agent CLI를 설치한 후 `cmux hooks setup`를 실행합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nødvendig agent-konfigurasjon mangler. Kjør `cmux hooks setup` etter at du har installert agent CLI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wymaganej konfiguracji agent. Uruchom `cmux hooks setup` po zainstalowaniu interfejsu CLI agent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração agent necessária está ausente. Execute `cmux hooks setup` após instalar sua CLI agent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуемая конфигурация agent отсутствует. Запустите `cmux hooks setup` после установки CLI agent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกำหนดค่า agent ที่จำเป็นขาดหายไปรัน `cmux hooks setup` หลังจากติดตั้ง agent CLI ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerekli agent yapılandırması eksik.agent CLI'nizi yükledikten sonra `cmux hooks setup`'yi çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необхідна конфігурація agent відсутня. Запустіть `cmux hooks setup` після встановлення agent CLI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少所需的 agent 配置。安装 agent CLI 后运行 `cmux hooks setup`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少所需的 agent 配置。安裝 agent CLI 後運行 `cmux hooks setup`。"
          }
        }
      }
    },

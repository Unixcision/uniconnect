    "settings.app.defaultTerminal.dialog.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect will ask macOS to use this app for SSH links, .command/.tool files, and UNIX executables. macOS may show a confirmation prompt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect は、このアプリを SSH リンク、.command/.tool ファイル、UNIX 実行ファイルに使うよう macOS に要求します。macOS が確認を表示する場合があります。"
          }
        }
      }
    },
    "settings.app.defaultTerminal.dialog.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set UniConnect as default terminal?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect をデフォルトターミナルに設定しますか?"
          }
        }
      }
    },
    "settings.app.defaultTerminal.subtitleDefault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect handles SSH links, .command/.tool files, and UNIX executables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect は SSH リンク、.command/.tool ファイル、UNIX 実行ファイルを処理します。"
          }
        }
      }
    },
    "settings.app.defaultTerminal.subtitleNotDefault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set UniConnect as the handler for SSH links, .command/.tool files, and UNIX executables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH リンク、.command/.tool ファイル、UNIX 実行ファイルのハンドラとして UniConnect を設定します。"
          }
        }
      }
    },

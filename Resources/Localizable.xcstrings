    "cli.omo.noPackageManager": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على bun أو npm في PATH. ثبّت %1$@ يدويًا: bunx %2$@ install"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni bun ni npm nisu pronađeni u PATH-u. Instalirajte %1$@ ručno: bunx %2$@ install"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hverken bun eller npm blev fundet i PATH. Installer %1$@ manuelt: bunx %2$@ install"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weder bun noch npm wurde in PATH gefunden. Installieren Sie %1$@ manuell: bunx %2$@ install"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither bun nor npm found in PATH. Install %1$@ manually: bunx %2$@ install"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró bun ni npm en PATH. Instala %1$@ manualmente: bunx %2$@ install"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni bun ni npm n’a été trouvé dans PATH. Installez %1$@ manuellement : bunx %2$@ install"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Né bun né npm trovati in PATH. Installa %1$@ manualmente: bunx %2$@ install"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PATH に bun も npm も見つかりません。%1$@ を手動でインストールしてください: bunx %2$@ install"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PATH에서 bun 또는 npm을 찾을 수 없습니다. %1$@을(를) 직접 설치하세요: bunx %2$@ install"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant verken bun eller npm i PATH. Installer %1$@ manuelt: bunx %2$@ install"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono bun ani npm w PATH. Zainstaluj %1$@ ręcznie: bunx %2$@ install"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem bun nem npm foram encontrados no PATH. Instale %1$@ manualmente: bunx %2$@ install"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В PATH не найден ни bun, ни npm. Установите %1$@ вручную: bunx %2$@ install"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบ bun หรือ npm ใน PATH ติดตั้ง %1$@ ด้วยตนเอง: bunx %2$@ install"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PATH içinde bun veya npm bulunamadı. %1$@ paketini elle yükleyin: bunx %2$@ install"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У PATH не знайдено ні bun, ні npm. Встановіть %1$@ вручну: bunx %2$@ install"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 PATH 中找不到 bun 或 npm。请手动安装 %1$@：bunx %2$@ install"

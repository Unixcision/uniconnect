    "uniconnect.ssh.probe.error.unknownPackageManager": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No supported package manager was found on the server."
          }
        },
        "ar": {
          "stringUnit": {

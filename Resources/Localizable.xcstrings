          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장 작업이 승인되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forlengelsestiltak gis ikke"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcja przedłużająca nie została przyznana"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ação de extensão não é concedida"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие продления не предоставлено"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่อนุญาตให้ดำเนินการขยาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzatma işlemi kabul edilmedi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дія продовження не надається"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "延期行动未获准"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "延期行動未獲準"
          }
        }
      }
    },
    "sidebar.extensions.access.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will not receive workspace data or run actions until you grant its requested access."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتلقى %@ بيانات مساحة العمل أو يقوم بتشغيل الإجراءات حتى تمنحه حق الوصول المطلوب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ neće primati podatke radnog prostora niti pokretati radnje dok ne odobrite traženi pristup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vil ikke modtage arbejdsområdedata eller køre handlinger, før du giver den anmodede adgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ empfängt keine Arbeitsbereichsdaten und führt keine Aktionen aus, bis Sie den angeforderten Zugriff gewähren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no recibirá datos del espacio de trabajo ni ejecutará acciones hasta que usted le otorgue el acceso solicitado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne recevra pas les données de l'espace de travail ni n'exécutera d'actions tant que vous n'aurez pas accordé l'accès demandé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non riceverà dati dell'area di lavoro né eseguirà azioni finché non concederai l'accesso richiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、要求されたアクセスを許可するまで、ワークスペース データを受信したり、アクションを実行したりすることはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ នឹង​មិន​ទទួល​បាន​ទិន្នន័យ​កន្លែង​ធ្វើ​ការ ឬ​ដំណើរការ​សកម្មភាព​ទេ រហូត​ទាល់​តែ​អ្នក​ផ្តល់​សិទ្ធិ​ចូល​ដំណើរការ​ដែល​បាន​ស្នើ​សុំ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 요청된 액세스 권한을 부여할 때까지 작업공간 데이터를 수신하거나 작업을 실행하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vil ikke motta arbeidsområdedata eller kjøre handlinger før du gir den forespurte tilgangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie będzie otrzymywać danych obszaru roboczego ani nie będzie wykonywać żadnych działań, dopóki nie udzielisz mu żądanego dostępu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não receberá dados do espaço de trabalho nem executará ações até que você conceda o acesso solicitado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не будет получать данные рабочей области и выполнять действия, пока вы не предоставите запрошенный доступ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะไม่ได้รับข้อมูลพื้นที่ทำงานหรือดำเนินการจนกว่าคุณจะให้สิทธิ์การเข้าถึงตามที่ร้องขอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, siz istenen erişimi verene kadar çalışma alanı verilerini almayacak veya eylemleri çalıştırmayacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не отримуватиме дані робочої області та не виконуватиме дії, доки ви не надасте запитуваний доступ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您授予其请求的访问权限之前，%@ 将不会接收工作区数据或运行操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您授予其請求的存取權限之前，%@ 將不會接收工作區資料或運行操作。"
          }
        }
      }
    },

            "value": "在此 Mac 上未找到 cmux 会话 (Application Support/cmux/session-com.cmuxterm.app.json)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Mac 上找不到 cmux 會話 (Application Support/cmux/session-com.cmuxterm.app.json)。"
          }
        }
      }
    },

    "uniconnect.localWindow.action.reassignRoot.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجلد المحفوظ غير متوفر. لن يتم تشغيل أي شيء حتى تختار موقعه الجديد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sačuvani folder je nedostupan. Ništa neće raditi dok ne odaberete njegovu novu lokaciju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gemte mappe er ikke tilgængelig. Intet vil køre, før du vælger dets nye placering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Ordner ist nicht verfügbar. Es wird nichts ausgeführt, bis Sie den neuen Speicherort ausgewählt haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved folder is unavailable. Nothing will run until you choose its new location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta guardada no está disponible. Nada se ejecutará hasta que elijas su nueva ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier enregistré n'est pas disponible. Rien ne fonctionnera tant que vous n'aurez pas choisi son nouvel emplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella salvata non è disponibile. Niente verrà eseguito finché non sceglierai la nuova posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたフォルダーは使用できません。新しい場所を選択するまでは何も実行されません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថតឯកសារដែលបានរក្សាទុកមិនអាចប្រើបានទេ។ គ្មានអ្វីនឹងដំណើរការរហូតដល់អ្នកជ្រើសរើសទីតាំងថ្មីរបស់វា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 폴더를 사용할 수 없습니다. 새 위치를 선택할 때까지는 아무 것도 실행되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lagrede mappen er utilgjengelig. Ingenting vil kjøre før du velger den nye plasseringen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisany folder jest niedostępny. Nic nie będzie działać, dopóki nie wybierzesz nowej lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta salva não está disponível. Nada será executado até que você escolha seu novo local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраненная папка недоступна. Ничто не будет работать, пока вы не выберете новое местоположение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์ที่บันทึกไว้ไม่พร้อมใช้งาน จะไม่มีอะไรทำงานจนกว่าคุณจะเลือกตำแหน่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen klasör kullanılamıyor. Siz yeni konumunu seçinceye kadar hiçbir şey çalışmayacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережена папка недоступна. Ніщо не працюватиме, доки ви не виберете його нове місце."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的文件夹不可用。在您选择新位置之前，任何操作都不会运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的資料夾不可用。在您選擇新位置之前，任何操作都不會運作。"
          }
        }
      }
    },

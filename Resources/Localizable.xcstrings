    "sidebar.extensions.access.review.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect will only share the following data and actions if you allow this request."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يقوم UniConnect بمشاركة البيانات والإجراءات التالية إلا إذا سمحت بهذا الطلب."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect će dijeliti sljedeće podatke i radnje samo ako dozvolite ovaj zahtjev."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect deler kun følgende data og handlinger, hvis du tillader denne anmodning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect gibt die folgenden Daten und Aktionen nur weiter, wenn Sie dieser Anfrage zustimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect solo compartirá los siguientes datos y acciones si usted permite esta solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ne partagera les données et actions suivantes que si vous autorisez cette demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect condividerà i seguenti dati e azioni solo se consenti questa richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect は、このリクエストを許可した場合にのみ、次のデータとアクションを共有します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect នឹងចែករំលែកទិន្នន័យ និងសកម្មភាពខាងក្រោមតែប៉ុណ្ណោះ ប្រសិនបើអ្នកអនុញ្ញាតសំណើនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect은(는) 이 요청을 허용하는 경우에만 다음 데이터와 작업을 공유합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect vil bare dele følgende data og handlinger hvis du tillater denne forespørselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect udostępni następujące dane i działania tylko wtedy, gdy wyrazisz zgodę na tę prośbę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect só compartilhará os seguintes dados e ações se você permitir esta solicitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect будет передавать следующие данные и действия только в том случае, если вы разрешите этот запрос."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect จะแชร์ข้อมูลและการดำเนินการต่อไปนี้หากคุณอนุญาตคำขอนี้เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect yalnızca bu isteğe izin vermeniz durumunda aşağıdaki verileri ve eylemleri paylaşacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect надаватиме доступ до наведених нижче даних і дій, лише якщо ви дозволите цей запит."
          }
        },
        "zh-Hans": {

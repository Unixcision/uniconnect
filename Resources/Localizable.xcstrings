        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "vérification en lecture seule, puis joignez l'existant tmux %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "controllo di sola lettura, quindi allega tmux %@ esistente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用にチェックを入れ、既存の tmux %@ を添付します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពិនិត្យបានតែអាន បន្ទាប់មកភ្ជាប់ tmux ដែលមានស្រាប់ %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 확인 후 기존 tmux %@ 첨부"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "skrivebeskyttet sjekk, og legg ved eksisterende tmux %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "sprawdź tylko do odczytu, a następnie dołącz istniejące tmux %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "verificação somente leitura e anexe tmux existente %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "проверить только для чтения, затем прикрепить существующие tmux %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบแบบอ่านอย่างเดียว จากนั้นแนบ tmux ที่มีอยู่ %@"
          }
        },
        "tr": {
          "stringUnit": {

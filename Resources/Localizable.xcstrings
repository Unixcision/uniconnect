    "cli.path.error.destinationNotOwned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect will not remove %@ because it does not point to this app's bundled cmux CLI."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يقوم UniConnect بإزالة %@ لأنه لا يشير إلى cmux CLI المجمعة لهذا التطبيق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect neće ukloniti %@ jer ne ukazuje na cmux CLI u paketu ove aplikacije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect vil ikke fjerne %@, fordi den ikke peger på denne apps medfølgende cmux CLI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect entfernt %@ nicht, da es nicht auf die gebündelte cmux-CLI dieser App verweist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no eliminará %@ porque no apunta a la CLI cmux incluida en esta aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ne supprimera pas %@ car il ne pointe pas vers la CLI cmux fournie avec cette application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non rimuoverà %@ perché non punta alla CLI cmux in bundle di questa app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect は、このアプリにバンドルされている cmux CLI を指していないため、%@ を削除しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect នឹងមិនដក %@ ចេញទេ ព្រោះវាមិនចង្អុលទៅ cmux CLI ដែលភ្ជាប់មកជាមួយកម្មវិធីនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect는 이 앱의 번들 cmux CLI를 가리키지 않기 때문에 %@를 제거하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect vil ikke fjerne %@ fordi den ikke peker til denne appens medfølgende cmux CLI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie usunie %@, ponieważ nie wskazuje na dołączony interfejs CLI cmux tej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect não removerá %@ porque não aponta para a CLI cmux incluída neste aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не удалит %@, поскольку он не указывает на встроенный в это приложение интерфейс командной строки cmux."
          }

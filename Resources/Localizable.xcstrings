    "history.delete.confirm.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة العنصر من العناصر المغلقة، لذا لم يعد من الممكن إعادة فتحه من UniConnect. لا يتم لمس جلسات tmux عن بعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo uklanja stavku iz zatvorenih stavki, tako da se više ne može ponovo otvoriti iz UniConnect. Udaljene tmux sesije se ne dodiruju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner elementet fra lukkede elementer, så det ikke længere kan genåbnes fra UniConnect. Fjernsessioner tmux berøres ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Element aus „Geschlossene Elemente“ entfernt, sodass es ab UniConnect nicht mehr erneut geöffnet werden kann. Remote-tmux-Sitzungen werden nicht berührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the item from Closed Items, so it can no longer be reopened from UniConnect. Remote tmux sessions are not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el elemento de Cerradas y ya no podrá reabrirse desde UniConnect. Las sesiones tmux remotas no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime l'élément des éléments fermés, il ne peut donc plus être rouvert à partir de UniConnect. Les sessions tmux à distance ne sont pas touchées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò rimuove l'elemento da Elementi chiusi, quindi non può più essere riaperto da UniConnect. Le sessioni remote tmux non vengono toccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「閉じた項目」から削除され、UniConnectで再度開けなくなります。リモートのtmuxセッションには触れません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាដកធាតុចេញពីធាតុដែលបានបិទ ដូច្នេះហើយវាមិនអាចត្រូវបានបើកឡើងវិញពី UniConnect ទៀតទេ។ វគ្គ tmux ពីចម្ងាយមិនត្រូវបានប៉ះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 닫힌 항목에서 해당 항목이 제거되므로 더 이상 UniConnect에서 다시 열 수 없습니다. 원격 tmux 세션은 건드리지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner elementet fra lukkede elementer, slik at det ikke lenger kan gjenåpnes fra UniConnect. Eksterne tmux økter berøres ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie elementu z pozycji zamkniętych, więc nie będzie można go już ponownie otworzyć od UniConnect. Zdalne sesje tmux pozostają nienaruszone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o item dos Itens Fechados, portanto ele não pode mais ser reaberto em UniConnect. As sessões remotas tmux não são tocadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При этом элемент будет удален из списка «Закрытые элементы», и его больше нельзя будет открыть повторно из UniConnect. Удаленные сеансы tmux не затрагиваются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบรายการออกจากรายการที่ปิด ดังนั้นจึงไม่สามารถเปิดใหม่จาก UniConnect ได้อีกต่อไป เซสชันระยะไกล tmux จะไม่ถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, öğeyi Kapalı Öğeler'den kaldırır, dolayısıyla artık UniConnect'den yeniden açılamaz. Uzak tmux oturumlarına dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видаляє елемент із закритих елементів, тому його більше не можна повторно відкрити з UniConnect. Віддалені сеанси tmux не торкаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从“关闭的项目”中删除该项目，因此无法再从 UniConnect 重新打开该项目。远程 tmux 会话不会受到影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將從「關閉的項目」中刪除該項目，因此無法再從 UniConnect 重新開啟該項目。遠端 tmux 會話不會受到影響。"
          }
        }
      }
    },

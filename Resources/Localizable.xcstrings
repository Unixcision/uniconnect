    "cli.hooks.error.configDirNotDirectory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exists but is not a directory. Move it aside before installing %@ UniConnect hooks."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ موجود ولكنه ليس دليلاً.قم بتحريكه جانبًا قبل تثبيت %@ UniConnect hooks."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ postoji, ali nije direktorij. Pomaknite ga u stranu prije instaliranja %@ UniConnect hooks."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eksisterer, men er ikke en mappe. Flyt det til side, før du installerer %@ UniConnect hooks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existiert, ist aber kein Verzeichnis. Legen Sie es beiseite, bevor Sie %@ UniConnect hooks installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe pero no es un directorio. Déjelo a un lado antes de instalar %@ UniConnect hooks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe mais n'est pas un répertoire. Écartez-le avant d'installer %@ UniConnect hooks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esiste ma non è una directory. Spostarlo da parte prima di installare %@ UniConnect hooks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は存在しますが、ディレクトリではありません。%@ UniConnect hooks をインストールする前に、脇に移動してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មាន ប៉ុន្តែមិនមែនជាថតទេ។ផ្លាស់ទីវាមួយឡែកសិន មុនពេលដំឡើង %@ UniConnect hooks ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@가 존재하지만 디렉터리가 아닙니다.%@ UniConnect hooks를 설치하기 전에 옆으로 치워두세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eksisterer, men er ikke en katalog. Flytt den til side før du installerer %@ UniConnect hooks."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ istnieje, ale nie jest katalogiem. Odsuń go na bok przed instalacją %@ UniConnect hooks."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe, mas não é um diretório. Afaste-o antes de instalar %@ UniConnect hooks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ существует, но не является каталогом. Перед установкой %@ UniConnect hooks отодвиньте его в сторону."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ มีอยู่แต่ไม่ใช่ไดเร็กทอรีย้ายออกไปก่อนที่จะติดตั้ง %@ UniConnect hooks"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mevcut ancak bir dizin değil.%@ UniConnect hooks'yi kurmadan önce onu bir kenara bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ існує, але не є каталогом. Відсуньте його перед встановленням %@ UniConnect hooks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 存在，但不是目录。安装 %@ UniConnect hooks 之前将其移到一边。"

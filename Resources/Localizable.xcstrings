    "uniconnect.localWindow.runtime.agent.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم /exit أولاً للعودة إلى shell وتبديل الوكلاء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo koristite /exit da se vratite na shell i promijenite agente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug /exit først for at vende tilbage til shell og skifte agent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie zuerst /exit, um zu shell zurückzukehren und den Agenten zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use /exit first to return to the shell and switch agents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa /exit primero para volver al shell y cambiar de agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez /exit d'abord pour revenir au shell et changer d'agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare prima /exit per tornare a shell e cambiare agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず /exit を使用して shell に戻り、エージェントを切り替えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រើ /exit ជាដំបូងដើម្បីត្រឡប់ទៅ shell ហើយប្តូរភ្នាក់ងារ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 /exit를 사용하여 shell으로 돌아가 에이전트를 전환하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk /exit først for å gå tilbake til shell og bytte agent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj najpierw /exit, aby wrócić do shell i zmienić agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use /exit primeiro para retornar ao shell e trocar de agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала используйте /exit, чтобы вернуться к shell и переключить агентов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ /exit ก่อนเพื่อกลับไปที่ shell และสลับตัวแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "/exit'ye dönüp shell'ye dönün ve aracıları değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку використовуйте /exit, щоб повернутися до shell і змінити агента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首先使用/exit返回到shell并切换代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首先使用/exit返回shell並切換代理程式。"
          }
        }
      }
    },

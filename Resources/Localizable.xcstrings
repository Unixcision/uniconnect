    "claudeUpdate.confirm.safetyDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخرج كل جلسة Claude التي تم التحقق منها بشكل نظيف، ويتم تحديث مضيفها مرة واحدة، ويستأنف UUID المحدد في نفس النافذة. تقوم التحديثات الفاشلة باستعادة الجلسة السابقة على الفور."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka verifikovana Claude sesija izlazi čisto, njen host se ažurira jednom, a tačan UUID se nastavlja u istom prozoru. Neuspjela ažuriranja odmah vraćaju prethodnu sesiju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver verificeret Claude-session afsluttes rent, dens vært opdateres én gang, og den nøjagtige UUID genoptages i det samme vindue. Mislykkede opdateringer gendanner den forrige session med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede verifizierte Claude-Sitzung wird sauber beendet, ihr Host einmal aktualisiert und die Sitzung mit exakt derselben UUID im selben Fenster fortgesetzt. Bei fehlgeschlagenen Updates wird die vorherige Sitzung sofort wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each verified Claude session exits cleanly, its host updates once, and the exact UUID resumes in the same window. Failed updates restore the previous session immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sesión Claude verificada sale limpiamente, su host se actualiza una vez y el UUID exacto se reanuda en la misma ventana. Las actualizaciones fallidas restauran la sesión anterior inmediatamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque session Claude vérifiée se termine proprement, son hôte est mis à jour une seule fois et la session portant exactement le même UUID reprend dans la même fenêtre. En cas d’échec, la session précédente est immédiatement restaurée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sessione Claude verificata esce in modo pulito, il suo host si aggiorna una volta e l'esatto UUID riprende nella stessa finestra. Gli aggiornamenti non riusciti ripristinano immediatamente la sessione precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証された各 Claude セッションは正常に終了し、そのホストが 1 回更新され、同じウィンドウで正確な UUID が再開されます。更新に失敗すると、前のセッションがすぐに復元されます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វគ្គ Claude ដែលបានផ្ទៀងផ្ទាត់នីមួយៗត្រូវបានដកចេញយ៉ាងស្អាត ការធ្វើបច្ចុប្បន្នភាពម៉ាស៊ីនរបស់វាម្តង ហើយ UUID ពិតប្រាកដបន្តនៅក្នុងបង្អួចតែមួយ។ ការអាប់ដេតដែលបរាជ័យ ស្ដារវគ្គមុនភ្លាមៗ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인된 각 Claude 세션은 완전히 종료되고 해당 호스트는 한 번 업데이트되며 정확한 UUID는 동일한 창에서 다시 시작됩니다. 업데이트가 실패하면 이전 세션이 즉시 복원됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver verifisert Claude-sesjon avsluttes rent, vertsoppdateringer én gang, og den nøyaktige UUID gjenopptas i samme vindu. Mislykkede oppdateringer gjenoppretter forrige økt umiddelbart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda zweryfikowana sesja Claude kończy się prawidłowo, jej host jest aktualizowany raz, a dokładna sesja UUID zostaje wznowiona w tym samym oknie. Nieudane aktualizacje natychmiast przywracają poprzednią sesję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sessão Claude verificada termina corretamente, seu host é atualizado uma vez e o UUID exato é retomado na mesma janela. As atualizações com falha restauram a sessão anterior imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый проверенный сеанс Claude завершается без ошибок, его хост обновляется один раз, и конкретный UUID возобновляется в том же окне. Неудачные обновления немедленно восстанавливают предыдущий сеанс."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละเซสชัน Claude ที่ได้รับการยืนยันจะออกอย่างสมบูรณ์ โฮสต์จะอัปเดตหนึ่งครั้ง และ UUID ที่แน่นอนจะดำเนินการต่อในหน้าต่างเดียวกัน การอัปเดตที่ล้มเหลวจะคืนค่าเซสชันก่อนหน้าทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanan her Claude oturumu temiz bir şekilde çıkar, ana bilgisayarı bir kez güncellenir ve tam UUID aynı pencerede devam eder. Başarısız güncellemeler önceki oturumu hemen geri yükler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна перевірена сесія Claude завершується чисто, її хост оновлюється один раз, і точний UUID відновлюється в тому самому вікні. Невдале оновлення негайно відновлює попередній сеанс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个经过验证的 Claude 会话都会干净地退出，其主机更新一次，并且确切的 UUID 在同一窗口中恢复。失败的更新会立即恢复之前的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個經過驗證的 Claude 會話都會乾淨地退出，其主機更新一次，並且確切的 UUID 在同一視窗中恢復。失敗的更新會立即恢復先前的會話。"
          }
        }
      }
    },

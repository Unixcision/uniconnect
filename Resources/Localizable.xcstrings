            "state": "translated",
            "value": "Lokalny katalog roboczy okna musi znajdować się w folderze zaufanej skrzynki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um diretório de trabalho da janela local deve permanecer dentro de sua pasta confiável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

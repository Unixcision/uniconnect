          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites clignoter brièvement un contour bleu lorsque UniConnect met en surbrillance un volet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampeggia brevemente un contorno blu quando UniConnect evidenzia un riquadro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចេញ​គ្រោង​ពណ៌​ខៀវ​ដោយ​សង្ខេប​នៅ​ពេល UniConnect រំលេច​ផ្ទាំង​មួយ​។"
          }

    "dialog.textURL.error.multipleLinks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one UniConnect external link can be opened at a time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect の外部リンクは一度に 1 つだけ開けます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede abrir un enlace externo de UniConnect a la vez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن فتح رابط خارجي واحد من UniConnect فقط في كل مرة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ét eksternt UniConnect-link kan åbnes ad gangen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare én ekstern UniConnect-kobling kan åpnes om gangen."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Istovremeno se može otvoriti samo jedna vanjska UniConnect veza."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 하나의 UniConnect 외부 링크만 열 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann jeweils nur ein externer UniConnect-Link geöffnet werden."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មានតែតំណភ្ជាប់ខាងក្រៅ UniConnect មួយប៉ុណ្ណោះដែលអាចបើកបានក្នុងពេលតែមួយ។"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile aprire solo un link esterno UniConnect alla volta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul lien externe UniConnect peut être ouvert à la fois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременно можно открыть только одну внешнюю ссылку UniConnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次只能打开一个 UniConnect 外部链接。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednocześnie można otworzyć tylko jeden zewnętrzny link UniConnect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas um link externo do UniConnect pode ser aberto por vez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одночасно можна відкрити лише одне зовнішнє посилання UniConnect."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถเปิดลิงก์ภายนอก UniConnect ได้ครั้งละหนึ่งรายการเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda yalnızca bir harici UniConnect bağlantısı açılabilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次只能開啟一個 UniConnect 外部連結。"
          }
        }
      }
    },
    "dialog.textURL.error.nameContainsUnsafeCharacters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link name contains hidden control or formatting characters, so UniConnect refused to use it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク名に非表示の制御文字または書式文字が含まれているため、UniConnect は使用を拒否しました。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي اسم الارتباط على أحرف تحكم أو تنسيق مخفية، لذا رفضت UniConnect استخدامه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du lien contient des caractères de contrôle ou de formatage cachés, donc UniConnect a refusé de l'utiliser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del enlace contiene caracteres de control o formato ocultos, por lo que UniConnect se negó a usarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linkname enthält versteckte Steuer- oder Formatierungszeichen, daher weigerte sich UniConnect, ihn zu verwenden."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime veze sadrži skrivene znakove za kontrolu ili formatiranje, tako da je UniConnect odbio da ga koristi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koblingsnavnet inneholder skjulte kontroll- eller formateringstegn, så UniConnect nektet å bruke det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linknavnet indeholder skjulte kontrol- eller formateringstegn, så UniConnect nægtede at bruge det."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome do link contém controles ocultos ou caracteres de formatação, então UniConnect se recusou a usá-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome del collegamento contiene caratteri di controllo o formattazione nascosti, quindi UniConnect ha rifiutato di utilizzarlo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឈ្មោះតំណមានតួអក្សរដែលលាក់ ឬធ្វើទ្រង់ទ្រាយ ដូច្នេះ UniConnect បដិសេធមិនប្រើវាទេ។"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва посилання містить приховані символи керування або форматування, тому UniConnect відмовився від її використання."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 이름에 숨겨진 제어 또는 서식 지정 문자가 포함되어 있으므로 UniConnect는 이를 사용하기를 거부했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa łącza zawiera ukryte znaki sterujące lub formatujące, więc UniConnect odmówił jego użycia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя ссылки содержит скрытые управляющие или форматирующие символы, поэтому UniConnect отказался ее использовать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接名称包含隐藏控制或格式字符，因此 UniConnect 拒绝使用它。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อลิงก์มีอักขระควบคุมหรือการจัดรูปแบบที่ซ่อนอยู่ ดังนั้น UniConnect จึงปฏิเสธที่จะใช้"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結名稱包含隱藏控製或格式字符，因此 UniConnect 拒絕使用它。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı adı gizli kontrol veya biçimlendirme karakterleri içerdiğinden UniConnect onu kullanmayı reddetti."
          }
        }
      }
    },
    "dialog.textURL.error.nameTooLong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link name is too long. The maximum length is %lld characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク名が長すぎます。最大長は %lld 文字です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم الرابط طويل جدًا. الحد الأقصى للطول هو أحرف %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linknavnet er for langt. Den maksimale længde er %lld tegn."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naziv veze je predugačak. Maksimalna dužina je %lld znakova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del enlace es demasiado largo. La longitud máxima es caracteres %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du lien est trop long. La longueur maximale est de caractères %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linkname ist zu lang. Die maximale Länge beträgt %lld Zeichen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 이름이 너무 깁니다. 최대 길이는 %lld 문자입니다."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome del collegamento è troppo lungo. La lunghezza massima è di %lld caratteri."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឈ្មោះតំណវែងពេក។ ប្រវែងអតិបរមាគឺតួអក្សរ %lld ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linknavnet er for langt. Maksimal lengde er %lld tegn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa linku jest za długa. Maksymalna długość to znaki %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接名称太长。最大长度为 %lld 个字符。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя ссылки слишком длинное. Максимальная длина — %lld символов."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome do link é muito longo. O comprimento máximo é de caracteres %lld."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อลิงก์ยาวเกินไป ความยาวสูงสุดคืออักขระ %lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва посилання задовга. Максимальна довжина – %lld символів."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı adı çok uzun. Maksimum uzunluk %lld karakterdir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結名稱太長。最大長度為 %lld 個字元。"
          }
        }
      }
    },
    "dialog.textURL.error.textContainsUnsafeCharacters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link text contains unsupported or hidden characters, so UniConnect refused to use it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクテキストに未対応または非表示の文字が含まれているため、UniConnect は使用を拒否しました。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkteksten indeholder ikke-understøttede eller skjulte tegn, så UniConnect nægtede at bruge den."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo del collegamento contiene caratteri non supportati o nascosti, quindi UniConnect ha rifiutato di utilizzarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte du lien contient des caractères non pris en charge ou masqués, donc UniConnect a refusé de l'utiliser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي نص الارتباط على أحرف غير مدعومة أو مخفية، لذا رفضت UniConnect استخدامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst veze sadrži nepodržane ili skrivene znakove, pa je UniConnect odbio da ga koristi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linktext enthält nicht unterstützte oder versteckte Zeichen, daher weigerte sich UniConnect, ihn zu verwenden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 텍스트에 지원되지 않거나 숨겨진 문자가 포함되어 있어 UniConnect가 사용을 거부했습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto del enlace contiene caracteres ocultos o no admitidos, por lo que UniConnect se negó a utilizarlo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkteksten inneholder ustøttede eller skjulte tegn, så UniConnect nektet å bruke den."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អត្ថបទតំណមានតួអក្សរដែលមិនគាំទ្រ ឬលាក់ ដូច្នេះ UniConnect បដិសេធមិនប្រើវា។"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст ссылки содержит неподдерживаемые или скрытые символы, поэтому UniConnect отказался ее использовать."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto do link contém caracteres não suportados ou ocultos, então UniConnect recusou-se a usá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接文本包含不支持或隐藏的字符，因此 UniConnect 拒绝使用它。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความลิงก์มีอักขระที่ไม่รองรับหรือซ่อนไว้ ดังนั้น UniConnect จึงปฏิเสธที่จะใช้"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst łącza zawiera nieobsługiwane lub ukryte znaki, dlatego UniConnect odmówił jego użycia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı metni desteklenmeyen veya gizli karakterler içerdiğinden UniConnect onu kullanmayı reddetti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст посилання містить непідтримувані або приховані символи, тому UniConnect відмовився його використовувати."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結文字包含不支援或隱藏的字符，因此 UniConnect 拒絕使用它。"
          }
        }
      }
    },
    "dialog.textURL.error.textTooLong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link text is too long. The maximum length is %lld characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクテキストが長すぎます。最大長は %lld 文字です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص الرابط طويل جدًا. الحد الأقصى للطول هو أحرف %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkteksten er for lang. Den maksimale længde er %lld tegn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto del enlace es demasiado largo. La longitud máxima es caracteres %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte du lien est trop long. La longueur maximale est de caractères %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linktext ist zu lang. Die maximale Länge beträgt %lld Zeichen."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst veze je predugačak. Maksimalna dužina je %lld znakova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 텍스트가 너무 깁니다. 최대 길이는 %lld 문자입니다."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អត្ថបទតំណវែងពេក។ ប្រវែងអតិបរមាគឺតួអក្សរ %lld ។"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst linku jest za długi. Maksymalna długość to znaki %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo del collegamento è troppo lungo. La lunghezza massima è di %lld caratteri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto do link é muito longo. O comprimento máximo é de caracteres %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст ссылки слишком длинный. Максимальная длина — %lld символов."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkteksten er for lang. Maksimal lengde er %lld tegn."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст посилання задовгий. Максимальна довжина – %lld символів."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความลิงก์ยาวเกินไป ความยาวสูงสุดคืออักขระ %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接文本太长。最大长度为 %lld 个字符。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı metni çok uzun. Maksimum uzunluk %lld karakterdir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結文字太長。最大長度為 %lld 個字元。"
          }
        }
      }
    },
    "dialog.textURL.error.titleContainsUnsafeCharacters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link title contains hidden control or formatting characters, so UniConnect refused to use it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクタイトルに非表示の制御文字または書式文字が含まれているため、UniConnect は使用を拒否しました。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي عنوان الارتباط على عناصر تحكم أو أحرف تنسيق مخفية، لذا رفضت UniConnect استخدامه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linktitel enthält versteckte Steuer- oder Formatierungszeichen, daher weigerte sich UniConnect, diese zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título del enlace contiene caracteres de control o formato ocultos, por lo que UniConnect se negó a usarlo."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslov veze sadrži skrivene znakove za kontrolu ili formatiranje, tako da je UniConnect odbio da ga koristi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linktitlen indeholder skjulte kontrol- eller formateringstegn, så UniConnect nægtede at bruge den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koblingstittelen inneholder skjulte kontroll- eller formateringstegn, så UniConnect nektet å bruke den."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 제목에 숨겨진 제어 또는 서식 지정 문자가 포함되어 있어 UniConnect는 이를 사용을 거부했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок ссылки содержит скрытые управляющие или форматирующие символы, поэтому UniConnect отказался его использовать."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណងជើងតំណមានវត្ថុបញ្ជាដែលលាក់ ឬទម្រង់តួអក្សរ ដូច្នេះ UniConnect បដិសេធមិនប្រើវាទេ។"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre du lien contient des caractères de contrôle ou de formatage cachés, donc UniConnect a refusé de l'utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo del collegamento contiene caratteri di controllo o formattazione nascosti, quindi UniConnect ha rifiutato di utilizzarlo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接标题包含隐藏的控制或格式字符，因此 UniConnect 拒绝使用它。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อลิงก์มีอักขระควบคุมหรือการจัดรูปแบบที่ซ่อนอยู่ ดังนั้น UniConnect จึงปฏิเสธที่จะใช้"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuł linku zawiera ukryte znaki sterujące lub formatujące, więc UniConnect odmówił jego użycia."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結標題包含隱藏的控製或格式字符，因此 UniConnect 拒絕使用它。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título do link contém controles ocultos ou caracteres de formatação, então UniConnect se recusou a usá-lo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı başlığı gizli kontrol veya biçimlendirme karakterleri içerdiğinden UniConnect bunu kullanmayı reddetti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок посилання містить приховані символи керування або форматування, тому UniConnect відмовився його використовувати."
          }
        }
      }
    },

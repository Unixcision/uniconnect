          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個導入或恢復操作已在進行中。"
          }
        }
      }
    },
    "uniconnect.import.error.notCommitted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import could not be committed safely. No unverified state was accepted."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تنفيذ الاستيراد بشكل آمن. لم يتم قبول أي حالة لم يتم التحقق منها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvoz nije mogao biti siguran. Nije prihvaćeno nijedno neprovjereno stanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Import kunne ikke udføres sikkert. Ingen ubekræftet tilstand blev accepteret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import konnte nicht sicher ausgeführt werden. Es wurde kein unbestätigter Status akzeptiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación no se pudo realizar de forma segura. No se aceptó ningún estado no verificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importation n'a pas pu être effectuée en toute sécurité. Aucun état non vérifié n'a été accepté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile eseguire l'importazione in modo sicuro. Nessuno stato non verificato è stato accettato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートを安全にコミットできませんでした。未検証の状態は受け入れられませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការនាំចូលមិនអាចធ្វើឡើងដោយសុវត្ថិភាពទេ។ គ្មានរដ្ឋដែលមិនបានបញ្ជាក់ត្រូវបានទទួលយកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기를 안전하게 커밋할 수 없습니다. 확인되지 않은 상태는 허용되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importen kunne ikke utføres på en sikker måte. Ingen ubekreftet tilstand ble akseptert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można bezpiecznie zatwierdzić importu. Żaden niezweryfikowany stan nie został zaakceptowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação não pôde ser confirmada com segurança. Nenhum estado não verificado foi aceito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт не может быть безопасно совершен. Никакое непроверенное состояние не принималось."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถดำเนินการนำเข้าได้อย่างปลอดภัย ไม่ยอมรับสถานะที่ไม่ได้รับการยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İthalat güvenli bir şekilde gerçekleştirilemedi. Doğrulanmamış hiçbir durum kabul edilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося безпечно виконати імпорт. Жоден неперевірений стан не приймався."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全地进行导入。不接受任何未经验证的状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全地進行導入。不接受任何未經驗證的狀態。"
          }
        }
      }
    },
    "uniconnect.import.error.recoveryFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An interrupted import could not be recovered safely. The startup seed was not applied."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استرداد عملية الاستيراد التي تمت مقاطعتها بشكل آمن. لم يتم تطبيق بذرة بدء التشغيل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekinuti uvoz nije mogao biti siguran. Početno sjeme nije primijenjeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En afbrudt import kunne ikke gendannes sikkert. Startseedet blev ikke påført."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein unterbrochener Import konnte nicht sicher wiederhergestellt werden. Der Startup-Seed wurde nicht angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una importación interrumpida no se pudo recuperar de forma segura. No se aplicó la semilla de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une importation interrompue n'a pas pu être récupérée en toute sécurité. La graine de démarrage n’a pas été appliquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile ripristinare in modo sicuro un'importazione interrotta. Il seed di avvio non è stato applicato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断されたインポートを安全に回復できませんでした。スタートアップ シードが適用されませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការនាំចូលដែលរំខានមិនអាចយកមកវិញដោយសុវត្ថិភាពទេ។ គ្រាប់ពូជចាប់ផ្តើមមិនត្រូវបានអនុវត្តទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단된 가져오기를 안전하게 복구할 수 없습니다. 시작 시드가 적용되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En avbrutt import kunne ikke gjenopprettes trygt. Oppstartsfrøet ble ikke påført."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się bezpiecznie odzyskać przerwanego importu. Nie zastosowano materiału siewnego startowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma importação interrompida não pôde ser recuperada com segurança. A semente de inicialização não foi aplicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прерванный импорт не удалось безопасно восстановить. Начальное значение запуска не было применено."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำเข้าที่ถูกขัดจังหวะไม่สามารถกู้คืนได้อย่างปลอดภัย ไม่ได้ใช้เมล็ดเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesintiye uğrayan bir ithalat güvenli bir şekilde kurtarılamadı. Başlangıç ​​tohumu uygulanmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося безпечно відновити перерваний імпорт. Начальний код запуску не застосовано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中断的导入无法安全恢复。未应用启动种子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷的導入無法安全恢復。未套用啟動種子。"
          }
        }
      }
    },
    "uniconnect.import.error.remoteSessionsUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld declared existing tmux windows are unavailable. No remote session was created and no local changes were made."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld تم الإعلان عن وجود نوافذ tmux غير متوفرة. لم يتم إنشاء أي جلسة عمل عن بعد ولم يتم إجراء أية تغييرات محلية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld proglasio da su postojeći tmux prozori nedostupni. Nije kreirana nijedna udaljena sesija niti su napravljene lokalne promjene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld erklærede, at eksisterende tmux vinduer er utilgængelige. Der blev ikke oprettet nogen fjernsession, og der blev ikke foretaget lokale ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hat erklärt, dass vorhandene tmux Fenster nicht verfügbar sind. Es wurde keine Remote-Sitzung erstellt und es wurden keine lokalen Änderungen vorgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %lld ventanas tmux declaradas como existentes que no están disponibles. No se creó ninguna sesión remota ni se realizaron cambios locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld a déclaré que les fenêtres tmux existantes ne sont pas disponibles. Aucune session à distance n'a été créée et aucune modification locale n'a été apportée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre %lld dichiarate esistenti tmux non sono disponibili. Non è stata creata alcuna sessione remota e non sono state apportate modifiche locali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 宣言された既存の tmux ウィンドウは使用できません。リモート セッションは作成されず、ローカルでの変更も行われませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld បានប្រកាសថា បង្អួច tmux ដែលមានស្រាប់គឺមិនមានទេ។ គ្មានសម័យពីចម្ងាយត្រូវបានបង្កើត ហើយមិនមានការផ្លាស់ប្តូរក្នុងតំបន់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld은 기존 tmux 창을 사용할 수 없다고 선언했습니다. 원격 세션이 생성되지 않았고 로컬 변경도 이루어지지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld erklærte at eksisterende tmux vinduer er utilgjengelige. Ingen ekstern økt ble opprettet og ingen lokale endringer ble gjort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld zadeklarowano, że istniejące tmux okna są niedostępne. Nie utworzono sesji zdalnej ani nie wprowadzono żadnych zmian lokalnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld declarou que as janelas tmux existentes estão indisponíveis. Nenhuma sessão remota foi criada e nenhuma alteração local foi feita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld объявил существующие tmux окна недоступными. Удаленный сеанс не создавался и локальные изменения не вносились."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ประกาศว่า tmux windows ที่มีอยู่ไม่พร้อมใช้งาน ไม่มีการสร้างเซสชันระยะไกลและไม่มีการเปลี่ยนแปลงในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld, mevcut tmux pencerelerinin kullanılamadığını bildirdi. Hiçbir uzak oturum oluşturulmadı ve hiçbir yerel değişiklik yapılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld оголошено, що існуючі tmux вікна недоступні. Жодного віддаленого сеансу не створено та локальних змін не внесено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 声明现有的 tmux 窗口不可用。未创建远程会话，也未进行本地更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 聲明現有的 tmux 視窗不可用。未建立遠端會話，也未進行本機變更。"
          }
        }
      }
    },
    "uniconnect.import.error.rollbackFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import failed and its automatic rollback could not be verified. UniConnect kept the encrypted recovery checkpoint."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الاستيراد ولا يمكن التحقق من التراجع التلقائي. UniConnect احتفظ بنقطة تفتيش الاسترداد المشفرة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvoz nije uspio i njegovo automatsko vraćanje nije bilo moguće provjeriti. UniConnect zadržao je šifrovanu kontrolnu tačku za oporavak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importen mislykkedes, og dens automatiske tilbagerulning kunne ikke bekræftes. UniConnect beholdt det krypterede gendannelseskontrolpunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import ist fehlgeschlagen und das automatische Rollback konnte nicht überprüft werden. UniConnect hat den verschlüsselten Wiederherstellungskontrollpunkt beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación falló y no se pudo verificar su reversión automática. UniConnect mantuvo el punto de control de recuperación cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importation a échoué et sa restauration automatique n'a pas pu être vérifiée. UniConnect a conservé le point de contrôle de récupération chiffré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importazione non è riuscita e non è stato possibile verificarne il rollback automatico. UniConnect ha mantenuto il checkpoint di ripristino crittografato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートが失敗し、自動ロールバックを確認できませんでした。 UniConnect は暗号化された回復チェックポイントを保持しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការនាំចូលបានបរាជ័យ ហើយការវិលត្រឡប់មកវិញដោយស្វ័យប្រវត្តិរបស់វាមិនអាចផ្ទៀងផ្ទាត់បានទេ។ UniConnect បានរក្សាទុកចំណុចត្រួតពិនិត្យការសង្គ្រោះដែលបានអ៊ិនគ្រីប។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기에 실패했으며 자동 롤백을 확인할 수 없습니다. UniConnect은 암호화된 복구 체크포인트를 유지했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importen mislyktes, og dens automatiske tilbakeføring kunne ikke bekreftes. UniConnect beholdt det krypterte gjenopprettingssjekkpunktet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import nie powiódł się i nie można zweryfikować jego automatycznego wycofania. UniConnect zachował zaszyfrowany punkt kontrolny odzyskiwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação falhou e sua reversão automática não pôde ser verificada. UniConnect manteve o ponto de verificação de recuperação criptografado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт не удался, и его автоматический откат не удалось проверить. UniConnect сохранил зашифрованную контрольную точку восстановления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำเข้าล้มเหลวและไม่สามารถยืนยันการย้อนกลับอัตโนมัติได้ UniConnect เก็บจุดตรวจสอบการกู้คืนที่เข้ารหัสไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarma başarısız oldu ve otomatik geri alma işlemi doğrulanamadı. UniConnect şifreli kurtarma kontrol noktasını korudu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помилка імпорту, і не вдалося перевірити його автоматичний відкат. UniConnect зберігав зашифровану контрольну точку відновлення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入失败，无法验证其自动回滚。 UniConnect 保留加密恢复检查点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導入失敗，無法驗證其自動回滾。 UniConnect 保留加密復原檢查點。"
          }
        }
      }
    },
    "uniconnect.import.error.rolledBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import could not finish. UniConnect restored and verified the complete pre-import state."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إنهاء الاستيراد. تمت استعادة UniConnect والتحقق من حالة الاستيراد المسبق الكاملة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvoz nije mogao završiti. UniConnect vraćen i verificiran kompletno stanje prije uvoza."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importen kunne ikke afsluttes. UniConnect gendannet og verificeret den komplette præimporttilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import konnte nicht abgeschlossen werden. UniConnect hat den vollständigen Status vor dem Import wiederhergestellt und überprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación no pudo finalizar. UniConnect restauró y verificó el estado completo previo a la importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importation n'a pas pu se terminer. UniConnect a restauré et vérifié l'état complet de pré-importation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l'importazione. UniConnect ha ripristinato e verificato lo stato completo di pre-importazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートを完了できませんでした。 UniConnect は完全なインポート前の状態を復元して検証しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការនាំចូលមិនអាចបញ្ចប់បានទេ។ UniConnect បានស្ដារ និងផ្ទៀងផ្ទាត់ស្ថានភាពមុនពេលនាំចូលពេញលេញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기를 완료할 수 없습니다. UniConnect 전체 가져오기 전 상태를 복원하고 확인했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importen kunne ikke fullføres. UniConnect gjenopprettet og bekreftet den fullstendige tilstanden før import."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zakończyć importu. UniConnect przywrócono i zweryfikowano pełny stan sprzed importu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação não pôde ser concluída. UniConnect restaurou e verificou o estado completo de pré-importação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт не удалось завершить. UniConnect восстановил и проверил полное состояние перед импортом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การนำเข้าไม่สามารถเสร็จสิ้นได้ UniConnect กู้คืนและตรวจสอบสถานะก่อนนำเข้าโดยสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarma tamamlanamadı. UniConnect, içe aktarma öncesi durumun tamamını geri yükledi ve doğruladı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити імпорт. UniConnect відновлено та перевірено повний стан перед імпортом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入无法完成。 UniConnect 恢复并验证了完整的导入前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導入無法完成。 UniConnect 恢復並驗證了完整的導入前狀態。"
          }
        }
      }
    },
    "uniconnect.import.error.runtimeUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The protected import service is unavailable. No changes were made."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمة الاستيراد المحمية غير متوفرة. لم يتم إجراء أي تغييرات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Usluga zaštićenog uvoza nije dostupna. Nisu napravljene nikakve promjene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den beskyttede importtjeneste er ikke tilgængelig. Der blev ikke foretaget ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der geschützte Importdienst ist nicht verfügbar. Es wurden keine Änderungen vorgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de importación protegida no está disponible. No se realizaron cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d'importation protégée n'est pas disponible. Aucune modification n'a été apportée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio di importazione protetta non è disponibile. Non è stata apportata alcuna modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護されたインポート サービスは利用できません。変更は行われませんでした。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សេវាកម្មនាំចូលដែលត្រូវបានការពារគឺមិនមានទេ។ គ្មានការកែប្រែណាមួយត្រូវបានធ្វើឡើងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호된 가져오기 서비스를 사용할 수 없습니다. 변경사항이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den beskyttede importtjenesten er utilgjengelig. Ingen endringer ble gjort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa chronionego importu jest niedostępna. Nie wprowadzono żadnych zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de importação protegido não está disponível. Nenhuma alteração foi feita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба защищенного импорта недоступна. Никаких изменений не произошло."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการนำเข้าที่มีการป้องกันไม่พร้อมใช้งาน ไม่มีการเปลี่ยนแปลงใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korumalı içe aktarma hizmeti kullanılamıyor. Hiçbir değişiklik yapılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба захищеного імпорту недоступна. Жодних змін не внесено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受保护的导入服务不可用。没有进行任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受保護的導入服務不可用。沒有進行任何更改。"
          }
        }
      }
    },
    "uniconnect.import.issue.activeAgentWouldBeReplaced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This update would replace a different active agent owner. Leave it unselected and resolve the live session first."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحل هذا التحديث محل مالك وكيل نشط مختلف. اتركه بدون تحديد وقم بحل الجلسة المباشرة أولاً."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo ažuriranje bi zamijenilo drugog vlasnika aktivnog agenta. Ostavite ga neodabranim i prvo riješite sesiju uživo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne opdatering ville erstatte en anden aktiv agentejer. Lad det være umarkeret, og løs livesessionen først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Update würde einen anderen aktiven Agentenbesitzer ersetzen. Lassen Sie die Option deaktiviert und lösen Sie zuerst die Live-Sitzung auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta actualización reemplazaría al propietario de otro agente activo. Déjala sin seleccionar y resuelve primero la sesión activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette mise à jour remplacerait un autre propriétaire d'agent actif. Laissez-le désélectionné et résolvez d’abord la session en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo aggiornamento sostituirebbe un diverso proprietario dell'agente attivo. Lascialo deselezionato e risolvi prima la sessione live."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この更新により、別のアクティブなエージェントの所有者が置き換えられます。選択を解除したままにし、最初にライブ セッションを解決します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការអាប់ដេតនេះនឹងជំនួសម្ចាស់ភ្នាក់ងារសកម្មផ្សេង។ ទុកវាចោលដោយមិនជ្រើសរើស ហើយដោះស្រាយវគ្គបន្តផ្ទាល់ជាមុនសិន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 업데이트는 다른 활성 에이전트 소유자를 대체합니다. 선택하지 않은 상태로 두고 먼저 라이브 세션을 해결하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne oppdateringen ville erstatte en annen aktiv agenteier. La det være umarkert og løs live-økten først."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aktualizacja zastąpi innego właściciela aktywnego agenta. Pozostaw tę opcję niezaznaczoną i najpierw rozwiąż sesję na żywo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta atualização substituiria um proprietário de agente ativo diferente. Deixe-o desmarcado e resolva a sessão ao vivo primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это обновление заменит другого владельца активного агента. Оставьте его невыбранным и сначала разрешите сеанс в реальном времени."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอัปเดตนี้จะแทนที่เจ้าของตัวแทนที่ใช้งานอยู่รายอื่น ปล่อยให้ยกเลิกการเลือกและแก้ไขเซสชันสดก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu güncelleme, farklı bir aktif temsilci sahibinin yerini alacaktır. Bunu seçmeden bırakın ve önce canlı oturumu çözümleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це оновлення замінить іншого власника активного агента. Залиште його невибраним і спочатку розв’яжіть поточний сеанс."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此更新将替换不同的活跃代理所有者。不选择它并首先解决实时会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此更新將取代不同的活躍代理程式擁有者。不選擇它並首先解決即時會話。"
          }
        }
      }
    },
    "uniconnect.import.issue.duplicateAgentSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ session %2$@ appears more than once; only its first owner can resume it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ الجلسة %2$@ تظهر أكثر من مرة؛ يمكن لمالكها الأول فقط استئنافها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sesija %2$@ se pojavljuje više puta; samo njegov prvi vlasnik može ga nastaviti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ session %2$@ vises mere end én gang; kun dens første ejer kan genoptage den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Sitzung %2$@ erscheint mehr als einmal; Nur der erste Besitzer kann es wieder aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión %2$@ de %1$@ aparece más de una vez; solo su primer propietario puede reanudarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ la session %2$@ apparaît plus d'une fois ; seul son premier propriétaire peut le reprendre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione %1$@ %2$@ appare più di una volta; solo il suo primo proprietario può riprenderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ セッション %2$@ が複数回表示されます。最初の所有者だけがそれを再開できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ សម័យ %2$@ លេចឡើងច្រើនជាងមួយដង; មានតែម្ចាស់ដំបូងប៉ុណ្ណោះដែលអាចបន្តវាឡើងវិញបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 세션 %2$@이 두 번 이상 나타납니다. 첫 번째 소유자만 재개할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ økt %2$@ vises mer enn én gang; bare den første eieren kan gjenoppta den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sesja %2$@ pojawia się więcej niż jeden raz; tylko pierwszy właściciel może go wznowić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "sessão %1$@ %2$@ aparece mais de uma vez; apenas seu primeiro proprietário pode retomá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сеанс %2$@ появляется более одного раза; только его первый владелец может возобновить его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ เซสชัน %2$@ ปรากฏขึ้นมากกว่าหนึ่งครั้ง มีเพียงเจ้าของคนแรกเท่านั้นที่สามารถดำเนินการต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ oturumu birden fazla kez görünüyor; yalnızca ilk sahibi onu devam ettirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ сесія %2$@ з'являється більше одного разу; тільки його перший власник може відновити його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 会话 %2$@ 出现多次；只有它的第一个所有者才能恢复它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 會話 %2$@ 出現多次；只有它的第一個擁有者才能恢復它。"
          }
        }
      }
    },

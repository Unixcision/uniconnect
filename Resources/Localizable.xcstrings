    "browser.profile.automation.error.ambiguousProfile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple UniConnect browser profiles match '%@'. Use the profile ID instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' に一致する UniConnect ブラウザープロファイルが複数あります。代わりにプロファイル ID を使用してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطابق الملفات الشخصية المتعددة للمتصفح UniConnect مع '%@'.استخدم معرف ملف التعريف بدلاً من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Više UniConnect profila pretraživača odgovara '%@'. Umjesto toga koristite ID profila."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere UniConnect browserprofiler matcher '%@'. Brug i stedet profil-id'et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere UniConnect Browserprofile stimmen mit „%@“ überein. Verwenden Sie stattdessen die Profil-ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varios perfiles de navegador de UniConnect coinciden con «%@». Usa el identificador del perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs profils de navigateur UniConnect correspondent à « %@ ». Utilisez plutôt l’ID de profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più profili browser UniConnect corrispondono a '%@'. Utilizza invece l'ID del profilo."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ច្រើន UniConnect ទម្រង់កម្មវិធីរុករកតាមអ៊ីនធឺណិតត្រូវគ្នានឹង '%@' ។ប្រើលេខសម្គាល់ទម្រង់ជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 UniConnect 브라우저 프로필이 '%@'과(와) 일치합니다.대신 프로필 ID를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere UniConnect nettleserprofiler samsvarer med '%@'. Bruk profil-ID-en i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiele UniConnect profili przeglądarki pasuje do „%@”. Zamiast tego użyj identyfikatora profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vários perfis de navegador UniConnect correspondem a '%@'. Use o ID do perfil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько UniConnect профилей браузера соответствуют '%@'. Вместо этого используйте идентификатор профиля."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์เบราว์เซอร์ UniConnect หลายรายการตรงกับ '%@'ใช้รหัสโปรไฟล์แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden çok UniConnect tarayıcı profili '%@' ile eşleşiyor. Bunun yerine profil kimliğini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька профілів браузера UniConnect відповідають '%@. Натомість використовуйте ID профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个 UniConnect 浏览器配置文件与“%@”匹配。请改用配置文件 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多個 UniConnect 瀏覽器設定檔與「%@」相符。請改用設定檔 ID。"
          }
        }
      }
    },

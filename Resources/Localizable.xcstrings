    "bridge.cleanup.success.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect removed only its route files and Claude hook entries. Other hooks and remote tmux sessions were left unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect solo ha retirado sus ficheros de ruta y sus entradas de hooks de Claude. Los demás hooks y las sesiones tmux remotas no se han modificado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnectは自身のルートファイルとClaudeフック項目だけを削除しました。他のフックやリモートのtmuxセッションは変更していません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قام UniConnect بإزالة ملفات المسار وإدخالات ربط Claude فقط. تم ترك الخطافات الأخرى وجلسات tmux البعيدة دون تغيير."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect je uklonio samo svoje datoteke rute i Claude hook unose. Ostale kuke i udaljene tmux sesije su ostavljene nepromijenjene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect fjernede kun sine rutefiler og Claude hook-indgange. Andre hooks og eksterne tmux-sessioner blev efterladt uændrede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect hat nur seine Routendateien und Claude-Hook-Einträge entfernt. Andere Hooks und Remote-tmux-Sitzungen wurden unverändert gelassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect a supprimé uniquement ses fichiers de route et ses entrées de hook Claude. Les autres hooks et sessions tmux distantes sont restés inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ha rimosso solo i file di percorso e le voci di hook Claude. Gli altri hook e le sessioni tmux remote sono rimasti invariati."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect បានយកចេញតែឯកសារផ្លូវរបស់វា និងធាតុភ្ជាប់ Claude ប៉ុណ្ណោះ។ ទំពក់ផ្សេងទៀត និងវគ្គ tmux ពីចម្ងាយត្រូវបានទុកចោល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect는 경로 파일과 Claude 후크 항목만 제거했습니다. 다른 후크와 원격 tmux 세션은 변경되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect fjernet bare rutefilene og Claude krokoppføringer. Andre kroker og eksterne tmux-økter ble stående uendret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect usunął tylko pliki tras i wpisy haków Claude. Pozostałe hooki i zdalne sesje tmux pozostały niezmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect removeu apenas seus arquivos de rota e entradas de gancho Claude. Outros ganchos e sessões remotas tmux permaneceram inalterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect удалил только свои файлы маршрутов и записи обработчиков Claude. Другие перехватчики и удаленные сеансы tmux остались без изменений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ลบเฉพาะไฟล์เส้นทางและรายการ hook Claude hooks อื่นๆ และเซสชัน tmux ระยะไกลยังคงไม่เปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect yalnızca rota dosyalarını ve Claude kanca girişlerini kaldırdı. Diğer kancalar ve uzak tmux oturumları değişmeden kaldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect видалив лише свої файли маршрутів і записи підключень Claude. Інші хуки та віддалені сеанси tmux залишили без змін."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 仅删除了其路由文件和 Claude 挂钩条目。其他挂钩和远程 tmux 会话保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 僅刪除了其路由檔案和 Claude 掛鉤條目。其他掛鉤和遠端 tmux 會話保持不變。"
          }
        }
      }
    },
    "bridge.notification.completed.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {

    "sidebar.help.feedback.endpointError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback submission is not configured. Use Report an Issue in the Help menu instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تكوين إرسال الملاحظات.استخدم الإبلاغ عن مشكلة في قائمة المساعدة بدلاً من ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slanje povratnih informacija nije konfigurirano. Umjesto toga koristite Prijavi problem u meniju Pomoć."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedbackindsendelse er ikke konfigureret. Brug Rapporter et problem i menuen Hjælp i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übermittlung von Feedback ist nicht konfiguriert. Verwenden Sie stattdessen „Problem melden“ im Menü „Hilfe“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío de comentarios no está configurado. Usa «Informar de un problema» en el menú Ayuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi des commentaires n’est pas configuré. Utilisez plutôt Signaler un problème dans le menu Aide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invio del feedback non è configurato. Utilizza invece Segnala un problema nel menu Aiuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックの送信が構成されていません。代わりに、[ヘルプ] メニューの [問題の報告] を使用してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបញ្ជូនមតិត្រឡប់មិនត្រូវបានកំណត់រចនាសម្ព័ន្ធទេ។ប្រើរាយការណ៍បញ្ហានៅក្នុងម៉ឺនុយជំនួយជំនួសវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백 제출이 구성되지 않았습니다.대신 도움말 메뉴의 문제 보고를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakemelding er ikke konfigurert. Bruk Rapporter et problem i Hjelp-menyen i stedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesyłanie opinii nie jest skonfigurowane. Zamiast tego użyj opcji Zgłoś problem w menu Pomoc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio de feedback não está configurado. Use Reportar um problema no menu Ajuda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка отзывов не настроена. Вместо этого используйте «Сообщить о проблеме» в меню «Справка»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้กำหนดค่าการส่งคำติชมใช้รายงานปัญหาในเมนูวิธีใช้แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri bildirim gönderimi yapılandırılmadı. Bunun yerine Yardım menüsündeki Sorun Bildir'i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання відгуку не налаштовано. Замість цього скористайтеся пунктом «Повідомити про проблему» в меню «Довідка»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置反馈提交。请改用“帮助”菜单中的“报告问题”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置反饋提交。請改用「幫助」選單中的「回報問題」。"
          }
        }
      }
    },
    "sidebar.help.feedback.genericError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't send feedback. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックを送信できませんでした。もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося надіслати відгук. Спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백을 보내지 못했습니다. 다시 시도하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إرسال التعليقات.يرجى المحاولة مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće poslati povratne informacije. Molimo pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sende feedback. Prøv venligst igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte kein Feedback gesendet werden. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar comentarios. Por favor inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'envoyer des commentaires. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile inviare feedback. Per favore riprova."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ញើមតិកែលម្អបានទេ។សូមព្យាយាមម្តងទៀត។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sende tilbakemelding. Vennligst prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wysłać opinii. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar comentários. Por favor, tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить отзыв. Пожалуйста, попробуйте еще раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถส่งความคิดเห็นได้โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri bildirim gönderilemedi. Lütfen tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送反馈。请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法發送回饋。請再試一次。"
          }
        }
      }

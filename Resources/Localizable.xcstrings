    "claudeUpdate.error.noTargets": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على نافذة Claude يمكن التعرف عليها بأمان في هذا النطاق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U ovom opsegu nije pronađen nijedan bezbedno prepoznatljiv Claude prozor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet noget sikkert identificerbart Claude-vindue i dette omfang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Bereich wurde kein sicher identifizierbares Claude-Fenster gefunden."

    "uniconnect.import.windowAction.keepTerminalDuplicate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · keep as a normal terminal because the %2$@ session already has an owner"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · احتفظ به كمحطة عادية لأن جلسة %2$@ لها مالك بالفعل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · zadrži kao normalan terminal jer %2$@ sesija već ima vlasnika"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · behold som en normal terminal, fordi %2$@-sessionen allerede har en ejer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · Als normales Terminal beibehalten, da die Sitzung %2$@ bereits einen Besitzer hat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · mantener como terminal normal porque la sesión %2$@ ya tiene propietario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · conserver comme terminal normal car la session %2$@ a déjà un propriétaire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · mantenere come terminale normale perché la sessione %2$@ ha già un proprietario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ セッションにはすでに所有者がいるため、通常の端末として維持します"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · ទុកជាស្ថានីយធម្មតា ព្រោះវគ្គ %2$@ មានម្ចាស់រួចហើយ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ 세션에 이미 소유자가 있으므로 일반 터미널로 유지합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · behold som en vanlig terminal fordi %2$@-økten allerede har en eier"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · zachowaj zwykły terminal, ponieważ sesja %2$@ ma już właściciela"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · mantenha como um terminal normal porque a sessão %2$@ já tem dono"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · оставить как обычный терминал, поскольку у сеанса %2$@ уже есть владелец"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · เก็บไว้เป็นเทอร์มินัลปกติเนื่องจากเซสชัน %2$@ มีเจ้าของอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · normal bir terminal olarak tutun çünkü %2$@ oturumunun zaten bir sahibi var"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · залишити як звичайний термінал, оскільки %2$@ сесія вже має власника"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 保留为普通终端，因为 %2$@ 会话已经有所有者"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 保留為普通終端，因為 %2$@ 會話已經有所有者"
          }
        }
      }
    },

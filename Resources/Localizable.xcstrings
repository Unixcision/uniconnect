    "uniconnect.import.windowDestination.attachExistingTmux": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "read-only check, then attach existing tmux %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق للقراءة فقط، ثم قم بإرفاق tmux الموجود %@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "provjerite samo za čitanje, a zatim priložite postojeći tmux %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "skrivebeskyttet kontrol, og vedhæft derefter eksisterende tmux %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur-Lese-Prüfung, dann vorhandenes tmux %@ anhängen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "comprobar en modo de solo lectura y después conectar al tmux existente %@"
          }

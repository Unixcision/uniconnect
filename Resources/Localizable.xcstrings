          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld restaurado, %2$lld ainda precisa de atenção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld восстановлен, %2$lld все еще требует внимания."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืน %1$lld แล้ว แต่ %2$lld ยังคงต้องการการดูแล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld geri yüklendi, %2$lld'nun hâlâ ilgilenilmesi gerekiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld відновлено, %2$lld все ще потребує уваги."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 已恢复，%2$lld 仍需关注。"
          }
        },

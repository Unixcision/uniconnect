        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz teraz ponownie wszystkie okna terminala SSH"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte todas as janelas do terminal SSH agora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переподключите все окна терминала SSH сейчас."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อหน้าต่างเทอร์มินัล SSH ทั้งหมดอีกครั้งทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm SSH terminal pencerelerini şimdi yeniden bağlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно підключіть усі термінальні вікна SSH"
          }
        },
        "zh-Hans": {

    "dialog.closeAnchor.message.lone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this workspace will remove the group “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを閉じるとグループ「%@」が削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此工作区将删除分组「%@」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此工作區將移除群組「%@」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 닫으면 그룹 “%@”이(가) 삭제됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du diesen Arbeitsbereich schließt, wird die Gruppe „%@“ entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar este espacio de trabajo eliminará el grupo «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer cet espace de travail supprimera le groupe « %@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere quest’area di lavoro rimuoverà il gruppo «%@»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbejdsområde, fjernes gruppen “%@”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbeidsområdet, fjernes gruppen «%@»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie tej przestrzeni usunie grupę „%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытие этого рабочего пространства удалит группу «%@»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดเวิร์กสเปซนี้จะลบกลุ่ม “%@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma alanını kapatmak “%@” grubunu kaldıracak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриття цієї робочої області видалить групу «%@»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق مساحة العمل هذه سيحذف المجموعة «%@»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvaranje ovog radnog prostora ukloniti će grupu „%@“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar esta área de trabalho removerá o grupo “%@”."
          }
        }
      }
    },
    "dialog.closeAnchor.message.many": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this workspace will ungroup “%1$@” and release %2$lld other workspaces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースを閉じるとグループ「%1$@」が解除され、他の %2$lld 個のワークスペースが切り離されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此工作区将解散分组「%1$@」并释放另外 %2$lld 个工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此工作區將解散群組「%1$@」並釋出另外 %2$lld 個工作區。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간을 닫으면 그룹 “%1$@”이(가) 해제되고 다른 작업 공간 %2$lld개가 분리됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du diesen Arbeitsbereich schließt, wird die Gruppe „%1$@“ aufgelöst und %2$lld weitere Arbeitsbereiche werden freigegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar este espacio de trabajo desagrupará «%1$@» y liberará %2$lld espacios de trabajo más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer cet espace de travail dissociera « %1$@ » et libérera %2$lld autres espaces de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere quest’area di lavoro dividerà «%1$@» e libererà altre %2$lld aree di lavoro."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbejdsområde, opdeles “%1$@” og %2$lld andre arbejdsområder frigives."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette arbeidsområdet, oppløses «%1$@» og %2$lld andre arbeidsområder frigjøres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie tej przestrzeni rozgrupuje „%1$@” i uwolni %2$lld innych przestrzeni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытие этого рабочего пространства разгруппирует «%1$@» и освободит ещё %2$lld рабочих пространств."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดเวิร์กสเปซนี้จะเลิกจัดกลุ่ม “%1$@” และปล่อยอีก %2$lld เวิร์กสเปซ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu çalışma alanını kapatmak “%1$@” grubunu çözer ve %2$lld başka çalışma alanını serbest bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриття цієї робочої області розгрупує «%1$@» та звільнить ще %2$lld робочих областей."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إغلاق مساحة العمل هذه سيُلغي تجميع «%1$@» وسيُحرّر %2$lld مساحات عمل أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvaranje ovog radnog prostora razgrupisaće „%1$@“ i osloboditi %2$lld drugih radnih prostora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar esta área de trabalho desagrupará “%1$@” e liberará outras %2$lld áreas de trabalho."
          }
        }
      }
    },

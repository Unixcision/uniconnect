    "update.error.permissionError.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move UniConnect into Applications and relaunch to enable updates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを有効にするには、UniConnect を「アプリケーション」に移動して再起動してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 UniConnect 移到「应用程序」文件夹中，然后重新启动以启用更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將 UniConnect 移至「應用程式」資料夾並重新啟動，以啟用更新。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect를 응용 프로그램 폴더로 이동하고 재실행하여 업데이트를 활성화하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben Sie UniConnect in den Ordner 'Programme' und starten Sie die App neu, um Updates zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve UniConnect a Aplicaciones y vuelve a iniciarlo para activar las actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez UniConnect dans Applications et relancez pour activer les mises à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta UniConnect nella cartella Applicazioni e riavvia per abilitare gli aggiornamenti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt UniConnect til Programmer, og genstart for at aktivere opdateringer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś UniConnect do folderu Aplikacje i uruchom ponownie, aby włączyć aktualizacje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместите UniConnect в папку «Программы» и перезапустите для включения обновлений."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Premjestite UniConnect u Applications i ponovo pokrenite da biste omogućili ažuriranja."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقل UniConnect إلى مجلد التطبيقات وأعد التشغيل لتفعيل التحديثات."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt UniConnect til Programmer og start på nytt for å aktivere oppdateringer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o UniConnect para Aplicativos e reinicie para ativar as atualizações."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้าย UniConnect ไปที่โฟลเดอร์ Applications แล้วเปิดใหม่เพื่อเปิดใช้งานการอัปเดต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri etkinleştirmek için UniConnect'u Uygulamalar klasörüne taşıyıp yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістіть UniConnect до теки Програми та перезапустіть для увімкнення оновлень."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្លាស់ទី UniConnect ទៅក្នុងកម្មវិធី ហើយចាប់ផ្តើមឡើងវិញ ដើម្បីបើកដំណើរការបច្ចុប្បន្នភាព។"
          }
        }
      }
    },

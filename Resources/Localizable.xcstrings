          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótko migaj niebieskim konturem, gdy UniConnect podświetla okienko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisca brevemente um contorno azul quando UniConnect destaca um painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кратковременно замигайте синим контуром, когда UniConnect выделит панель."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กะพริบเส้นขอบสีน้ำเงินสั้นๆ เมื่อ UniConnect ไฮไลท์บานหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect bir bölmeyi vurguladığında kısa süreliğine mavi bir çerçeve yanıp söner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当UniConnect突出显示某个窗格时，蓝色轮廓会短暂闪烁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當UniConnect反白某個窗格時，藍色輪廓會短暫閃爍。"
          }
        }
      }
    },

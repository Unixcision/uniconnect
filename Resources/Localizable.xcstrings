          "stringUnit": {
            "state": "translated",
            "value": "تستمر صناديق SSH وجلسات tmux الخاصة بها في العمل أثناء قفل التطبيق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH kutije i njihove tmux sesije nastavljaju da rade dok je aplikacija zaključana."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-bokse og deres tmux-sessioner fortsætter med at køre, mens appen er låst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-Boxen und ihre tmux-Sitzungen laufen weiter, während die App gesperrt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cajas SSH y sus sesiones tmux siguen ejecutándose mientras la aplicación está bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boîtiers SSH et leurs sessions tmux continuent de fonctionner pendant que l'application est verrouillée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I box SSH e le relative sessioni tmux continuano a funzionare mentre l'app è bloccata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ボックスとその tmux セッションは、アプリがロックされている間も実行され続けます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រអប់ SSH និងវគ្គ tmux របស់ពួកគេបន្តដំណើរការខណៈពេលដែលកម្មវិធីត្រូវបានចាក់សោ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 상자와 해당 tmux 세션은 앱이 잠겨 있는 동안에도 계속 실행됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH-bokser og deres tmux-økter fortsetter å kjøre mens appen er låst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrzynki SSH i ich sesje tmux działają, gdy aplikacja jest zablokowana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As caixas SSH e suas sessões tmux continuam em execução enquanto o aplicativo está bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ящики SSH и их сеансы tmux продолжают работать, пока приложение заблокировано."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล่อง SSH และเซสชัน tmux ยังคงทำงานต่อไปในขณะที่แอปถูกล็อค"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH kutuları ve bunların tmux oturumları, uygulama kilitliyken çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блоки SSH і їхні сесії tmux продовжують працювати, поки додаток заблоковано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当应用程序锁定时，SSH 盒子及其 tmux 会话继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當應用程式鎖定時，SSH 盒子及其 tmux 會話繼續運行。"
          }
        }
      }
    },

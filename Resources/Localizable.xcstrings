    "settings.shortcuts.chords.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add tmux-style multi-step shortcuts in uniconnect.json, for example [\"ctrl+b\", \"c\"]."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "uniconnect.json で tmux 風の2段階ショートカットを追加できます。例: [\"ctrl+b\", \"c\"]。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "uniconnect.json에서 tmux 스타일의 다단계 단축키를 추가할 수 있습니다. 예: [\"ctrl+b\", \"c\"]."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف tmux اختصارات متعددة الخطوات على النمط uniconnect.json، على سبيل المثال [\"ctrl+b\", \"c\"]."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte prečice u više koraka u stilu tmux u uniconnect.json, na primjer [\"ctrl+b\", \"c\"]."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj tmux-stil genveje med flere trin i uniconnect.json, for eksempel [\"ctrl+b\", \"c\"]."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie mehrstufige Verknüpfungen im tmux-Stil in uniconnect.json hinzu, zum Beispiel [\"ctrl+b\", \"c\"]."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade atajos de varios pasos al estilo de tmux en uniconnect.json, por ejemplo [\"ctrl+b\", \"c\"]."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des raccourcis en plusieurs étapes de style tmux dans uniconnect.json, par exemple [\"ctrl+b\", \"c\"]."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi scorciatoie in più passaggi in stile tmux in uniconnect.json, ad esempio [\"ctrl+b\", \"c\"]."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ថែម tmux ផ្លូវកាត់ពហុជំហានរចនាប័ទ្មក្នុង uniconnect.json ឧទាហរណ៍ [\"ctrl+b\", \"c\"] ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til tmux-stil flertrinns snarveier i uniconnect.json, for eksempel [\"ctrl+b\", \"c\"]."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj wieloetapowe skróty w stylu tmux w uniconnect.json, na przykład [\"ctrl+b\", \"c\"]."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione atalhos de várias etapas no estilo tmux em uniconnect.json, por exemplo [\"ctrl+b\", \"c\"]."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте многошаговые ярлыки в стиле tmux в uniconnect.json, например [\"ctrl+b\", \"c\"]."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม tmux-สไตล์ทางลัดหลายขั้นตอนใน uniconnect.json เช่น [\"ctrl+b\", \"c\"]"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux tarzı çok adımlı kısayolları uniconnect.json'ye ekleyin, örneğin [\"ctrl+b\", \"c\"]."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте багатоетапні комбінації клавіш у стилі tmux у uniconnect.json, наприклад [\"ctrl+b\", \"c\"]."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在uniconnect.json中添加tmux样式的多步骤快捷方式，例如[\"ctrl+b\", \"c\"]。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在uniconnect.json中新增tmux樣式的多步驟捷徑，例如[\"ctrl+b\", \"c\"]。"
          }
        }
      }
    },

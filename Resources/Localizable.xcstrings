    "uniconnect.recovery.invalid.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف المحدد خارج أرشيف استرداد UniConnect أو تالف أو يستخدم تنسيقًا غير مدعوم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrana datoteka je izvan UniConnect arhive za oporavak, oštećena je ili koristi nepodržan format."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte fil ligger uden for UniConnects gendannelsesarkiv, er beskadiget eller bruger et ikke-understøttet format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Datei liegt außerhalb des UniConnect-Wiederherstellungsarchivs, ist beschädigt oder hat ein nicht unterstütztes Format."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file is outside UniConnect's recovery archive, damaged, or uses an unsupported format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo seleccionado está fuera del archivo de recuperación de UniConnect, está dañado o usa un formato no compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier sélectionné est hors de l’archive de récupération UniConnect, endommagé ou dans un format non pris en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file selezionato è fuori dall’archivio di ripristino di UniConnect, è danneggiato o usa un formato non supportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルはUniConnectの復元アーカイブ外にあるか、破損しているか、未対応の形式です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសារដែលបានជ្រើសនៅក្រៅបណ្ណសារស្ដារ UniConnect ខូច ឬប្រើទ្រង់ទ្រាយដែលមិនគាំទ្រ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일이 UniConnect 복구 보관함 외부에 있거나 손상되었거나 지원되지 않는 형식입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte filen er utenfor UniConnects gjenopprettingsarkiv, skadet eller bruker et format som ikke støttes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany plik jest poza archiwum odzyskiwania UniConnect, jest uszkodzony albo ma nieobsługiwany format."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo selecionado está fora do arquivo de recuperação do UniConnect, está danificado ou usa um formato não compatível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный файл находится вне архива восстановления UniConnect, повреждён или имеет неподдерживаемый формат."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่เลือกอยู่นอกคลังการกู้คืนของ UniConnect เสียหาย หรือใช้รูปแบบที่ไม่รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dosya UniConnect kurtarma arşivinin dışında, hasarlı veya desteklenmeyen bir biçimde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний файл перебуває поза архівом відновлення UniConnect, пошкоджений або має непідтримуваний формат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件不在 UniConnect 恢复存档内、已损坏或使用了不支持的格式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選檔案不在 UniConnect 復原封存內、已損毀或使用了不支援的格式。"
          }
        }
      }
    },

    "settings.betaFeatures.customSidebars.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides custom sidebars from the sidebar picker until you enable them here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで有効にするまで、カスタムサイドバーをサイドバーピッカーに表示しません。"
          }
        }
      }
    },
    "settings.betaFeatures.customSidebars.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists your sidebars from ~/.config/uniconnect/sidebars in the sidebar picker, rendered in an isolated helper process."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.config/uniconnect/sidebars のサイドバーをサイドバーピッカーに表示し、分離されたヘルパープロセスで描画します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسرد الأشرطة الجانبية الخاصة بك من ~/.config/uniconnect/sidebars في منتقي الشريط الجانبي، ويتم عرضها في عملية مساعدة معزولة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",

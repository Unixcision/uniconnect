    "cli.hooks.amp.error.notUniConnectPlugin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exists and is not a UniConnect plugin; leaving it alone"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ موجود وهو ليس ملحق UniConnect؛تركها وحدها"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ postoji i nije dodatak UniConnect; ostavljajući ga na miru"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eksisterer og er ikke et UniConnect plugin; lader den være i fred"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existiert und ist kein UniConnect-Plugin; es in Ruhe lassen"
          }

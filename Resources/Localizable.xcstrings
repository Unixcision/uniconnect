    "settings.browser.httpAllowlist.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls which HTTP (non-HTTPS) hosts can open in UniConnect without a warning prompt. Defaults include localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, and *.localtest.me."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告プロンプトなしでUniConnectで開けるHTTP（非HTTPS）ホストを制御します。デフォルトにはlocalhost、*.localhost、127.0.0.1、::1、0.0.0.0、*.localtest.meが含まれます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制哪些 HTTP（非 HTTPS）主机可以在 UniConnect 中打开而不显示警告提示。默认包括 localhost、*.localhost、127.0.0.1、::1、0.0.0.0 和 *.localtest.me。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制哪些 HTTP（非 HTTPS）主機可以在 UniConnect 中開啟而不顯示警告提示。預設包含 localhost、*.localhost、127.0.0.1、::1、0.0.0.0 和 *.localtest.me。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect에서 경고 없이 열 수 있는 HTTP(비HTTPS) 호스트를 제어합니다. 기본값에는 localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 및 *.localtest.me가 포함됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuert, welche HTTP-Hosts (nicht HTTPS) ohne Warnhinweis in UniConnect geöffnet werden können. Standardmäßig enthalten: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 und *.localtest.me."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla qué hosts HTTP (no HTTPS) pueden abrirse en UniConnect sin un mensaje de advertencia. Los valores predeterminados incluyen localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 y *.localtest.me."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle quels hôtes HTTP (non HTTPS) peuvent s'ouvrir dans UniConnect sans avertissement. Les valeurs par défaut incluent localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 et *.localtest.me."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla quali host HTTP (non HTTPS) possono aprirsi in UniConnect senza un avviso. I valori predefiniti includono localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 e *.localtest.me."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styrer hvilke HTTP-værter (ikke-HTTPS) der kan åbnes i UniConnect uden advarselsmeddelelse. Standardindstillinger inkluderer localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 og *.localtest.me."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Określa, które hosty HTTP (inne niż HTTPS) mogą być otwierane w UniConnect bez ostrzeżenia. Domyślnie uwzględniono localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 i *.localtest.me."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, какие HTTP (не HTTPS) хосты могут открываться в UniConnect без предупреждения. По умолчанию включены localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 и *.localtest.me."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroliše koji HTTP (ne-HTTPS) hostovi mogu biti otvoreni u UniConnect bez upozorenja. Podrazumijevani uključuju localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 i *.localtest.me."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم في مضيفي HTTP (غير HTTPS) الذين يمكنهم الفتح في UniConnect بدون رسالة تحذير. الافتراضيات تشمل localhost و *.localhost و 127.0.0.1 و ::1 و 0.0.0.0 و *.localtest.me."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Styrer hvilke HTTP-verter (ikke HTTPS) som kan åpnes i UniConnect uten advarselsmelding. Standardverdier inkluderer localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 og *.localtest.me."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla quais hosts HTTP (não HTTPS) podem abrir no UniConnect sem um aviso. Os padrões incluem localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 e *.localtest.me."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมว่าโฮสต์ HTTP (ไม่ใช่ HTTPS) ใดที่สามารถเปิดใน UniConnect โดยไม่ต้องแสดงคำเตือน ค่าเริ่มต้นรวมถึง localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 และ *.localtest.me"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi HTTP (HTTPS olmayan) ana bilgisayarlarının UniConnect'ta uyarı istemi olmadan açılabileceğini kontrol eder. Varsayılanlar localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 ve *.localtest.me içerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначає, які HTTP (не HTTPS) хости можуть відкриватися в UniConnect без попередження. Типово включає localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0 та *.localtest.me."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្រប់គ្រង HTTP (មិនមែនHTTPS) ម៉ាស៊ីនណាអាចបើកក្នុង UniConnect ដោយមិនមានការព្រមាន។លំនាំដើមរួមមាន localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, និង *.localtest.me ។"
          }
        }
      }
    },
    "settings.browser.httpAllowlist.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One host or wildcard per line (for example: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行に1つのホストまたはワイルドカード（例: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个主机或通配符（例如：localhost、*.localhost、127.0.0.1、::1、0.0.0.0、*.localtest.me）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一個主機或萬用字元（例如：localhost、*.localhost、127.0.0.1、::1、0.0.0.0、*.localtest.me）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 하나의 호스트 또는 와일드카드 (예: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Host oder Platzhalter pro Zeile (zum Beispiel: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un host o comodín por línea (por ejemplo: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hôte ou caractère générique par ligne (par exemple : localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un host o wildcard per riga (ad esempio: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én vært eller wildcard pr. linje (f.eks.: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden host lub wzorzec na wiersz (na przykład: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один хост или шаблон на строку (например: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan host ili zamjenski znak po redu (na primjer: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مضيف واحد أو حرف بدل لكل سطر (مثال: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én vert eller jokertegn per linje (for eksempel: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um host ou curinga por linha (por exemplo: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฮสต์หรือ wildcard หนึ่งรายการต่อบรรทัด (ตัวอย่าง: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır başına bir ana bilgisayar veya joker karakter (örneğin: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один хост або шаблон на рядок (наприклад: localhost, *.localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        }

          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold det eksisterende vinduet uendret"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj istniejące okno bez zmian"
          }
        },
        "pt-BR": {
          "stringUnit": {

    "notificationHook.failure.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification Hook Failed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知フックに失敗しました"
          }
        }
      }
    },
    "notificationHook.failure.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم UniConnect سلوك الإشعارات الافتراضي بسبب فشل '%@'."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect je koristio zadano ponašanje obavještenja jer '%@' nije uspio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect brugte standardmeddelelsesadfærd, fordi '%@' mislykkedes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect hat das Standardbenachrichtigungsverhalten verwendet, da „%@“ fehlgeschlagen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect used default notification behavior because '%@' failed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect usó el comportamiento de notificación predeterminado porque «%@» falló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect a utilisé le comportement de notification par défaut car '%@' a échoué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ha utilizzato il comportamento di notifica predefinito perché '%@' non è riuscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' が失敗したため、UniConnect は既定の通知動作を使用しました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnectបានប្រើឥរិយាបទជូនដំណឹងលំនាំដើម ដោយសារ '%@' បរាជ័យ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect는 '%@'이 실패했기 때문에 기본 알림 동작을 사용했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect brukte standard varslingsatferd fordi '%@' mislyktes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect użył domyślnego zachowania powiadamiania, ponieważ „%@” nie powiodło się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect usou comportamento de notificação padrão porque '%@' falhou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect использовал поведение уведомления по умолчанию, поскольку «%@» не удалось."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ใช้พฤติกรรมการแจ้งเตือนเริ่มต้นเนื่องจาก '%@' ล้มเหลว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect '%@' başarısız olduğundan varsayılan bildirim davranışını kullandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect використовував поведінку сповіщень за замовчуванням, оскільки «%@» не вдалося."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 使用默认通知行为，因为“%@”失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 使用預設通知行為，因為「%@」失敗。"
          }
        }
      }
    },

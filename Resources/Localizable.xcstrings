    "uniconnect.ssh.terminate.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This runs `tmux kill-session -t %@` on the server. The process inside it (Claude, logs, or anything else) will end and cannot be recovered. Closing the tab normally does NOT do this."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى تشغيل `tmux kill-session -t %@` على الخادم.ستنتهي العملية بداخله (Claude أو السجلات أو أي شيء آخر) ولا يمكن استعادتها.إغلاق علامة التبويب عادةً لا يؤدي إلى ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo se pokreće `tmux kill-session -t %@` na serveru. Proces unutar njega (Claude, evidencije ili bilo šta drugo) će se završiti i neće se moći oporaviti. Zatvaranje kartice obično to NE čini."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kører `tmux kill-session -t %@` på serveren. Processen inde i den (Claude, logfiler eller noget andet) slutter og kan ikke gendannes. At lukke fanen gør normalt IKKE dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies läuft `tmux kill-session -t %@` auf dem Server. Der darin enthaltene Prozess (Claude, Protokolle oder irgendetwas anderes) wird beendet und kann nicht wiederhergestellt werden. Das Schließen der Registerkarte führt normalerweise NICHT dazu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecutará `tmux kill-session -t %@` en el servidor. El proceso que haya dentro (Claude, registros o cualquier otra cosa) terminará y no se podrá recuperar. Cerrar la pestaña de la forma habitual NO hace esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela exécute `tmux kill-session -t %@` sur le serveur. Le processus qu'il contient (Claude, journaux ou toute autre chose) se terminera et ne pourra pas être récupéré. Normalement, la fermeture de l'onglet ne fait PAS cela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene eseguito `tmux kill-session -t %@` sul server. Il processo al suo interno (Claude, log o qualsiasi altra cosa) terminerà e non potrà essere recuperato. La chiusura della scheda normalmente NON fa questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、サーバー上で `tmux kill-session -t %@` が実行されます。その内部のプロセス (Claude、ログ、またはその他) が終了し、回復できなくなります。通常、タブを閉じてもこれは行われません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាដំណើរការ `tmux kill-session -t %@` នៅលើម៉ាស៊ីនមេ។ដំណើរការនៅក្នុងវា (Claude កំណត់ហេតុ ឬអ្វីផ្សេងទៀត) នឹងបញ្ចប់ ហើយមិនអាចយកមកវិញបានទេ។ការបិទផ្ទាំងជាធម្មតាមិនធ្វើបែបនេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이는 서버에서 `tmux kill-session -t %@`을 실행합니다.그 안의 프로세스(Claude, 로그 등)가 종료되며 복구할 수 없습니다.탭을 닫으면 일반적으로 이 작업이 수행되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kjører `tmux kill-session -t %@` på serveren. Prosessen inne i den (Claude, logger eller noe annet) vil avsluttes og kan ikke gjenopprettes. Å lukke fanen gjør normalt IKKE dette."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To działa `tmux kill-session -t %@` na serwerze. Proces w nim zawarty (Claude, logi lub cokolwiek innego) zakończy się i nie będzie można go odzyskać. Zamknięcie karty zwykle NIE powoduje tego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é executado `tmux kill-session -t %@` no servidor. O processo dentro dele (Claude, logs ou qualquer outra coisa) terminará e não poderá ser recuperado. Fechar a guia normalmente NÃO faz isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это запускается `tmux kill-session -t %@` на сервере. Процесс внутри него (Claude, журналы или что-то еще) завершится и не подлежит восстановлению. Закрытие вкладки обычно этого НЕ делает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งนี้รัน `tmux kill-session -t %@` บนเซิร์ฟเวอร์กระบวนการภายใน (Claude บันทึก หรือสิ่งอื่นใด) จะสิ้นสุดและไม่สามารถกู้คืนได้โดยปกติการปิดแท็บจะไม่เป็นเช่นนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, sunucuda `tmux kill-session -t %@` çalıştırır. İçindeki işlem (Claude, günlükler veya başka herhangi bir şey) sona erecek ve kurtarılamaz. Sekmeyi kapatmak normalde bunu yapmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це виконується `tmux kill-session -t %@` на сервері. Процес у ньому (Claude, журнали чи будь-що інше) завершиться й не може бути відновлено. Закриття вкладки зазвичай цього НЕ робить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这在服务器上运行`tmux kill-session -t %@`。其中的进程（Claude、日志或其他任何内容）将结束且无法恢复。关闭选项卡通常不会执行此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這在伺服器上運行`tmux kill-session -t %@`。其中的進程（Claude、日誌或其他任何內容）將結束且無法復原。關閉選項卡通常不會執行此操作。"
          }
        }
      }
    },

            "value": "%1$lld restauré, %2$lld nécessite encore une attention particulière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ripristinato, %2$lld necessita ancora di attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld は復元されましたが、%2$lld はまだ注意が必要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld បានស្ដារឡើងវិញ %2$lld នៅតែត្រូវការការយកចិត្តទុកដាក់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld가 복원되었지만 %2$lld에는 여전히 주의가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {

            "value": "Власні кольори"
          }
        }
      }
    },
    "settings.workspaceColors.customEntry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Named palette entry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前付きのパレット項目です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 지정된 팔레트 항목."
          }
        }
      }
    },
    "settings.workspaceColors.dictionaryNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit uniconnect.json to add or remove named colors. \"Choose Custom Color...\" still adds local Custom N entries."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前付きカラーの追加や削除は uniconnect.json を編集してください。「カスタムカラーを選択…」は引き続きローカルの Custom N エントリを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "uniconnect.json을 편집하여 이름이 지정된 색상을 추가하거나 제거하세요. \"사용자 지정 색상 선택...\"으로 로컬 Custom N 항목을 추가할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحرير uniconnect.json لإضافة الألوان المسماة أو إزالتها.لا يزال خيار \"اختيار لون مخصص...\" يضيف إدخالات N مخصصة محلية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uredite uniconnect.json da dodate ili uklonite imenovane boje.\"Odaberi prilagođenu boju...\" i dalje dodaje lokalne prilagođene N unose."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger uniconnect.json for at tilføje eller fjerne navngivne farver.\"Vælg brugerdefineret farve...\" tilføjer stadig lokale brugerdefinerede N-poster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeiten Sie uniconnect.json, um benannte Farben hinzuzufügen oder zu entfernen.„Benutzerdefinierte Farbe auswählen...“ fügt weiterhin lokale benutzerdefinierte N-Einträge hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita uniconnect.json para añadir o eliminar colores con nombre. «Elegir color personalizado…» seguirá añadiendo entradas personalizadas locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez uniconnect.json pour ajouter ou supprimer des couleurs nommées.\"Choisir une couleur personnalisée...\" ajoute toujours des entrées personnalisées N locales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica uniconnect.json per aggiungere o rimuovere i colori con nome.\"Scegli colore personalizzato...\" aggiunge comunque le voci N personalizzate locali."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កែសម្រួល uniconnect.json ដើម្បីបន្ថែម ឬលុបពណ៌ដែលមានឈ្មោះចេញ។\"ជ្រើសរើសពណ៌ផ្ទាល់ខ្លួន...\" នៅតែបន្ថែមធាតុ Custom N ក្នុងស្រុក។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger uniconnect.json for å legge til eller fjerne navngitte farger.\"Velg egendefinert farge...\" legger fortsatt til lokale egendefinerte N-oppføringer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj uniconnect.json, aby dodać lub usunąć nazwane kolory.„Wybierz kolor niestandardowy…” nadal dodaje lokalne wpisy niestandardowe N."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite uniconnect.json para adicionar ou remover cores nomeadas.\"Escolha a cor personalizada...\" ainda adiciona entradas N personalizadas locais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отредактируйте uniconnect.json, чтобы добавить или удалить именованные цвета.«Выбрать собственный цвет...» по-прежнему добавляет локальные записи «Пользовательский N»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไข uniconnect.json เพื่อเพิ่มหรือลบสีที่มีชื่อ\"เลือกสีที่กำหนดเอง...\" ยังคงเพิ่มรายการ Custom N ในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adlandırılmış renkleri eklemek veya kaldırmak için uniconnect.json öğesini düzenleyin.\"Özel Renk Seç...\" hâlâ yerel Özel N girişleri ekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відредагуйте uniconnect.json, щоб додати або видалити названі кольори.«Вибрати спеціальний колір...» усе ще додає локальні спеціальні N записи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑 uniconnect.json 以添加或删除命名颜色。“选择自定义颜色...”仍然添加本地自定义 N 条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯 uniconnect.json 以新增或刪除命名顏色。「選擇自訂顏色...」仍然會新增本機自訂 N 條目。"
          }
        }
      }
    },
    "settings.workspaceColors.emptyPalette": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No palette entries. Add colors in uniconnect.json or use \"Choose Custom Color...\" from a workspace context menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パレット項目はありません。uniconnect.json でカラーを追加するか、ワークスペースのコンテキストメニューから「カスタムカラーを選択…」を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔레트 항목이 없습니다. uniconnect.json에서 색상을 추가하거나 워크스페이스 컨텍스트 메뉴의 \"사용자 지정 색상 선택...\"을 사용하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إدخالات لوحة.أضف ألوانًا في uniconnect.json أو استخدم \"اختيار لون مخصص...\" من قائمة سياق مساحة العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema unosa u paleti. Dodajte boje u uniconnect.json ili koristite \"Odaberi prilagođenu boju...\" iz kontekstnog menija radnog prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen paletindtastninger. Tilføj farver i uniconnect.json eller brug \"Vælg brugerdefineret farve...\" fra en kontekstmenu på et arbejdsområde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Paletteneinträge. Fügen Sie Farben in uniconnect.json hinzu oder verwenden Sie „Benutzerdefinierte Farbe auswählen...“ aus einem Arbeitsbereich-Kontextmenü."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay colores en la paleta. Añádelos en uniconnect.json o usa «Elegir color personalizado…» en el menú contextual del espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée de palette. Ajoutez des couleurs dans uniconnect.json ou utilisez \"Choisir une couleur personnalisée...\" dans le menu contextuel d'un espace de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna voce nella tavolozza. Aggiungi colori in uniconnect.json o utilizza \"Scegli colore personalizzato...\" dal menu contestuale dell'area di lavoro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនមានធាតុក្ដារលាយទេ។បន្ថែមពណ៌នៅក្នុង uniconnect.json ឬប្រើ \"ជ្រើសរើសពណ៌ផ្ទាល់ខ្លួន...\" ពីម៉ឺនុយបរិបទកន្លែងធ្វើការ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen palettoppføringer. Legg til farger i uniconnect.json eller bruk \"Velg egendefinert farge...\" fra en kontekstmeny for arbeidsområdet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wpisów palety. Dodaj kolory w uniconnect.json lub użyj opcji „Wybierz kolor niestandardowy…” z menu kontekstowego obszaru roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma entrada de paleta. Adicione cores em uniconnect.json ou use \"Escolher cor personalizada...\" no menu de contexto da área de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет записей в палитре. Добавьте цвета в поле uniconnect.json или используйте «Выбрать собственный цвет...» в контекстном меню рабочей области."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายการจานสีเพิ่มสีใน uniconnect.json หรือใช้ \"เลือกสีที่กำหนดเอง...\" จากเมนูบริบทของพื้นที่ทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Palet girişi yok.uniconnect.json ile renkleri ekleyin veya çalışma alanı içerik menüsünden \"Özel Renk Seç...\" seçeneğini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає записів палітри. Додайте кольори в uniconnect.json або скористайтеся функцією «Вибрати спеціальний колір...» у контекстному меню робочої області."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有调色板条目。在 uniconnect.json 中添加颜色或使用工作区上下文菜单中的“选择自定义颜色...”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有調色板條目。在 uniconnect.json 中新增顏色或使用工作區上下文選單中的「選擇自訂顏色...」。"
          }
        }
      }
    },

    "uniconnect.recovery.open.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر إحدى لقطات الاسترداد التلقائية. ستظل نوافذك الحالية مفتوحة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite jedan od automatskih snimaka za oporavak. Vaši trenutni prozori ostat će otvoreni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et af de automatiske gendannelsesøjebliksbilleder. Dine nuværende vinduer forbliver åbne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen automatischen Wiederherstellungspunkt. Ihre aktuellen Fenster bleiben geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one of the automatic recovery snapshots. Your current windows will remain open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una de las instantáneas automáticas de recuperación. Tus ventanas actuales seguirán abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un instantané de récupération automatique. Vos fenêtres actuelles resteront ouvertes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un’istantanea di ripristino automatico. Le finestre correnti rimarranno aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動復元スナップショットを選択してください。現在のウインドウは開いたままになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរើសរូបថតស្ដារស្វ័យប្រវត្តិមួយ។ បង្អួចបច្ចុប្បន្នរបស់អ្នកនឹងនៅបើក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 복구 스냅샷을 선택하세요. 현재 윈도우는 열린 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et automatisk gjenopprettingspunkt. De nåværende vinduene forblir åpne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz automatyczny punkt odzyskiwania. Bieżące okna pozostaną otwarte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um snapshot de recuperação automática. As janelas atuais permanecerão abertas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите автоматическую точку восстановления. Текущие окна останутся открытыми."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสแนปช็อตการกู้คืนอัตโนมัติ หน้าต่างปัจจุบันจะยังคงเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik kurtarma anlık görüntülerinden birini seçin. Mevcut pencereleriniz açık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть автоматичну точку відновлення. Поточні вікна залишаться відкритими."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一个自动恢复快照。当前窗口将保持打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一個自動復原快照。目前視窗將保持開啟。"
          }
        }
      }
    },

    "uniconnect.migration.readFailed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cmux session could not be read. cmux was not modified."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قراءة جلسة cmux.لم يتم تعديل cmux."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmux sesija nije mogla biti pročitana.cmux nije izmijenjen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-sessionen kunne ikke læses.cmux blev ikke ændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die cmux-Sitzung konnte nicht gelesen werden.cmux wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la sesión de cmux. cmux no se modificó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session cmux n'a pas pu être lue.cmux n'a pas été modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la sessione cmux.cmux non è stato modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux セッションを読み取れませんでした。cmux は変更されていません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សម័យ cmux មិនអាចអានបានទេ។cmux មិនត្រូវបានកែប្រែទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux 세션을 읽을 수 없습니다.cmux가 수정되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux-økten kunne ikke leses.cmux ble ikke endret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać sesji cmux.cmux nie został zmodyfikowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão cmux não pôde ser lida.cmux não foi modificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать сеанс cmux.cmux не был изменен."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอ่านเซสชัน cmux ได้cmux ไม่ได้ถูกแก้ไข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmux oturumu okunamadı.cmux değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати сеанс cmux.cmux не було змінено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

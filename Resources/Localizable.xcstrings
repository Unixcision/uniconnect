    "uniconnect.ssh.window.invalidConnection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved SSH connection is invalid. Edit the box connection before opening this window."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتصال المحفوظ SSH غير صالح.قم بتحرير اتصال الصندوق قبل فتح هذه النافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljena veza SSH je nevažeća. Uredite vezu kutije prije otvaranja ovog prozora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gemte SSH forbindelse er ugyldig. Rediger boksforbindelsen, før du åbner dette vindue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Verbindung SSH ist ungültig. Bearbeiten Sie die Box-Verbindung, bevor Sie dieses Fenster öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión SSH guardada no es válida. Edita la conexión de la caja antes de abrir esta ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion enregistrée SSH n'est pas valide. Modifiez la connexion de la boîte avant d'ouvrir cette fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione salvata SSH non è valida. Modifica la connessione del box prima di aprire questa finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された SSH 接続は無効です。このウィンドウを開く前にボックス接続を編集してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការតភ្ជាប់ SSH ដែលបានរក្សាទុកមិនត្រឹមត្រូវទេ។កែសម្រួលការភ្ជាប់ប្រអប់ មុនពេលបើកបង្អួចនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 SSH 연결이 잘못되었습니다.이 창을 열기 전에 상자 연결을 편집하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lagrede SSH tilkoblingen er ugyldig. Rediger bokstilkoblingen før du åpner dette vinduet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane połączenie SSH jest nieprawidłowe. Edytuj połączenie skrzynki przed otwarciem tego okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão SSH salva é inválida. Edite a conexão da caixa antes de abrir esta janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраненное соединение SSH недействительно. Отредактируйте подключение коробки, прежде чем открывать это окно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อ SSH ที่บันทึกไว้ไม่ถูกต้องแก้ไขการเชื่อมต่อกล่องก่อนเปิดหน้าต่างนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen SSH bağlantısı geçersiz. Bu pencereyi açmadan önce kutu bağlantısını düzenleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережене підключення SSH недійсне. Відредагуйте підключення коробки, перш ніж відкривати це вікно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的SSH连接无效。在打开此窗口之前编辑盒子连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的SSH連線無效。在打開此視窗之前編輯盒子連接。"
          }
        }
      }
    },
    "uniconnect.ssh.window.restoreDuplicate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved SSH/tmux window was not attached because the same remote target is already open. Close the other owner, then reconnect this window."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إرفاق نافذة SSH/tmux المحفوظة لأن نفس الهدف البعيد مفتوح بالفعل.أغلق المالك الآخر، ثم أعد توصيل هذه النافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj spremljeni SSH/tmux prozor nije priključen jer je isti udaljeni cilj već otvoren. Zatvorite drugog vlasnika, a zatim ponovo povežite ovaj prozor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette gemte SSH/tmux vindue blev ikke vedhæftet, fordi det samme fjernmål allerede er åbent. Luk den anden ejer, og tilslut derefter dette vindue igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses gespeicherte Fenster SSH/tmux wurde nicht angehängt, da das gleiche Remote-Ziel bereits geöffnet ist. Schließen Sie den anderen Eigentümer und verbinden Sie dieses Fenster erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ventana SSH/tmux guardada no se conectó porque el mismo destino remoto ya está abierto. Cierra la otra ventana que lo usa y vuelve a conectar esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fenêtre enregistrée SSH/tmux n'a pas été jointe car la même cible distante est déjà ouverte. Fermez l'autre propriétaire, puis reconnectez cette fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa finestra salvata SSH/tmux non è stata allegata perché la stessa destinazione remota è già aperta. Chiudi l'altro proprietario, quindi ricollega questa finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じリモート ターゲットがすでに開いているため、この保存された SSH/tmux ウィンドウは接続されませんでした。他の所有者を閉じてから、このウィンドウを再接続します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្អួចដែលបានរក្សាទុក SSH/tmux បង្អួចមិនត្រូវបានភ្ជាប់ទេ ដោយសារគោលដៅពីចម្ងាយដូចគ្នាត្រូវបានបើករួចហើយ។បិទម្ចាស់ផ្សេងទៀត បន្ទាប់មកភ្ជាប់បង្អួចនេះឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 원격 대상이 이미 열려 있기 때문에 저장된 SSH/tmux 창이 연결되지 않았습니다.다른 소유자를 닫은 후 이 창을 다시 연결하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette lagrede SSH/tmux vinduet ble ikke vedlagt fordi det samme eksterne målet allerede er åpent. Lukk den andre eieren, og koble deretter til dette vinduet igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zapisane okno SSH/tmux nie zostało dołączone, ponieważ ten sam zdalny cel jest już otwarty. Zamknij drugiego właściciela, a następnie podłącz ponownie to okno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta janela SSH/tmux salva não foi anexada porque o mesmo destino remoto já está aberto. Feche o outro proprietário e reconecte esta janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сохраненное окно SSH/tmux не было прикреплено, поскольку тот же удаленный объект уже открыт. Закройте другого владельца, затем снова подключите это окно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่าง SSH/tmux ที่บันทึกไว้นี้ไม่ได้แนบมาเนื่องจากเป้าหมายระยะไกลเดียวกันเปิดอยู่แล้วปิดเจ้าของรายอื่น จากนั้นเชื่อมต่อหน้าต่างนี้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaydedilen SSH/tmux penceresi eklenmedi çünkü aynı uzak hedef zaten açık. Diğer sahibi kapatın ve ardından bu pencereyi yeniden bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це збережене вікно SSH/tmux не було прикріплено, оскільки той самий віддалений ціль уже відкритий. Закрийте іншого власника, а потім повторно підключіть це вікно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未附加此保存的 SSH/tmux 窗口，因为相同的远程目标已打开。关闭其他所有者，然后重新连接此窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未附加此保存的 SSH/tmux 窗口，因為相同的遠端目標已開啟。關閉其他所有者，然後重新連接此視窗。"
          }
        }
      }
    },

        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abierto"
          }
        },
        "fr": {
          "stringUnit": {

    "update.error.feedDownload.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect couldn't download the update feed. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect はアップデートフィードをダウンロードできませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 无法下载更新源。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 無法下載更新來源。請檢查您的連線後再試一次。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect에서 업데이트 피드를 다운로드할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect konnte den Update-Feed nicht herunterladen. Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no pudo descargar la fuente de actualizaciones. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect n'a pas pu télécharger le flux de mises à jour. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non è riuscito a scaricare il feed degli aggiornamenti. Controlla la connessione e riprova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke downloade opdateringsfeedet. Kontroller din forbindelse, og prøv igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie mógł pobrać kanału aktualizacji. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не удалось загрузить канал обновлений. Проверьте подключение и повторите попытку."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nije mogao preuzeti feed ažuriranja. Provjerite vezu i pokušajte ponovo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على UniConnect تنزيل موجز التحديثات. تحقق من اتصالك وحاول مجددًا."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke laste ned oppdateringsfeeden. Kontroller tilkoblingen og prøv igjen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O UniConnect não conseguiu baixar o feed de atualização. Verifique sua conexão e tente novamente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่สามารถดาวน์โหลดฟีดอัปเดตได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"

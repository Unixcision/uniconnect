    "settings.app.telemetry.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share anonymized crash and usage data to help improve UniConnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnectの改善に役立てるため、匿名化されたクラッシュおよび使用状況データを共有します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享匿名的崩溃和使用数据，帮助改进 UniConnect。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享匿名的當機與使用資料，以協助改善 UniConnect。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 개선을 위해 익명화된 충돌 및 사용 데이터를 공유합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymisierte Absturz- und Nutzungsdaten teilen, um UniConnect zu verbessern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir datos anónimos de fallos y uso para ayudar a mejorar UniConnect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager des données anonymisées de plantage et d'utilisation pour aider à améliorer UniConnect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi dati anonimi su arresti anomali e utilizzo per migliorare UniConnect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del anonymiserede nedbrud- og brugsdata for at hjælpe med at forbedre UniConnect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępniaj zanonimizowane dane o awariach i użyciu, aby pomóc ulepszyć UniConnect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делиться анонимными данными о сбоях и использовании для улучшения UniConnect."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijelite anonimizirane podatke o padovima i korištenju kako biste pomogli u poboljšanju UniConnect."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشاركة بيانات الأعطال والاستخدام المجهولة للمساعدة في تحسين UniConnect."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del anonymiserte krasj- og bruksdata for å bidra til å forbedre UniConnect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhar dados anonimizados de falhas e uso para ajudar a melhorar o UniConnect."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ข้อมูลการขัดข้องและการใช้งานแบบไม่ระบุตัวตนเพื่อช่วยปรับปรุง UniConnect"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect'u iyileştirmek için anonimleştirilmiş çökme ve kullanım verilerini paylaş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилати анонімні дані про збої та використання для покращення UniConnect."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចែករំលែកទិន្នន័យគាំង និងការប្រើប្រាស់អនាមិក ដើម្បីជួយកែលម្អ UniConnect ។"
          }
        }
      }
    },

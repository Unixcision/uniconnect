    "uniconnect.ssh.setup.installDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect will install the tmux package with the system package manager (apt, dnf, yum, apk, pacman, zypper, or brew). It will not change anything else."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيقوم UniConnect بتثبيت حزمة tmux مع مدير حزم النظام (apt أو dnf أو yum أو apk أو pacman أو zypper أو brew). ولن يغير أي شيء آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect će instalirati paket tmux pomoću sistemskog upravitelja paketa (apt, dnf, yum, apk, pacman, zypper ili brew). Neće promijeniti ništa drugo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect installerer tmux-pakken med systempakkehåndteringen (apt, dnf, yum, apk, pacman, zypper eller brew). Det vil ikke ændre på andet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect installiert das tmux-Paket mit dem Systempaketmanager (apt, dnf, yum, apk, pacman, zypper oder brew). Es wird nichts anderes ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect instalará el paquete tmux con el administrador de paquetes del sistema (apt, dnf, yum, apk, pacman, zypper o brew). No cambiará nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect installera le package tmux avec le gestionnaire de packages système (apt, dnf, yum, apk, pacman, zypper ou brew). Cela ne changera rien d’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect installerà il pacchetto tmux con il gestore pacchetti di sistema (apt, dnf, yum, apk, pacman, zypper o brew). Non cambierà nient'altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect は、システム パッケージ マネージャー (apt、dnf、yum、apk、pacman、zypper、または brew) を使用して tmux パッケージをインストールします。それ以外は何も変わりません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect នឹងដំឡើងកញ្ចប់ tmux ជាមួយនឹងកម្មវិធីគ្រប់គ្រងកញ្ចប់ប្រព័ន្ធ (apt, dnf, yum, apk, pacman, zypper, ឬ brew)។ វានឹងមិនផ្លាស់ប្តូរអ្វីផ្សេងទៀតទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect는 시스템 패키지 관리자(apt, dnf, yum, apk, pacman, zypper 또는 brew)를 사용하여 tmux 패키지를 설치합니다. 다른 것은 변경되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect vil installere tmux-pakken med systempakkebehandleren (apt, dnf, yum, apk, pacman, zypper eller brew). Det vil ikke endre noe annet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect zainstaluje pakiet tmux za pomocą menedżera pakietów systemowych (apt, dnf, yum, apk, pacman, zypper lub brew). To nie zmieni niczego innego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect instalará o pacote tmux com o gerenciador de pacotes do sistema (apt, dnf, yum, apk, pacman, zypper ou brew). Não mudará mais nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect установит пакет tmux с помощью системного менеджера пакетов (apt, dnf, yum, apk, pacman, zypper или brew). Больше ничего не изменится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect จะติดตั้งแพ็คเกจ tmux พร้อมด้วยตัวจัดการแพ็คเกจระบบ (apt, dnf, yum, apk, pacman, zypper หรือ brew) มันจะไม่เปลี่ยนแปลงสิ่งอื่นใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect, tmux paketini sistem paketi yöneticisiyle (apt, dnf, yum, apk, pacman, zypper veya brew) yükleyecektir. Başka hiçbir şeyi değiştirmeyecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect встановить пакет tmux із системним менеджером пакетів (apt, dnf, yum, apk, pacman, zypper або brew). Більше нічого це не змінить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 将使用系统包管理器（apt、dnf、yum、apk、pacman、zypper 或 brew）安装 tmux 包。它不会改变任何其他事情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 將使用系統套件管理器（apt、dnf、yum、apk、pacman、zypper 或 brew）安裝 tmux 套件，不會變更任何其他內容。"
          }
        }
      }
    },

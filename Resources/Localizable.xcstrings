    "uniconnect.export.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file includes SSH commands (and their passwords). It is encrypted with AES-256-GCM and a key derived from this password; it cannot be opened without it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن الملف أوامر SSH (وكلمات المرور الخاصة بها). وهو مشفر باستخدام AES-256-GCM ومفتاح مشتق من كلمة المرور هذه؛ولا يمكن فتحه بدونه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka uključuje naredbe SSH (i njihove lozinke). Šifriran je sa AES-256-GCM i ključem izvedenim iz ove lozinke;ne može se otvoriti bez toga."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen indeholder SSH kommandoer (og deres adgangskoder). Den er krypteret med AES-256-GCM og en nøgle afledt af denne adgangskode;den kan ikke åbnes uden den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei enthält SSH Befehle (und ihre Passwörter). Es ist mit AES-256-GCM und einem von diesem Passwort abgeleiteten Schlüssel verschlüsselt.ohne kann es nicht geöffnet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo incluye comandos SSH y sus contraseñas. Está cifrado con AES-256-GCM y una clave derivada de esta contraseña; sin ella no se puede abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier comprend les commandes SSH (et leurs mots de passe). Il est crypté avec AES-256-GCM et une clé dérivée de ce mot de passe ;il ne peut pas être ouvert sans lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file include i comandi SSH (e le relative password). È crittografato con AES-256-GCM e una chiave derivata da questa password;non può essere aperto senza di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには SSH コマンド (およびそのパスワード) が含まれています。これは、AES-256-GCM とこのパスワードから派生したキーで暗号化されます。それなしでは開けられません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឯកសាររួមបញ្ចូលពាក្យបញ្ជា SSH (និងពាក្យសម្ងាត់របស់ពួកគេ)។វាត្រូវបានអ៊ិនគ្រីបជាមួយ AES-256-GCM និងសោដែលបានមកពីពាក្យសម្ងាត់នេះ។វាមិនអាចត្រូវបានបើកដោយគ្មានវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에는 SSH 명령(및 해당 비밀번호)이 포함되어 있습니다. AES-256-GCM과 이 비밀번호에서 파생된 키로 암호화됩니다.그것 없이는 열 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen inneholder SSH kommandoer (og deres passord). Den er kryptert med AES-256-GCM og en nøkkel hentet fra dette passordet;den kan ikke åpnes uten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zawiera SSH komendy (i ich hasła). Jest szyfrowane za pomocą AES-256-GCM i klucza pochodzącego z tego hasła;bez niego nie da się go otworzyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo inclui comandos SSH (e suas senhas). É criptografado com AES-256-GCM e uma chave derivada desta senha;não pode ser aberto sem ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл содержит команды SSH (и их пароли). Он зашифрован с помощью AES-256-GCM и ключа, полученного на основе этого пароля;без него его невозможно открыть."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ประกอบด้วยคำสั่ง SSH (และรหัสผ่าน)มันถูกเข้ารหัสด้วย AES-256-GCM และคีย์ที่ได้มาจากรหัสผ่านนี้ไม่สามารถเปิดได้หากไม่มีมัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya SSH komutlarını (ve bunların şifrelerini) içerir. AES-256-GCM ve bu şifreden türetilen bir anahtar ile şifrelenir;onsuz açılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл містить команди SSH (і їх паролі). Він зашифрований за допомогою AES-256-GCM і ключа, отриманого з цього пароля;його неможливо відкрити без нього."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件包含 SSH 命令（及其密码）。它使用 AES-256-GCM 和从此密码派生的密钥进行加密；没有它就无法打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該檔案包含 SSH 指令（及其密碼）。它使用 AES-256-GCM 和從此密碼派生的金鑰進行加密；沒有它就無法開啟。"
          }
        }
      }
    },

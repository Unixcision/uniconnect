    "cli.hooks.kiro.postInstallNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro applies these hooks only when run as the UniConnect agent. Start Kiro with `kiro-cli chat --agent uniconnect`, or make it the default with `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم Kiro بتطبيق hooks هذه فقط عند تشغيله كـ UniConnect agent.ابدأ تشغيل Kiro باستخدام `kiro-cli chat --agent uniconnect`، أو اجعله الإعداد الافتراضي باستخدام `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro primjenjuje ove hooks samo kada se izvodi kao UniConnect agent. Započnite Kiro sa `kiro-cli chat --agent uniconnect` ili ga postavite kao zadano sa `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro anvender kun disse hooks, når de køres som UniConnect agent. Start Kiro med `kiro-cli chat --agent uniconnect`, eller gør den til standard med `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro wendet diese hooks nur an, wenn es als UniConnect agent ausgeführt wird. Starten Sie Kiro mit `kiro-cli chat --agent uniconnect` oder legen Sie es mit `kiro-cli settings chat.defaultAgent uniconnect` als Standard fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro aplica estos hooks solo cuando se ejecuta como UniConnect agent. Inicie Kiro con `kiro-cli chat --agent uniconnect` o configúrelo como predeterminado con `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro applique ces hooks uniquement lorsqu'ils sont exécutés en tant que UniConnect agent. Démarrez Kiro avec `kiro-cli chat --agent uniconnect` ou définissez-le par défaut avec `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro applica questi hooks solo quando eseguito come UniConnect agent. Avvia Kiro con `kiro-cli chat --agent uniconnect` o impostalo come predefinito con `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro は、UniConnect agent として実行される場合にのみ、これらの hooks を適用します。`kiro-cli chat --agent uniconnect` で Kiro を開始するか、`kiro-cli settings chat.defaultAgent uniconnect` でデフォルトにします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro អនុវត្ត hooks ទាំងនេះតែនៅពេលដំណើរការជា UniConnect agent ប៉ុណ្ណោះ។ចាប់ផ្តើម Kiro ជាមួយ `kiro-cli chat --agent uniconnect` ឬធ្វើឱ្យវាជាលំនាំដើមជាមួយ `kiro-cli settings chat.defaultAgent uniconnect` ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro는 UniConnect agent로 실행되는 경우에만 이러한 hooks를 적용합니다.`kiro-cli chat --agent uniconnect`로 Kiro를 시작하거나 `kiro-cli settings chat.defaultAgent uniconnect`로 기본값으로 설정하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro bruker disse hooks bare når de kjøres som UniConnect agent. Start Kiro med `kiro-cli chat --agent uniconnect`, eller gjør den til standard med `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro stosuje te hooks tylko wtedy, gdy działa jako UniConnect agent. Uruchom Kiro za pomocą `kiro-cli chat --agent uniconnect` lub ustaw go jako domyślny za pomocą `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro aplica estes hooks somente quando executado como UniConnect agent. Inicie Kiro com `kiro-cli chat --agent uniconnect` ou torne-o padrão com `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro применяет эти hooks только при запуске как UniConnect agent. Запустите Kiro с помощью `kiro-cli chat --agent uniconnect` или сделайте его значением по умолчанию с помощью `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro ใช้ hooks เหล่านี้เมื่อรันเป็น UniConnect agent เท่านั้นเริ่ม Kiro ด้วย `kiro-cli chat --agent uniconnect` หรือกำหนดให้เป็นค่าเริ่มต้นด้วย `kiro-cli settings chat.defaultAgent uniconnect`"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro, bu hooks'yi yalnızca UniConnect agent olarak çalıştırıldığında uygular. Kiro'yi `kiro-cli chat --agent uniconnect` ile başlatın veya `kiro-cli settings chat.defaultAgent uniconnect` ile varsayılan yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro застосовує ці hooks лише під час запуску як UniConnect agent. Запустіть Kiro з `kiro-cli chat --agent uniconnect` або зробіть його типовим за допомогою `kiro-cli settings chat.defaultAgent uniconnect`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro 仅当作为 UniConnect agent 运行时才应用这些 hooks。使用 `kiro-cli chat --agent uniconnect` 启动 Kiro，或使用 `kiro-cli settings chat.defaultAgent uniconnect` 将其设置为默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro 僅當作為 UniConnect agent 運行時才應用這些 hooks。使用 `kiro-cli chat --agent uniconnect` 啟動 Kiro，或使用 `kiro-cli settings chat.defaultAgent uniconnect` 將其設定為預設值。"
          }
        }
      }
    },
    "settings.automation.kiro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro CLI Integration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro CLI連携"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiro CLI 연동"
          }
        }
      }
    },
    "settings.automation.kiro.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks must be installed with `cmux hooks kiro install`, then run Kiro with `kiro-cli chat --agent uniconnect` (or set it as your default agent). They no-op outside UniConnect terminals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックは`cmux hooks kiro install`でインストールし、Kiroを`kiro-cli chat --agent uniconnect`で起動（またはデフォルトエージェントに設定）してください。UniConnectターミナル外では動作しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux hooks kiro install`로 훅을 설치한 다음 `kiro-cli chat --agent uniconnect`로 Kiro를 실행(또는 기본 에이전트로 설정)하세요. UniConnect 터미널 외부에서는 작동하지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تثبيت الخطافات باستخدام `cmux hooks kiro install`، ثم تشغيل Kiro باستخدام `kiro-cli chat --agent uniconnect` (أو تعيينه كوكيل افتراضي).إنهم ممنوعون من العمل خارج محطات UniConnect."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks se mora instalirati sa `cmux hooks kiro install`, a zatim pokrenuti Kiro sa `kiro-cli chat --agent uniconnect` (ili ga postaviti kao podrazumevanog agenta). Ne-op izvan UniConnect terminala."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks skal installeres med `cmux hooks kiro install`, og kør derefter Kiro med `kiro-cli chat --agent uniconnect` (eller indstil det som din standardagent). De fungerer ikke uden for UniConnect terminaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks müssen mit `cmux hooks kiro install` installiert und dann Kiro mit `kiro-cli chat --agent uniconnect` ausgeführt werden (oder als Standardagent festgelegt werden). Außerhalb von UniConnect Terminals ist kein Betrieb möglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala los hooks con `cmux hooks kiro install` y ejecuta Kiro con `kiro-cli chat --agent uniconnect` (o establécelo como agente predeterminado). No hacen nada fuera de los terminales de UniConnect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hooks doivent être installés avec `cmux hooks kiro install`, puis exécuter Kiro avec `kiro-cli chat --agent uniconnect` (ou le définir comme agent par défaut). Ils ne fonctionnent pas en dehors des terminaux UniConnect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli hook devono essere installati con `cmux hooks kiro install`, quindi eseguire Kiro con `kiro-cli chat --agent uniconnect` (o impostarlo come agente predefinito). Non operano all'esterno dei terminali UniConnect."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks ត្រូវតែដំឡើងជាមួយ `cmux hooks kiro install` បន្ទាប់មកដំណើរការ Kiro ជាមួយ `kiro-cli chat --agent uniconnect` (ឬកំណត់វាជាភ្នាក់ងារលំនាំដើមរបស់អ្នក)។ពួកគេ​មិន​ប្រើ​នៅ​ខាងក្រៅ UniConnect ស្ថានីយ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks må installeres med `cmux hooks kiro install`, og deretter kjøre Kiro med `kiro-cli chat --agent uniconnect` (eller angi den som standardagent). De er uten drift utenfor UniConnect terminaler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooki należy zainstalować z `cmux hooks kiro install`, następnie uruchomić Kiro z `kiro-cli chat --agent uniconnect` (lub ustawić go jako agenta domyślnego). Nie działają poza UniConnect terminalami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ganchos devem ser instalados com `cmux hooks kiro install` e, em seguida, executados Kiro com `kiro-cli chat --agent uniconnect` (ou defini-lo como seu agente padrão). Eles não funcionam fora dos terminais UniConnect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки необходимо установить с помощью `cmux hooks kiro install`, затем запустить Kiro с `kiro-cli chat --agent uniconnect` (или установить его в качестве агента по умолчанию). Они не работают за пределами UniConnect терминалов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องติดตั้ง Hooks ด้วย `cmux hooks kiro install` จากนั้นรัน Kiro ด้วย `kiro-cli chat --agent uniconnect` (หรือตั้งค่าเป็นตัวแทนเริ่มต้นของคุณ)พวกเขาไม่ดำเนินการภายนอกเทอร์มินัล UniConnect"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kancalar `cmux hooks kiro install` ile kurulmalı, ardından Kiro ile `kiro-cli chat --agent uniconnect` çalıştırılmalıdır (veya varsayılan aracınız olarak ayarlanmalıdır). UniConnect terminallerinin dışında işlem yapmazlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки потрібно встановити за допомогою `cmux hooks kiro install`, а потім запустити Kiro за допомогою `kiro-cli chat --agent uniconnect` (або встановити його як агента за замовчуванням). Вони не працюють поза терміналами UniConnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须使用 `cmux hooks kiro install` 安装挂钩，然后使用 `kiro-cli chat --agent uniconnect` 运行 Kiro（或将其设置为默认代理）。它们在 UniConnect 终端之外无操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須使用 `cmux hooks kiro install` 安裝掛鉤，然後使用 `kiro-cli chat --agent uniconnect` 執行 Kiro（或將其設定為預設代理）。它們在 UniConnect 終端機之外無操作。"
          }
        }
      }
    },

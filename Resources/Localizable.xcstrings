    "dialog.textURL.rules.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste Rules From an External Link?"
          }
        },
        "ja": {
          "stringUnit": {

    "terminal.imageTransfer.error.uploadTimedOut": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة نقل الملف. تحقق من المضيف البعيد واتصال الشبكة، ثم حاول مرة أخرى."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijenos datoteke je istekao. Provjerite udaljeni host i mrežnu vezu, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filoverførslen fik timeout. Kontrollér fjernværten og netværksforbindelsen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei der Dateiübertragung. Prüfe den Remote-Host und die Netzwerkverbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File transfer timed out. Check the remote host and network connection, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia del archivo ha agotado el tiempo de espera. Comprueba el host remoto y la conexión de red, y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert du fichier a expiré. Vérifiez l’hôte distant et la connexion réseau, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasferimento del file scaduto. Controlla l’host remoto e la connessione di rete, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル転送がタイムアウトしました。リモートホストとネットワーク接続を確認して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការផ្ទេរឯកសារអស់ពេល។ ពិនិត្យម៉ាស៊ីនពីចម្ងាយ និងការតភ្ជាប់បណ្តាញ រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 전송 시간이 초과되었습니다. 원격 호스트와 네트워크 연결을 확인한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filoverføringen ble tidsavbrutt. Kontroller den eksterne verten og nettverkstilkoblingen, og prøv på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upłynął limit czasu przesyłania pliku. Sprawdź host zdalny i połączenie sieciowe, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência do arquivo expirou. Verifique o host remoto e a conexão de rede e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время передачи файла истекло. Проверьте удалённый хост и сетевое подключение, затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมดเวลาการถ่ายโอนไฟล์ ตรวจสอบโฮสต์ระยะไกลและการเชื่อมต่อเครือข่าย แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya aktarımı zaman aşımına uğradı. Uzak ana bilgisayarı ve ağ bağlantısını kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час передачі файлу минув. Перевірте віддалений хост і мережеве підключення, а потім повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件传输超时。请检查远程主机和网络连接，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案傳輸逾時。請檢查遠端主機與網路連線，然後再試一次。"
          }
        }
      }
    },

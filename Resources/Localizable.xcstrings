    "taskManager.killProcess.message.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %@ (PID %lld) to terminate gracefully. UniConnect will force-kill it if it is still running after a short grace period."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（PID %lld）に正常終了を要求します。短い猶予時間の後も実行中の場合、UniConnect が強制終了します。"
          }
        }
      }
    },
    "taskManager.killProcess.title.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill processes?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセスを終了しますか？"
          }
        }
      }
    },
    "taskManager.killProcess.message.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %lld processes to terminate gracefully. UniConnect will force-kill remaining processes after a short grace period. PIDs: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個のプロセスに正常終了を要求します。短い猶予時間の後も残っているプロセスは UniConnect が強制終了します。PID: %@。"
          }
        }
      }
    },

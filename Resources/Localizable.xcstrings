    "uniconnect.workspace.ssh.encryptionDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is stored encrypted. Each window in this box is a tmux session on the server; if tmux is missing, UniConnect can install it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تخزينها مشفرة. كل نافذة في هذا المربع هي جلسة tmux على الخادم؛ إذا كان tmux مفقودًا، فيمكن لـ UniConnect تثبيته."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohranjuje se šifrovano. Svaki prozor u ovom polju je tmux sesija na serveru; ako tmux nedostaje, UniConnect ga može instalirati."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den opbevares krypteret. Hvert vindue i denne boks er en tmux-session på serveren; hvis tmux mangler, kan UniConnect installere det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird verschlüsselt gespeichert. Jedes Fenster in diesem Feld ist eine tmux-Sitzung auf dem Server. Wenn tmux fehlt, kann UniConnect es installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se almacena cifrado. Cada ventana en este cuadro es una sesión tmux en el servidor; si falta tmux, UniConnect puede instalarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est stocké crypté. Chaque fenêtre de cette zone est une session tmux sur le serveur ; si tmux est manquant, UniConnect peut l'installer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene archiviato crittografato. Ogni finestra in questa casella rappresenta una sessione tmux sul server; se manca tmux, UniConnect può installarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化されて保存されます。このボックス内の各ウィンドウは、サーバー上の tmux セッションです。 tmux がない場合は、UniConnect でインストールできます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "វាត្រូវបានរក្សាទុកដោយអ៊ិនគ្រីប។ បង្អួចនីមួយៗនៅក្នុងប្រអប់នេះគឺជាវគ្គ tmux នៅលើម៉ាស៊ីនមេ។ ប្រសិនបើ tmux បាត់ UniConnect អាចដំឡើងវាបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화되어 저장됩니다. 이 상자의 각 창은 서버의 tmux 세션입니다. tmux가 누락된 경우 UniConnect가 이를 설치할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lagres kryptert. Hvert vindu i denne boksen er en tmux-sesjon på serveren; hvis tmux mangler, kan UniConnect installere den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest przechowywany w postaci zaszyfrowanej. Każde okno w tym polu jest sesją tmux na serwerze; jeśli brakuje tmux, UniConnect może go zainstalować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele é armazenado criptografado. Cada janela nesta caixa é uma sessão tmux no servidor; se tmux estiver faltando, UniConnect poderá instalá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он хранится в зашифрованном виде. Каждое окно в этом поле представляет собой сеанс tmux на сервере; если tmux отсутствует, UniConnect может его установить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันถูกจัดเก็บแบบเข้ารหัส แต่ละหน้าต่างในกล่องนี้คือเซสชัน tmux บนเซิร์ฟเวอร์ ถ้า tmux หายไป UniConnect ก็สามารถติดตั้งได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrelenmiş olarak saklanır. Bu kutudaki her pencere sunucudaki bir tmux oturumudur; tmux eksikse UniConnect onu yükleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він зберігається в зашифрованому вигляді. Кожне вікно в цьому полі є сеансом tmux на сервері; якщо tmux відсутній, UniConnect може встановити його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它是加密存储的。该框中的每个窗口都是服务器上的一个 tmux 会话；如果tmux缺失，UniConnect可以安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它是加密儲存的。此框中的每個視窗都是伺服器上的一個 tmux 會話；如果tmux缺失，UniConnect可以安裝。"
          }
        }
      }
    },
    "uniconnect.reconnect.box.now": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect SSH Windows Now"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد توصيل جميع نوافذ محطة SSH الآن"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovo povežite sve prozore terminala SSH sada"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentilslut alle SSH terminalvinduer nu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie jetzt alle SSH-Terminalfenster erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectar todas las ventanas SSH ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez maintenant toutes les fenêtres du terminal SSH"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnetti ora tutte le finestre del terminale SSH"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての SSH ターミナル ウィンドウを今すぐ再接続します"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភ្ជាប់បង្អួចស្ថានីយ SSH ឡើងវិញឥឡូវនេះ"

    "settings.terminal.agentHibernation.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle background agent terminals can be hibernated when the live-terminal limit is exceeded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ端末数の上限を超えると、アイドル状態のバックグラウンドエージェント端末を休止できます。"
          }
        }
      }
    },
    "settings.terminal.agentHibernation.idleSeconds": {

    "uniconnect.ssh.resume.folderMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder %@ no longer exists; this session cannot be resumed from here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجلد %@ لم يعد موجودا؛لا يمكن استئناف هذه الجلسة من هنا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fascikla %@ više ne postoji;ova sesija se ne može nastaviti odavde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen %@ eksisterer ikke længere;denne session kan ikke genoptages herfra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner %@ existiert nicht mehr; Diese Sitzung kann von hier aus nicht fortgesetzt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta %@ ya no existe; esta sesión no se puede reanudar desde aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier %@ n'existe plus ;cette séance ne peut pas être reprise à partir d'ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella %@ non esiste più;questa sessione non può essere ripresa da qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ %@ はもう存在しません。このセッションはここから再開できません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថតឯកសារ %@ លែងមានទៀតហើយ;វគ្គនេះមិនអាចបន្តពីទីនេះបានទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 폴더가 더 이상 존재하지 않습니다.이 세션은 여기에서 재개될 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen %@ eksisterer ikke lenger;denne økten kan ikke gjenopptas herfra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder %@ już nie istnieje;tej sesji nie można stąd wznowić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta %@ não existe mais;esta sessão não pode ser retomada daqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка %@ больше не существует;этот сеанс нельзя возобновить отсюда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์ %@ ไม่มีอยู่แล้วเซสชันนี้ไม่สามารถดำเนินการต่อจากที่นี่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ klasörü artık mevcut değil;bu oturuma buradan devam edilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка %@ більше не існує;цей сеанс не можна відновити звідси."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹%@不再存在；该会话无法从此处恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料夾%@不再存在；該會話無法從此處復原。"
          }
        }
      }
    },

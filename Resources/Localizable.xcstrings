    "cli.hooks.feed.kiroUnrecognizedDecision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed returned an unrecognized Kiro permission decision; denying for safety.\n"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect قامت Feed بإرجاع قرار إذن Kiro غير معروف؛إنكار للسلامة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed je vratio neprepoznatu odluku o dozvoli Kiro; uskraćivanje radi sigurnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed returnerede en ikke-genkendt Kiro-tilladelsesbeslutning; nægter for sikkerheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed hat eine nicht erkannte Kiro-Berechtigungsentscheidung zurückgegeben; aus Sicherheitsgründen leugnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed devolvió una decisión de permiso Kiro no reconocida; negando por seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed a renvoyé une décision d'autorisation Kiro non reconnue ; nier pour des raisons de sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed ha restituito una decisione di autorizzazione Kiro non riconosciuta; negare per sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed は、認識できない Kiro 権限決定を返しました。安全のため拒否します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed ត្រឡប់ការសម្រេចចិត្តការអនុញ្ញាត Kiro ដែលមិនទទួលស្គាល់។បដិសេធដើម្បីសុវត្ថិភាព។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed가 인식할 수 없는 Kiro 권한 결정을 반환했습니다.안전을 위해 거부합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed returnerte en ukjent Kiro tillatelsesbeslutning; nekter for sikkerhets skyld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed zwrócił nierozpoznaną decyzję o pozwoleniu Kiro; odmawiając ze względu na bezpieczeństwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed retornou uma decisão de permissão Kiro não reconhecida; negando por segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed вернул неопознанное решение о разрешении Kiro; отрицая ради безопасности."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed ส่งคืนการตัดสินใจอนุญาต Kiro ที่ไม่รู้จักปฏิเสธเรื่องความปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed, tanınmayan bir Kiro izin kararı döndürdü; güvenlik nedeniyle reddediyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed повернув нерозпізнане рішення про дозвіл Kiro; відмовляючи з метою безпеки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed 返回无法识别的 Kiro 权限决策；为了安全而拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Feed 傳回無法辨識的 Kiro 權限決策；為了安全而拒絕。"
          }
        }
      }
    },

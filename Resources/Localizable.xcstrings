            "value": "កន្លែងធ្វើការក្នុងតំបន់មិនអាចមានពាក្យបញ្ជាការតភ្ជាប់ SSH ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 작업공간에는 SSH 연결 명령이 포함될 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lokalt arbeidsområde kan ikke inneholde en SSH-tilkoblingskommando."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalny obszar roboczy nie może zawierać polecenia połączenia SSH."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma área de trabalho local não pode conter um comando de conexão SSH."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная рабочая область не может содержать команду подключения SSH."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ทำงานภายในเครื่องไม่สามารถมีคำสั่งการเชื่อมต่อ SSH"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel bir çalışma alanı SSH bağlantı komutunu içeremez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальна робоча область не може містити команду підключення SSH."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地工作区不能包含 SSH 连接命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機工作區不能包含 SSH 連線指令。"
          }
        }
      }
    },
    "uniconnect.import.issue.workspaceKindMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The imported and existing workspace kinds differ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tipos del espacio de trabajo importado y existente son distintos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート元と既存ワークスペースの種類が異なります。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف أنواع مساحات العمل المستوردة والحالية."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvezene i postojeće vrste radnog prostora se razlikuju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De importerede og eksisterende arbejdsrumstyper er forskellige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die importierten und vorhandenen Arbeitsbereichstypen unterscheiden sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les types d'espace de travail importés et existants diffèrent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tipi di area di lavoro importati ed esistenti differiscono."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រភេទកន្លែងធ្វើការដែលបាននាំចូល និងដែលមានស្រាប់ខុសគ្នា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 작업공간과 기존 작업공간의 종류가 다릅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De importerte og eksisterende arbeidsområdetypene er forskjellige."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportowane i istniejące rodzaje obszarów roboczych różnią się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tipos de espaço de trabalho importados e existentes são diferentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортированные и существующие типы рабочих пространств различаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประเภทพื้นที่ทำงานที่นำเข้าและที่มีอยู่แตกต่างกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan ve mevcut çalışma alanı türleri farklılık gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортований і існуючий типи робочих областей відрізняються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的工作区类型和现有的工作区类型不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導入的工作區類型和現有的工作區類型不同。"
          }
        }
      }
    },

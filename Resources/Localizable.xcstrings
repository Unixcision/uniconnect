    "uniconnect.localWindow.target.agy.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy مع تمكين أذونات المجلد الموثوق."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy sa omogućenim dozvolama pouzdanog foldera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy med tilladelser til pålidelige mapper aktiveret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy mit aktivierten Berechtigungen für vertrauenswürdige Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy with trusted-folder permissions enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy con permisos para la carpeta de confianza activados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy avec les autorisations des dossiers de confiance activées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy con le autorizzazioni per le cartelle attendibili abilitate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy 信頼できるフォルダーのアクセス許可が有効になっています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy ជាមួយ​នឹង​ការ​អនុញ្ញាត​ថត​ដែល​ទុក​ចិត្ត​បាន​បើក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy 신뢰할 수 있는 폴더 권한이 활성화되어 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy med tillatelser for klarerte mapper aktivert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy z włączonymi uprawnieniami do zaufanego folderu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy com permissões de pasta confiável habilitadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy с включенными разрешениями для доверенных папок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy พร้อมเปิดใช้งานการอนุญาตโฟลเดอร์ที่เชื่อถือได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy güvenilir klasör izinleri etkinleştirilmiş."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy з увімкненими дозволами для надійної папки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy 已启用受信任文件夹权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Agy 已啟用受信任資料夾權限。"
          }

        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TextBox er en betafunksjon. Standardverdier og oppførsel kan endres mens den testes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TextBox jest funkcją beta. Domyślne ustawienia i zachowanie mogą się zmienić podczas testów."

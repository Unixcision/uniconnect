    "update.error.serverUnreachable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect couldn't connect to the update server. Check your connection or try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect はアップデートサーバーに接続できませんでした。接続を確認するか、後でもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 无法连接到更新服务器。请检查网络连接或稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 無法連線至更新伺服器。請檢查您的連線或稍後再試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect에서 업데이트 서버에 연결할 수 없습니다. 연결을 확인하거나 나중에 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect konnte keine Verbindung zum Update-Server herstellen. Überprüfen Sie Ihre Verbindung oder versuchen Sie es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no pudo conectar con el servidor de actualizaciones. Comprueba tu conexión o inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect n'a pas pu se connecter au serveur de mises à jour. Vérifiez votre connexion ou réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non è riuscito a connettersi al server degli aggiornamenti. Controlla la connessione o riprova più tardi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke oprette forbindelse til opdateringsserveren. Kontroller din forbindelse, eller prøv igen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie mógł połączyć się z serwerem aktualizacji. Sprawdź połączenie lub spróbuj ponownie później."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не удалось подключиться к серверу обновлений. Проверьте подключение или повторите попытку позже."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect se nije mogao povezati na server za ažuriranje. Provjerite vezu ili pokušajte ponovo kasnije."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على UniConnect الاتصال بخادم التحديثات. تحقق من اتصالك أو حاول لاحقًا."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke koble til oppdateringsserveren. Kontroller tilkoblingen eller prøv igjen senere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O UniConnect não conseguiu se conectar ao servidor de atualização. Verifique sua conexão ou tente novamente mais tarde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์อัปเดตได้ ตรวจสอบการเชื่อมต่อหรือลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect güncelleme sunucusuna bağlanamadı. Bağlantınızı kontrol edin veya daha sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не зміг підключитися до сервера оновлень. Перевірте підключення або спробуйте пізніше."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect មិនអាចភ្ជាប់ទៅម៉ាស៊ីនមេធ្វើបច្ចុប្បន្នភាពបានទេ។ពិនិត្យការតភ្ជាប់របស់អ្នក ឬព្យាយាមម្តងទៀតនៅពេលក្រោយ។"
          }
        }
      }
    },

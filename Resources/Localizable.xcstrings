    "dialog.moveFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect could not move this tab to the selected destination."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnectはこのタブを選択した移動先に移動できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 无法将此标签页移动到所选目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 無法將此標籤頁移至所選的目的地。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect에서 이 탭을 선택한 대상으로 이동할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect konnte diesen Tab nicht zum ausgewählten Ziel verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no pudo mover esta pestaña al destino seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect n'a pas pu déplacer cet onglet vers la destination sélectionnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non è riuscito a spostare questa scheda nella destinazione selezionata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke flytte denne fane til den valgte destination."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie mógł przenieść tej karty do wybranego miejsca docelowego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не удалось переместить эту вкладку в выбранное место назначения."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nije mogao premjestiti ovaj tab na odabrano odredište."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن UniConnect من نقل هذا اللسان إلى الوجهة المحددة."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke flytte denne fanen til den valgte destinasjonen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O UniConnect não conseguiu mover esta aba para o destino selecionado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่สามารถย้ายแท็บนี้ไปยังปลายทางที่เลือกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect bu sekmeyi seçilen hedefe taşıyamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не зміг перемістити цю вкладку до вибраного місця призначення."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect មិនអាចផ្លាស់ទីផ្ទាំងនេះទៅទិសដៅដែលបានជ្រើសរើសទេ។"
          }
        }
      }
    },

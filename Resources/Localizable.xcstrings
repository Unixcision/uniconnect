    },
    "uniconnect.import.error.stateChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current workspaces changed after this preview. Review the import again; no changes were made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espacios de trabajo actuales cambiaron después de esta vista previa. Revisa de nuevo la importación; no se realizó ningún cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー後に現在のワークスペースが変更されました。もう一度確認してください。変更は行われませんでした。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت مساحات العمل الحالية بعد هذه المعاينة. قم بمراجعة الاستيراد مرة أخرى؛ لم يتم إجراء أي تغييرات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutni radni prostori su promijenjeni nakon ovog pregleda. Ponovo pregledajte uvoz; promjene nisu napravljene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De aktuelle arbejdsområder blev ændret efter denne forhåndsvisning. Gennemgå importen igen; der blev ikke foretaget ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuellen Arbeitsbereiche haben sich nach dieser Vorschau geändert. Überprüfen Sie den Import noch einmal. Es wurden keine Änderungen vorgenommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les espaces de travail actuels ont changé après cet aperçu. Vérifiez à nouveau l'importation ; aucun changement n'a été apporté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli spazi di lavoro correnti sono cambiati dopo questa anteprima. Rivedi nuovamente l'importazione; non sono state apportate modifiche."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កន្លែងធ្វើការបច្ចុប្បន្នបានផ្លាស់ប្តូរបន្ទាប់ពីការមើលជាមុននេះ។ ពិនិត្យមើលការនាំចូលម្តងទៀត; គ្មាន​ការ​ផ្លាស់​ប្តូ​រ​ត្រូវ​បាន​ធ្វើ​ឡើង​។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 미리보기 이후 현재 작업 공간이 변경되었습니다. 가져오기를 다시 검토하세요. 변경 사항이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De gjeldende arbeidsområdene ble endret etter denne forhåndsvisningen. Gå gjennom importen på nytt; ingen endringer ble gjort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżące obszary robocze zmieniły się po tym podglądzie. Przejrzyj ponownie import; nie wprowadzono żadnych zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As áreas de trabalho atuais foram alteradas após esta visualização. Revise a importação novamente; nenhuma alteração foi feita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После этого предварительного просмотра текущие рабочие пространства изменились. Просмотрите импорт еще раз; никаких изменений не произошло."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ทำงานปัจจุบันมีการเปลี่ยนแปลงหลังจากการดูตัวอย่างนี้ ตรวจสอบการนำเข้าอีกครั้ง ไม่มีการเปลี่ยนแปลงใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu önizlemeden sonra mevcut çalışma alanları değişti. İçe aktarmayı tekrar gözden geçirin; hiçbir değişiklik yapılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточні робочі області змінилися після цього перегляду. Перегляньте імпорт ще раз; змін не було внесено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前工作区在此预览后发生了变化。再次审核导入；没有做任何改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前工作區在此預覽後發生了變化。再次審核導入；沒有做任何改變。"
          }
        }
      }
    },
    "uniconnect.import.error.blocked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استيراد سوى الصفوف المعلَّمة «إنشاء» أو «تحديث». تم تخطي التعارضات والتعريفات المرفوضة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogu se uvesti samo redovi označeni kao Kreiraj ili Ažuriraj. Sukobi i odbijene deklaracije su preskočeni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun rækker markeret Opret eller Opdater kan importeres. Konflikter og afviste deklarationer blev sprunget over."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur als „Erstellen“ oder „Aktualisieren“ markierte Zeilen können importiert werden. Konflikte und abgelehnte Deklarationen wurden übersprungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only rows marked Create or Update can be imported. Conflicts and rejected declarations were skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden importar las filas marcadas como Crear o Actualizar. Se han omitido los conflictos y las declaraciones rechazadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les lignes marquées Créer ou Mettre à jour peuvent être importées. Les conflits et les déclarations rejetées ont été ignorés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile importare solo le righe contrassegnate come Crea o Aggiorna. I conflitti e le dichiarazioni rifiutate sono stati ignorati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「作成」または「更新」とマークされた行のみインポートできます。競合と拒否された宣言はスキップされました。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អាច​នាំចូល​បាន​តែ​ជួរ​ដេក​ដែល​សម្គាល់​ថា បង្កើត ឬ ធ្វើ​បច្ចុប្បន្នភាព ប៉ុណ្ណោះ។ ភាពផ្ទុយគ្នា និង​សេចក្តី​ប្រកាស​ដែល​បាន​បដិសេធ​ត្រូវ​បាន​រំលង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만들기 또는 업데이트로 표시된 행만 가져올 수 있습니다. 충돌 및 거부된 선언은 건너뛰었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare rader merket Opprett eller Oppdater kan importeres. Konflikter og avviste deklarasjoner ble hoppet over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można importować tylko wiersze oznaczone jako Utwórz lub Aktualizuj. Konflikty i odrzucone deklaracje zostały pominięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as linhas marcadas como Criar ou Atualizar podem ser importadas. Conflitos e declarações rejeitadas foram ignorados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно импортировать только строки с пометкой «Создать» или «Обновить». Конфликты и отклонённые объявления были пропущены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าได้เฉพาะแถวที่ทำเครื่องหมายว่าสร้างหรืออัปเดตเท่านั้น ระบบข้ามข้อขัดแย้งและการประกาศที่ถูกปฏิเสธแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Oluştur veya Güncelle olarak işaretlenen satırlar içe aktarılabilir. Çakışmalar ve reddedilen bildirimler atlandı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна імпортувати лише рядки з позначкою «Створити» або «Оновити». Конфлікти та відхилені оголошення пропущено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能导入标记为“创建”或“更新”的行。已跳过冲突和被拒绝的声明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能匯入標示為「建立」或「更新」的列。已略過衝突和遭拒的宣告。"
          }
        }
      }
    },
    "uniconnect.import.error.transactionalUpdatesRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This import contains updates. No changes were made because updates require transactional reconciliation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta importación contiene actualizaciones. No se realizó ningún cambio porque las actualizaciones requieren una reconciliación transaccional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインポートには更新が含まれています。更新にはトランザクション対応の照合が必要なため、変更は行われませんでした。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا الاستيراد على تحديثات. لم يتم إجراء أية تغييرات لأن التحديثات تتطلب تسوية المعاملات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj uvoz sadrži ažuriranja. Nisu napravljene nikakve promjene jer ažuriranja zahtijevaju usklađivanje transakcija."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne import indeholder opdateringer. Der blev ikke foretaget ændringer, fordi opdateringer kræver transaktionsafstemning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Import enthält Updates. Es wurden keine Änderungen vorgenommen, da Aktualisierungen einen Transaktionsabgleich erfordern."
          }
        },

          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect Browserprofil „%@“ kann nicht gelöscht werden, während %d Browserpanel(s) es verwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar el perfil de navegador de UniConnect «%@» mientras lo usan %d paneles del navegador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer UniConnect profil de navigateur '%@' alors que %d les panneaux de navigateur l'utilisent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare UniConnect il profilo del browser '%@' mentre %d lo/i pannello/i del browser lo stanno utilizzando"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចលុប UniConnect ទម្រង់កម្មវិធីរុករកតាមអ៊ីនធឺណិត '%@' ខណៈពេលដែល %d បន្ទះកម្មវិធីរុករកកំពុងប្រើវា"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 브라우저 패널을 사용하는 동안 UniConnect 브라우저 프로필 '%@'을(를) 삭제할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke slette UniConnect nettleserprofil '%@' mens %d nettleserpanel(er) bruker den"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można usunąć UniConnect profilu przeglądarki „%@”, gdy %d panel(e) przeglądarki go używają"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível excluir UniConnect perfil do navegador '%@' enquanto %d painel(s) do navegador estão usando-o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно удалить UniConnect профиль браузера '%@', пока %d панель браузера использует его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถลบ UniConnect โปรไฟล์เบราว์เซอร์ '%@' ในขณะที่ %d แผงเบราว์เซอร์กำลังใช้งานอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect tarayıcı profili '%@' %d tarayıcı paneli/panelleri onu kullanırken silinemiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо видалити UniConnect профіль браузера '%@', поки його використовують панелі браузера %d"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 %d 浏览器面板正在使用 UniConnect 浏览器配置文件“%@”时，无法删除它"

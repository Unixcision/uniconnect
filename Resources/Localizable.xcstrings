        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការធ្វើបច្ចុប្បន្នភាព ឬការស្ដារ Claude មួយផ្សេងទៀតកំពុងដំណើរការរួចហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또 다른 Claude 업데이트 또는 복구가 이미 실행 중입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",

    "crashBreadcrumb.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostic file saved. Click to reveal it in Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ファイルを保存しました。クリックするとFinderで表示します。"

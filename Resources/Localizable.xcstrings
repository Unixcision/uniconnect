    "sidebar.extensions.unapproved.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An installed sidebar extension needs approval before UniConnect can use it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのサイドバー拡張機能は、UniConnectで使用する前に承認が必要です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج ملحق الشريط الجانبي المثبت إلى موافقة قبل أن يتمكن UniConnect من استخدامه."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirano proširenje bočne trake treba odobrenje prije nego što ga UniConnect može koristiti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En installeret sidebar-udvidelse skal godkendes, før UniConnect kan bruge den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine installierte Seitenleistenerweiterung muss genehmigt werden, bevor UniConnect sie verwenden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una extensión de barra lateral instalada necesita tu aprobación antes de que UniConnect pueda usarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une extension de barre latérale installée doit être approuvée avant que UniConnect puisse l'utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'estensione della barra laterale installata necessita dell'approvazione prima che UniConnect possa utilizzarla."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្នែកបន្ថែមរបារចំហៀងដែលបានដំឡើងត្រូវការការយល់ព្រមមុនពេល UniConnect អាចប្រើវាបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 사이드바 확장 프로그램을 UniConnect에서 사용하려면 승인이 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En installert sidefeltutvidelse trenger godkjenning før UniConnect kan bruke den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstalowane rozszerzenie paska bocznego wymaga zatwierdzenia, zanim UniConnect będzie mogło z niego korzystać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma extensão de barra lateral instalada precisa de aprovação antes que UniConnect possa usá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установленное расширение боковой панели должно быть одобрено, прежде чем UniConnect сможет его использовать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนขยายแถบด้านข้างที่ติดตั้งต้องได้รับอนุมัติก่อน UniConnect จึงจะสามารถใช้งานได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü bir kenar çubuğu uzantısının UniConnect tarafından kullanılabilmesi için onaylanması gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Установлене розширення бічної панелі потребує схвалення, перш ніж UniConnect зможе його використовувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的侧边栏扩展需要先获得批准，然后 UniConnect 才能使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝的側邊欄擴充需要先獲得批准，然後 UniConnect 才能使用它。"
          }
        }
      }
    },

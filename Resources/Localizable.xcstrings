    "settings.automation.cursor.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks must be installed with `cmux hooks cursor install`. They no-op outside UniConnect terminals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックは`cmux hooks cursor install`でインストールする必要があります。UniConnectターミナル外では動作しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`cmux hooks cursor install`로 훅을 설치해야 합니다. UniConnect 터미널 외부에서는 작동하지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب تثبيت الخطافات باستخدام `cmux hooks cursor install`.إنهم ممنوعون من العمل خارج محطات UniConnect."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuke se moraju instalirati sa `cmux hooks cursor install`. Ne-op izvan UniConnect terminala."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroge skal monteres med `cmux hooks cursor install`. De fungerer ikke uden for UniConnect terminaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks müssen mit `cmux hooks cursor install` installiert werden. Außerhalb von UniConnect-Terminals ist kein Betrieb möglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala los hooks con `cmux hooks cursor install`. No hacen nada fuera de los terminales de UniConnect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hooks doivent être installés avec `cmux hooks cursor install`. Ils ne fonctionnent pas en dehors des terminaux UniConnect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli hook devono essere installati con `cmux hooks cursor install`. Non operano all'esterno dei terminali UniConnect."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទំពក់ត្រូវតែត្រូវបានដំឡើងជាមួយ `cmux hooks cursor install`។ពួកគេ​មិន​ប្រើ​នៅ​ខាងក្រៅ UniConnect ស្ថានីយ។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroker må installeres med `cmux hooks cursor install`. De er uten drift utenfor UniConnect terminaler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haki muszą być zainstalowane z `cmux hooks cursor install`. Nie działają poza UniConnect terminalami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ganchos devem ser instalados com `cmux hooks cursor install`. Eles não funcionam fora dos terminais UniConnect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки должны быть установлены с помощью `cmux hooks cursor install`. Они не работают за пределами UniConnect терминалов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องติดตั้งตะขอด้วย `cmux hooks cursor install`พวกเขาไม่ดำเนินการภายนอกเทอร์มินัล UniConnect"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kancalar `cmux hooks cursor install` ile kurulmalıdır. UniConnect terminallerinin dışında işlem yapmazlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки повинні бути встановлені з `cmux hooks cursor install`. Вони не працюють поза терміналами UniConnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂钩必须安装`cmux hooks cursor install`。它们在 UniConnect 终端之外无操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掛鉤必須安裝`cmux hooks cursor install`。它們在 UniConnect 終端機之外無操作。"
          }
        }
      }
    },

    "bridge.cleanup.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this SSH item permanently?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este elemento SSH definitivamente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このSSH項目を完全に削除しますか？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف عنصر SSH هذا نهائيًا؟"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisati ovu SSH stavku trajno?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du slette dette SSH-element permanent?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses SSH-Element dauerhaft löschen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement cet élément SSH ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare permanentemente questo elemento SSH?"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លុបធាតុ SSH នេះជារៀងរហូត?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 SSH 항목을 영구적으로 삭제하시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du slette dette SSH-elementet permanent?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwale usunąć ten element SSH?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir este item SSH permanentemente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить этот элемент SSH навсегда?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบรายการ SSH นี้อย่างถาวรหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu SSH öğesi kalıcı olarak silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цей елемент SSH назавжди?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除此 SSH 项目吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除此 SSH 項目嗎？"
          }
        }
      }
    },
    "bridge.cleanup.delete.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also remove UniConnect's namespaced Claude notification integration from the remote host. Other hooks and tmux sessions are never touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes retirar del host remoto la integración de notificaciones de Claude perteneciente a UniConnect. Los demás hooks y las sesiones tmux nunca se modifican."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートホストからUniConnect専用のClaude通知連携も削除できます。他のフックやtmuxセッションには一切触れません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك أيضًا إزالة تكامل إشعارات Claude الخاصة بمساحة الاسم UniConnect من المضيف البعيد. لا يتم لمس الخطافات الأخرى وجلسات tmux أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Takođe možete ukloniti UniConnect integraciju Claude obavještenja s prostorom imena sa udaljenog hosta. Druge kuke i tmux sesije se nikada ne diraju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også fjerne UniConnects navneinddelte Claude notifikationsintegration fra fjernværten. Andre hooks og tmux-sessioner røres aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können auch die namensraumbasierte Claude-Benachrichtigungsintegration von UniConnect vom Remote-Host entfernen. Andere Hooks und tmux-Sitzungen werden nie berührt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez également supprimer l'intégration de notification Claude avec espace de noms de UniConnect de l'hôte distant. Les autres hooks et sessions tmux ne sont jamais touchés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È inoltre possibile rimuovere l'integrazione delle notifiche Claude con spazio dei nomi di UniConnect dall'host remoto. Gli altri hook e le sessioni tmux non vengono mai toccati."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកក៏អាចលុបការរួមបញ្ចូលការជូនដំណឹង Claude ដែលដាក់ឈ្មោះរបស់ UniConnect ចេញពីម៉ាស៊ីនពីចម្ងាយផងដែរ។ ទំពក់ផ្សេងទៀត និងវគ្គ tmux មិនដែលប៉ះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 호스트에서 UniConnect의 네임스페이스 Claude 알림 통합을 제거할 수도 있습니다. 다른 후크와 tmux 세션은 절대 건드리지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan også fjerne UniConnects navndelte Claude-varslingsintegrasjon fra den eksterne verten. Andre kroker og tmux-økter berøres aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz także usunąć integrację powiadomień Claude z przestrzenią nazw UniConnect ze zdalnego hosta. Inne hooki i sesje tmux nie są nigdy dotykane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode remover a integração de notificação Claude com namespace de UniConnect do host remoto. Outros ganchos e sessões tmux nunca são tocados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы также можете удалить интеграцию уведомлений Claude в пространстве имен UniConnect с удаленного хоста. Другие перехватчики и сеансы tmux никогда не затрагиваются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังสามารถลบการรวมการแจ้งเตือน Claude ที่เนมสเปซของ UniConnect ออกจากโฮสต์ระยะไกลได้ hooks และเซสชัน tmux อื่นๆ จะไม่ถูกแตะต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıca UniConnect'nun ad alanlı Claude bildirim entegrasyonunu uzak ana bilgisayardan da kaldırabilirsiniz. Diğer kancalara ve tmux oturumlarına hiçbir zaman dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви також можете видалити інтеграцію сповіщень із простором імен UniConnect Claude з віддаленого хоста. Інші хуки та сесії tmux ніколи не торкаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您还可以从远程主机删除 UniConnect 的命名空间 Claude 通知集成。其他挂钩和 tmux 会话从未被触及。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您也可以從遠端主機刪除 UniConnect 的命名空間 Claude 通知整合。其他掛鉤和 tmux 會話從未被觸及。"
          }
        }
      }
    },
    "bridge.cleanup.delete.remoteUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote cleanup is unavailable because the saved SSH connection cannot be opened safely. You can keep this item and retry later, or delete only its local record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La retirada remota no está disponible porque no se puede abrir con seguridad la conexión SSH guardada. Puedes conservar este elemento y reintentarlo más tarde, o borrar solo su registro local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたSSH接続を安全に開けないため、リモートの削除は利用できません。この項目を残して後で再試行するか、ローカルの記録だけを削除できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنظيف عن بعد غير متاح لأنه لا يمكن فتح اتصال SSH المحفوظ بأمان. يمكنك الاحتفاظ بهذا العنصر وإعادة المحاولة لاحقًا، أو حذف سجله المحلي فقط."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Daljinsko čišćenje nije dostupno jer se sačuvana SSH veza ne može bezbedno otvoriti. Možete zadržati ovu stavku i pokušati ponovo kasnije ili izbrisati samo njen lokalni zapis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernoprydning er ikke tilgængelig, fordi den gemte SSH-forbindelse ikke kan åbnes sikkert. Du kan beholde dette element og prøve igen senere, eller du kan kun slette dets lokale registrering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Remote-Bereinigung ist nicht verfügbar, da die gespeicherte SSH-Verbindung nicht sicher geöffnet werden kann. Sie können dieses Element behalten und es später erneut versuchen oder nur seinen lokalen Datensatz löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage à distance n'est pas disponible car la connexion SSH enregistrée ne peut pas être ouverte en toute sécurité. Vous pouvez conserver cet élément et réessayer plus tard, ou supprimer uniquement son enregistrement local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulizia remota non è disponibile perché la connessione SSH salvata non può essere aperta in modo sicuro. Puoi conservare questo elemento e riprovare più tardi oppure eliminare solo il relativo record locale."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការសម្អាតពីចម្ងាយមិនអាចប្រើបានទេ ដោយសារការតភ្ជាប់ SSH ដែលបានរក្សាទុកមិនអាចបើកដោយសុវត្ថិភាពបានទេ។ អ្នកអាចរក្សាធាតុនេះ ហើយព្យាយាមម្តងទៀតនៅពេលក្រោយ ឬលុបតែកំណត់ត្រាក្នុងតំបន់របស់វាប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 SSH 연결을 안전하게 열 수 없어 원격 정리를 사용할 수 없습니다. 이 항목을 유지하고 나중에 다시 시도하거나 로컬 기록만 삭제할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernopprydding er utilgjengelig fordi den lagrede SSH-tilkoblingen ikke kan åpnes trygt. Du kan beholde dette elementet og prøve på nytt senere, eller slette bare den lokale posten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdalne czyszczenie jest niedostępne, ponieważ nie można bezpiecznie otworzyć zapisanego połączenia SSH. Możesz zachować ten element i spróbować ponownie później lub usunąć tylko jego rekord lokalny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza remota não está disponível porque a conexão SSH salva não pode ser aberta com segurança. Você pode manter esse item e tentar novamente mais tarde ou excluir apenas seu registro local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаленная очистка недоступна, поскольку сохраненное соединение SSH не может быть безопасно открыто. Вы можете сохранить этот элемент и повторить попытку позже или удалить только его локальную запись."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การล้างข้อมูลจากระยะไกลไม่พร้อมใช้งานเนื่องจากการเชื่อมต่อ SSH ที่บันทึกไว้ไม่สามารถเปิดได้อย่างปลอดภัย คุณสามารถเก็บรายการนี้ไว้แล้วลองอีกครั้งในภายหลัง หรือลบเฉพาะบันทึกในเครื่องเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen SSH bağlantısı güvenli bir şekilde açılamadığından uzaktan temizleme kullanılamıyor. Bu öğeyi saklayıp daha sonra yeniden deneyebilir veya yalnızca yerel kaydını silebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віддалене очищення недоступне, оскільки збережене підключення SSH неможливо відкрити безпечно. Ви можете зберегти цей елемент і повторити спробу пізніше або видалити лише його локальний запис."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程清理不可用，因为保存的 SSH 连接无法安全打开。您可以保留该项目并稍后重试，或者仅删除其本地记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端清理不可用，因為已儲存的 SSH 連線無法安全開啟。您可以保留該項目並稍後重試，或僅刪除其本地記錄。"
          }
        }
      }
    },

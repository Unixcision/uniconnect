    "menu.file.recentlyClosed.clear.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة كل عنصر مغلق من هذه القائمة. جلسات tmux عن بعد لا تتأثر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka zatvorena stavka će biti uklonjena sa ove liste. To ne utiče na udaljene tmux sesije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert lukket element vil blive fjernet fra denne liste. Fjernsessioner tmux påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder geschlossene Eintrag wird aus dieser Liste entfernt. Remote-tmux-Sitzungen sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every closed item will be removed from this list. Remote tmux sessions are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de la lista todos los elementos cerrados. Las sesiones tmux remotas no se verán afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque élément fermé sera supprimé de cette liste. Les sessions tmux à distance ne sont pas affectées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni elemento chiuso verrà rimosso da questo elenco. Le sessioni remote tmux non sono interessate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた項目がすべてリストから削除されます。リモートtmuxセッションには影響しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រាល់ធាតុដែលបានបិទនឹងត្រូវដកចេញពីបញ្ជីនេះ។ វគ្គ tmux ពីចម្ងាយមិនត្រូវបានប៉ះពាល់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫힌 항목은 모두 이 목록에서 제거됩니다. 원격 tmux 세션은 영향을 받지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert lukket element vil bli fjernet fra denne listen. Eksterne tmux økter påvirkes ikke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy zamknięty element zostanie usunięty z tej listy. Nie ma to wpływu na zdalne sesje tmux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada item fechado será removido desta lista. Sessões tmux remotas não são afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый закрытый элемент будет удален из этого списка. Удаленные сеансы tmux не затрагиваются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกรายการที่ปิดจะถูกลบออกจากรายการนี้ เซสชันระยะไกล tmux จะไม่ได้รับผลกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatılan her öğe bu listeden kaldırılacaktır. Uzak tmux oturumları etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен закритий пункт буде видалено з цього списку. Віддалені сеанси tmux не впливають."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个关闭的项目都将从该列表中删除。远程 tmux 会话不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個關閉的項目將從該清單中刪除。遠端 tmux 會話不受影響。"
          }
        }
      }
    },

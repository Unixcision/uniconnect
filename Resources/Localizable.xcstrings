    "cli.top.error.processDiagnosticsUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب cmux top إصدار UniConnect قيد التشغيل يدعم تشخيص العمليات"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top zahtijeva pokrenutu UniConnect verziju koja podržava dijagnostiku procesa"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top kræver en kørende UniConnect-build med procesdiagnostik"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top erfordert einen laufenden UniConnect-Build mit Prozessdiagnose"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top requires a running UniConnect build that supports process diagnostics"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top requiere una compilación de UniConnect en ejecución que admita diagnósticos de procesos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top nécessite une version UniConnect en cours d’exécution prenant en charge le diagnostic des processus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top richiede una build UniConnect in esecuzione che supporti la diagnostica dei processi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top にはプロセス診断に対応した実行中の UniConnect ビルドが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top에는 프로세스 진단을 지원하는 실행 중인 UniConnect 빌드가 필요합니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top krever en kjørende UniConnect-build som støtter prosessdiagnostikk"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top wymaga uruchomionej kompilacji UniConnect z obsługą diagnostyki procesów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top requer uma build UniConnect em execução com suporte a diagnósticos de processos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top требует запущенную сборку UniConnect с поддержкой диагностики процессов"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux top ต้องใช้บิลด์ UniConnect ที่กำลังทำงานและรองรับการวินิจฉัยโปรเซส"
          }
        },
        "tr": {

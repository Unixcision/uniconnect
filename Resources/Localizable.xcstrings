        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 가져오기 또는 복구 작업이 이미 진행 중입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen import- eller gjenopprettingsoperasjon pågår allerede."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna operacja importu lub odzyskiwania jest już w toku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra operação de importação ou recuperação já está em andamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другая операция импорта или восстановления уже выполняется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังดำเนินการนำเข้าหรือกู้คืนอื่นอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",

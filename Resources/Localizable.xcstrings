    "command.cloudVM.failed.exit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux vm new exited with status %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cmux vm new がステータス %d で終了しました。"
          }
        }
      }
    },
    "command.cloudVM.failed.action.exit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a terminal and run `cmux auth status`, `cmux vm ls`, then `cmux vm new`. If you hit the active VM limit, delete one with `cmux vm rm <id>` and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルを開いて `cmux auth status`、`cmux vm ls`、`cmux vm new` を実行してください。アクティブな VM 数の上限に達している場合は `cmux vm rm <id>` で削除してから再試行してください。"
          }
        }
      }
    },
    "command.cloudVM.failed.action.launch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload UniConnect so the bundled CLI is available, then try again. If it still fails, run `cmux vm new` in a terminal and send us the output."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バンドルされた CLI を使えるように UniConnect を再読み込みしてから再試行してください。それでも失敗する場合は、ターミナルで `cmux vm new` を実行して出力を送ってください。"
          }
        }
      }
    },
    "command.cloudVM.failed.action.missingCLI": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install or reload a fresh UniConnect build, then try Start Cloud VM again. You can also run `cmux vm new` in a terminal to see the full error."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい UniConnect ビルドをインストールまたは再読み込みしてから、Start Cloud VM をもう一度試してください。ターミナルで `cmux vm new` を実行すると完全なエラーも確認できます。"
          }
        }
      }
    },

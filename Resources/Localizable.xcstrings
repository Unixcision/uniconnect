    "uniconnect.ssh.edit.authenticationReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show and edit the encrypted SSH connection"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار وتحرير الاتصال المشفر SSH"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikažite i uredite šifriranu SSH vezu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis og rediger den krypterede SSH forbindelse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie die verschlüsselte Verbindung SSH an und bearbeiten Sie sie"
          }
        },
        "es": {
          "stringUnit": {

        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`sshpass`을 사용하는 경우 명령은 옵션 뒤에 `ssh`를 호출해야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med `sshpass` må kommandoen påkalle `ssh` etter alternativene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przypadku `sshpass` polecenie musi wywołać `ssh` po opcjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com `sshpass`, o comando deve invocar `ssh` após as opções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При использовании `sshpass` команда должна вызывать `ssh` после параметров."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้วย `sshpass` คำสั่งจะต้องเรียกใช้ `ssh` หลังตัวเลือก"
          }
        },
        "tr": {
          "stringUnit": {

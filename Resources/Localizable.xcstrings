      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect could not load this extension's configuration. No workspace data or actions were shared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnectはこの拡張機能の設定を読み込めませんでした。ワークスペースデータや操作は共有されていません。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على UniConnect تحميل تكوين هذا الملحق.لم تتم مشاركة أي بيانات أو إجراءات في مساحة العمل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nije mogao učitati konfiguraciju ovog proširenja. Nisu podijeljeni nikakvi podaci ili radnje radnog prostora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke indlæse denne udvidelses konfiguration. Ingen arbejdsområdedata eller handlinger blev delt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect konnte die Konfiguration dieser Erweiterung nicht laden. Es wurden keine Arbeitsbereichsdaten oder -aktionen geteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no pudo cargar la configuración de esta extensión. No se compartieron datos ni acciones del espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect n'a pas pu charger la configuration de cette extension. Aucune donnée ou action de l'espace de travail n'a été partagée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non è riuscito a caricare la configurazione di questa estensione. Non sono stati condivisi dati o azioni dell'area di lavoro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect មិនអាចផ្ទុកការកំណត់រចនាសម្ព័ន្ធកម្មវិធីបន្ថែមនេះបានទេ។គ្មានទិន្នន័យ ឬសកម្មភាពកន្លែងធ្វើការត្រូវបានចែករំលែកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect에서 이 확장 프로그램의 구성을 로드할 수 없습니다.작업공간 데이터나 작업이 공유되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect kunne ikke laste denne utvidelsens konfigurasjon. Ingen arbeidsområdedata eller handlinger ble delt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie mógł załadować konfiguracji tego rozszerzenia. Nie udostępniono żadnych danych ani działań obszaru roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect não foi possível carregar a configuração desta extensão. Nenhum dado ou ação do espaço de trabalho foi compartilhado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не удалось загрузить конфигурацию этого расширения. Никакие данные или действия рабочей области не были переданы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่สามารถโหลดการกำหนดค่าของส่วนขยายนี้ได้ไม่มีการแชร์ข้อมูลพื้นที่ทำงานหรือการดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect bu uzantının yapılandırmasını yükleyemedi. Hiçbir çalışma alanı verisi veya eylemi paylaşılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не вдалося завантажити конфігурацію цього розширення. Дані чи дії робочої області не надано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 无法加载此扩展的配置。没有共享工作区数据或操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 無法載入此擴充功能的配置。沒有共享工作區資料或操作。"
          }
        }
      }
    },

    "uniconnect.localWindow.new.exitHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد /exit، يعود الوكيل إلى shell لهذه النافذة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon /exit, agent se vraća na shell ovog prozora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter /exit vender agenten tilbage til dette vindues shell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach /exit kehrt der Agent zum shell dieses Fensters zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After /exit, the agent returns to this window's shell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de /exit, el agente vuelve al shell de esta ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après /exit, l'agent revient au shell de cette fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo /exit, l'agente ritorna alla finestra shell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/exit の後、エージェントはこのウィンドウの shell に戻ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ទាប់ពី /exit ភ្នាក់ងារត្រឡប់ទៅ shell របស់បង្អួចនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/exit 이후 에이전트는 이 창의 shell으로 돌아갑니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter /exit går agenten tilbake til dette vinduets shell."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po /exit agent powraca do shell tego okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após /exit, o agente retorna para esta janela shell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После /exit агент возвращается к этому окну shell."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจาก /exit เอเจนต์จะกลับไปที่ shell ของหน้าต่างนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "/exit sonrasında aracı bu pencerenin shell penceresine geri döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після /exit агент повертається до shell цього вікна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在/exit之后，代理返回到此窗口的shell。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在/exit之後，代理程式回到此視窗的shell。"
          }
        }
      }
    },

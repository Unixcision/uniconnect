    "settings.app.closeWorkspaceOnLastSurfaceShortcut.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the focused surface is the last one in its workspace, the close-surface shortcut also closes the workspace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のサーフェスがそのワークスペースの最後の1つなら、サーフェスを閉じるショートカットはワークスペースも閉じます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли активна поверхня є останньою у робочій області, комбінація закриття поверхні також закриває робочу область."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 서피스가 워크스페이스의 마지막일 때, 서피스 닫기 단축키로 워크스페이스도 함께 닫힙니다."
          }
        }
      }
    },
    "settings.app.closeWorkspaceOnLastSurfaceShortcut.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the focused surface is the last one in its workspace, the close-surface shortcut closes only the surface and keeps the workspace open. Use the close-workspace shortcut to close the workspace explicitly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のサーフェスがそのワークスペースの最後の1つでも、サーフェスを閉じるショートカットはサーフェスだけを閉じ、ワークスペースは残します。ワークスペースを閉じるショートカットを使うと明示的に閉じられます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли активна поверхня є останньою у робочій області, комбінація закриття поверхні закриває лише поверхню, залишаючи робочу область відкритою. Використовуйте комбінацію закриття робочої області для явного закриття."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 서피스가 워크스페이스의 마지막일 때, 서피스 닫기 단축키로 서피스만 닫고 워크스페이스는 유지됩니다. 워크스페이스를 닫으려면 워크스페이스 닫기 단축키를 사용하세요."
          }
        }
      }
    },
    "settings.app.paneFirstClickFocus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Pane on First Click"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のクリックでペインにフォーカス"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фокус панелі при першому кліку"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 클릭으로 패인 포커스"
          }
        }
      }
    },
    "settings.app.paneFirstClickFocus.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When UniConnect is inactive, the first click only activates the window. Click again to focus the pane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnectが非アクティブのとき、最初のクリックはウインドウをアクティブにするだけです。ペインにフォーカスするにはもう一度クリックします。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли UniConnect неактивний, перший клік лише активує вікно. Клацніть ще раз, щоб сфокусувати панель."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect가 비활성 상태일 때, 첫 번째 클릭은 윈도우만 활성화합니다. 패인을 포커스하려면 다시 클릭하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يكون UniConnect غير نشط، فإن النقرة الأولى تؤدي إلى تنشيط النافذة فقط.انقر مرة أخرى لتركيز الجزء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada UniConnect nije aktivan, prvi klik samo aktivira prozor. Kliknite ponovo da fokusirate okno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når UniConnect er inaktivt, aktiverer det første klik kun vinduet. Klik igen for at fokusere ruden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn UniConnect inaktiv ist, aktiviert der erste Klick nur das Fenster. Klicken Sie erneut, um den Bereich zu fokussieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando UniConnect esté inactivo, el primer clic solo activará la ventana. Vuelve a hacer clic para enfocar el panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque UniConnect est inactif, le premier clic active uniquement la fenêtre. Cliquez à nouveau pour focaliser le volet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando UniConnect è inattivo, il primo clic attiva solo la finestra. Fare di nuovo clic per mettere a fuoco il riquadro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេលដែល UniConnect អសកម្ម ការចុចដំបូងគ្រាន់តែធ្វើឱ្យបង្អួចសកម្មប៉ុណ្ណោះ។ចុចម្តងទៀតដើម្បីផ្ដោតលើផ្ទាំង។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når UniConnect er inaktiv, aktiverer det første klikket kun vinduet. Klikk igjen for å fokusere ruten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy UniConnect jest nieaktywne, pierwsze kliknięcie aktywuje jedynie okno. Kliknij ponownie, aby ustawić fokus panelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando UniConnect está inativo, o primeiro clique apenas ativa a janela. Clique novamente para focar o painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда UniConnect неактивно, первый щелчок только активирует окно. Нажмите еще раз, чтобы сфокусировать панель."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ UniConnect ไม่ได้ใช้งาน การคลิกครั้งแรกจะเปิดใช้งานเฉพาะหน้าต่างเท่านั้นคลิกอีกครั้งเพื่อโฟกัสบานหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect etkin olmadığında, ilk tıklama yalnızca pencereyi etkinleştirir. Bölmeye odaklanmak için tekrar tıklayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当UniConnect处于非活动状态时，第一次单击仅激活该窗口。再次单击以聚焦窗格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當UniConnect處於非活動狀態時，第一次按一下僅啟動該視窗。再次按一下以對焦窗格。"
          }
        }
      }
    },
    "settings.app.paneFirstClickFocus.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When UniConnect is inactive, clicking a pane activates the window and focuses that pane in one click."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnectが非アクティブのとき、ペインをクリックすると1回でウインドウをアクティブにしてそのペインへフォーカスします。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли UniConnect неактивний, клік на панель активує вікно та фокусує панель одним кліком."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect가 비활성 상태일 때, 패인을 클릭하면 윈도우 활성화와 패인 포커스가 한 번에 이루어집니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يكون UniConnect غير نشط، يؤدي النقر فوق جزء إلى تنشيط النافذة وتركيز هذا الجزء بنقرة واحدة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada UniConnect nije aktivan, klik na okno aktivira prozor i fokusira to okno jednim klikom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når UniConnect er inaktivt, aktiveres vinduet ved at klikke på en rude og fokuserer den med ét klik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn UniConnect inaktiv ist, wird durch Klicken auf einen Bereich das Fenster aktiviert und dieser Bereich mit einem Klick fokussiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando UniConnect esté inactivo, un clic en un panel activará la ventana y enfocará ese panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque UniConnect est inactif, cliquer sur un volet active la fenêtre et focalise ce volet en un seul clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando UniConnect è inattivo, facendo clic su un riquadro si attiva la finestra e si focalizza quel riquadro con un clic."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅពេលដែល UniConnect អសកម្ម ការចុចផ្ទាំងមួយនឹងធ្វើឱ្យបង្អួចសកម្ម ហើយផ្តោតលើផ្ទាំងនោះដោយចុចតែម្តង។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når UniConnect er inaktiv, aktiveres vinduet ved å klikke på en rute og fokuserer den med ett klikk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy UniConnect jest nieaktywny, kliknięcie panelu aktywuje okno i skupia je jednym kliknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando UniConnect está inativo, clicar em um painel ativa a janela e foca esse painel com um clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда UniConnect неактивен, щелчок по панели активирует окно и фокусирует эту панель одним щелчком мыши."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ UniConnect ไม่ได้ใช้งานอยู่ การคลิกบานหน้าต่างจะเป็นการเปิดใช้งานหน้าต่างและโฟกัสบานหน้าต่างนั้นด้วยการคลิกเพียงครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect etkin olmadığında, bir bölmeye tıklamak pencereyi etkinleştirir ve o bölmeye tek tıklamayla odaklanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 UniConnect 处于非活动状态时，单击某个窗格将激活该窗口并单击一次即可聚焦该窗格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 UniConnect 處於非活動狀態時，按一下某個窗格將啟動該視窗並按一下一次即可聚焦該窗格。"
          }
        }
      }
    },

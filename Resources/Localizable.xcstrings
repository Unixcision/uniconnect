        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux-koden kan bare inneholde bokstaver, tall, bindestreker og understreker. Forslag: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod tmux może zawierać wyłącznie litery, cyfry, łączniki i podkreślenia. Sugestia: %@"

    "uniconnect.localWindow.error.agentStillRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use /exit to return to the shell before starting, resuming, or changing this window."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم /exit للعودة إلى الصدفة قبل بدء هذه النافذة أو استئنافها أو تغييرها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite /exit da se vratite na ljusku prije pokretanja, nastavka ili promjene ovog prozora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug /exit for at vende tilbage til skallen, før du starter, genoptager eller ændrer dette vindue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie /exit, um zur Shell zurückzukehren, bevor Sie dieses Fenster starten, fortsetzen oder ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa /exit para volver al shell antes de iniciar, reanudar o cambiar esta ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez /exit pour revenir au shell avant de démarrer, de reprendre ou de modifier cette fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzare /exit per tornare alla shell prima di avviare, riprendere o modificare questa finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィンドウを開始、再開、または変更する前に、/exit を使用してシェルに戻ります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប្រើ / ចេញ ដើម្បីត្រឡប់ទៅសែល មុនពេលចាប់ផ្តើម បន្ត ឬផ្លាស់ប្តូរបង្អួចនេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창을 시작, 재개 또는 변경하기 전에 /exit를 사용하여 셸로 돌아갑니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk /exit for å gå tilbake til skallet før du starter, gjenopptar eller endrer dette vinduet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj /exit, aby powrócić do powłoki przed uruchomieniem, wznowieniem lub zmianą tego okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use /exit para retornar ao shell antes de iniciar, retomar ou alterar esta janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте /exit, чтобы вернуться в оболочку перед запуском, возобновлением или изменением этого окна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ /exit เพื่อกลับสู่เชลล์ก่อนเริ่ม ดำเนินการต่อ หรือเปลี่ยนแปลงหน้าต่างนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pencereyi başlatmadan, devam ettirmeden veya değiştirmeden önce kabuğa dönmek için /exit komutunu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте /exit, щоб повернутися до оболонки перед запуском, відновленням або зміною цього вікна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在启动、恢复或更改此窗口之前，请使用 /exit 返回 shell。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在啟動、復原或變更此視窗之前，請使用 /exit 返回 shell。"
          }
        }
      }
    },

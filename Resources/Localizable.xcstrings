    "claudeUpdate.preparing.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم UniConnect بحل UUIDs ومجلدات العمل والملفات التنفيذية والمضيفين وأجزاء tmux قبل إرسال أي إدخال."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect rješava UUIDs, radne mape, izvršne datoteke, hostove i tmux okna prije slanja bilo kakvog unosa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect løser UUIDs, arbejdsmapper, eksekverbare filer, værter og tmux-ruder, før der sendes input."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect löst UUIDs, Arbeitsordner, ausführbare Dateien, Hosts und tmux-Bereiche auf, bevor Eingaben gesendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect is resolving UUIDs, working folders, executables, hosts, and tmux panes before any input is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect está resolviendo UUIDs, carpetas de trabajo, archivos ejecutables, hosts y paneles tmux antes de enviar cualquier entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect résout UUIDs, les dossiers de travail, les exécutables, les hôtes et les volets tmux avant l'envoi de toute entrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect sta risolvendo UUIDs, cartelle di lavoro, file eseguibili, host e riquadri tmux prima che venga inviato qualsiasi input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect は、入力が送信される前に UUIDs、作業フォルダー、実行可能ファイル、ホスト、および tmux ペインを解決しています。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect កំពុងកំណត់ UUID ថតការងារ ឯកសារប្រតិបត្តិ ម៉ាស៊ីន និងផ្ទាំង tmux មុនពេលផ្ញើការបញ្ចូលណាមួយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect는 입력을 보내기 전에 UUID, 작업 폴더, 실행 파일, 호스트 및 tmux 분할 영역을 확인합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect løser UUIDs, arbeidsmapper, kjørbare filer, verter og tmux-ruter før noen inndata sendes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect rozwiązuje UUIDs, foldery robocze, pliki wykonywalne, hosty i panele tmux przed wysłaniem jakichkolwiek danych wejściowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect está resolvendo UUIDs, pastas de trabalho, executáveis, hosts e painéis tmux antes de qualquer entrada ser enviada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect разрешает UUIDs, рабочие папки, исполняемые файлы, хосты и панели tmux перед отправкой каких-либо входных данных."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect กำลังแก้ไข UUIDs, โฟลเดอร์การทำงาน, ไฟล์ปฏิบัติการ, โฮสต์ และบานหน้าต่าง tmux ก่อนที่จะส่งอินพุตใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect, herhangi bir giriş gönderilmeden önce UUIDs'yu, çalışma klasörlerini, yürütülebilir dosyaları, ana bilgisayarları ve tmux bölmelerini çözüyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect розв’язує UUIDs, робочі папки, виконувані файли, хости та панелі tmux перед надсиланням будь-яких введених даних."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 在发送任何输入之前正在解析 UUIDs、工作文件夹、可执行文件、主机和 tmux 窗格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 在傳送任何輸入之前正在解析 UUIDs、工作資料夾、可執行檔、主機和 tmux 窗格。"
          }
        }
      }
    },
    "claudeUpdate.preparing.title": {

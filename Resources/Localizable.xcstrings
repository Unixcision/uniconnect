    "uniconnect.ssh.validation.unsupportedCommand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command must start with `ssh` or `sshpass` (for example, `ssh -i key.pem root@host` or `sshpass -p 'password' ssh root@host`)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يبدأ الأمر بـ `ssh` أو `sshpass` (على سبيل المثال، `ssh -i key.pem root@host` أو `sshpass -p 'password' ssh root@host`)."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Komanda mora početi sa `ssh` ili `sshpass` (na primjer, `ssh -i key.pem root@host` ili `sshpass -p 'password' ssh root@host`)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoen skal starte med `ssh` eller `sshpass` (f.eks. `ssh -i key.pem root@host` eller `sshpass -p 'password' ssh root@host`)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl muss mit `ssh` oder `sshpass` beginnen (zum Beispiel `ssh -i key.pem root@host` oder `sshpass -p 'password' ssh root@host`)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando debe comenzar con `ssh` o `sshpass` (por ejemplo, `ssh -i key.pem root@host` o `sshpass -p 'password' ssh root@host`)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande doit commencer par `ssh` ou `sshpass` (par exemple, `ssh -i key.pem root@host` ou `sshpass -p 'password' ssh root@host`)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando deve iniziare con `ssh` o `sshpass` (ad esempio, `ssh -i key.pem root@host` o `sshpass -p 'password' ssh root@host`)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドは `ssh` または `sshpass` で始まる必要があります (たとえば、`ssh -i key.pem root@host` または `sshpass -p 'password' ssh root@host`)。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពាក្យបញ្ជាត្រូវតែចាប់ផ្តើមដោយ `ssh` ឬ `sshpass` (ឧទាហរណ៍ `ssh -i key.pem root@host` ឬ `sshpass -p 'password' ssh root@host`)។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령은 `ssh` 또는 `sshpass`로 시작해야 합니다(예: `ssh -i key.pem root@host` 또는 `sshpass -p 'password' ssh root@host`)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoen må starte med `ssh` eller `sshpass` (for eksempel `ssh -i key.pem root@host` eller `sshpass -p 'password' ssh root@host`)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie musi zaczynać się od `ssh` lub `sshpass` (na przykład `ssh -i key.pem root@host` lub `sshpass -p 'password' ssh root@host`)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando deve começar com `ssh` ou `sshpass` (por exemplo, `ssh -i key.pem root@host` ou `sshpass -p 'password' ssh root@host`)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда должна начинаться с `ssh` или `sshpass` (например, `ssh -i key.pem root@host` или `sshpass -p 'password' ssh root@host`)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่งต้องเริ่มต้นด้วย `ssh` หรือ `sshpass` (ตัวอย่างเช่น `ssh -i key.pem root@host` หรือ `sshpass -p 'password' ssh root@host`)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Komut `ssh` veya `sshpass` ile başlamalıdır (örneğin, `ssh -i key.pem root@host` veya `sshpass -p 'password' ssh root@host`)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда має починатися з `ssh` або `sshpass` (наприклад, `ssh -i key.pem root@host` або `sshpass -p 'password' ssh root@host`)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该命令必须以 `ssh` 或 `sshpass` 开头（例如，`ssh -i key.pem root@host` 或 `sshpass -p 'password' ssh root@host`）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此指令必須以 `ssh` 或 `sshpass` 開頭（例如，`ssh -i key.pem root@host` 或 `sshpass -p 'password' ssh root@host`）。"
          }
        }
      }
    },
    "uniconnect.ssh.window.duplicate.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" already owns tmux session \"%@\" on this SSH endpoint. UniConnect will not open a second client on the same target."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمتلك \"%@\" بالفعل جلسة tmux \"%@\" على نقطة النهاية SSH هذه.لن يقوم UniConnect بفتح عميل ثانٍ على نفس الهدف."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" već posjeduje tmux sesiju \"%@\" na ovoj SSH krajnjoj točki. UniConnect neće otvoriti drugog klijenta na istom cilju."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ejer allerede tmux session \"%@\" på dette SSH slutpunkt. UniConnect åbner ikke en anden klient på det samme mål."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ besitzt bereits die tmux Sitzung „%@“ auf diesem SSH Endpunkt. UniConnect öffnet keinen zweiten Client auf demselben Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ya usa la sesión tmux \"%@\" en este destino SSH. UniConnect no abrirá un segundo cliente en el mismo destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" possède déjà la session tmux \"%@\" sur ce point de terminaison SSH. UniConnect n'ouvrira pas de deuxième client sur la même cible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" possiede già la tmux sessione \"%@\" su questo SSH endpoint. UniConnect non aprirà un secondo client sulla stessa destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は、この SSH エンドポイント上の tmux セッション「%@」をすでに所有しています。UniConnect は、同じターゲット上で 2 番目のクライアントを開きません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" រួចហើយ tmux វគ្គ \"%@\" លើចំណុចបញ្ចប់ SSH នេះ។UniConnect នឹងមិនបើកម៉ាស៊ីនភ្ញៀវទីពីរលើគោលដៅដូចគ្នាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"은(는) 이 SSH 엔드포인트에서 tmux 세션 \"%@\"을(를) 이미 소유하고 있습니다. UniConnect는 동일한 대상에서 두 번째 클라이언트를 열지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» eier allerede tmux økt «%@» på dette SSH endepunktet. UniConnect vil ikke åpne en ekstra klient på samme mål."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” jest już właścicielem tmux sesji „%@” w tym SSH punkcie końcowym. UniConnect nie otworzy drugiego klienta w tym samym miejscu docelowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" já possui a sessão tmux \"%@\" neste terminal SSH. UniConnect não abrirá um segundo cliente no mesmo destino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже владеет tmux сеансом «%@» на этой конечной точке SSH. UniConnect не откроет второй клиент на той же цели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" เป็นเจ้าของ tmux เซสชัน \"%@\" บนปลายทาง SSH นี้แล้วUniConnect จะไม่เปิดไคลเอนต์ที่สองบนเป้าหมายเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" zaten bu SSH uç noktasında tmux \"%@\" oturumuna sahip. UniConnect aynı hedefte ikinci bir istemci açmayacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" вже володіє tmux сеансом \"%@\" на цій кінцевій точці SSH. UniConnect не відкриє другий клієнт на тій же цілі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已在此 SSH 端点上拥有 tmux 会话“%@”。UniConnect 不会在同一目标上打开第二个客户端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已在此 SSH 端點上擁有 tmux 會話「%@」。UniConnect 不會在相同目標上開啟第二個客戶端。"
          }
        }
      }
    },

    "uniconnect.ssh.failure.sudo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This user does not have passwordless sudo, so tmux cannot be installed. Install it manually or connect as root."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لدى هذا المستخدم sudo بدون كلمة مرور، لذلك لا يمكن تثبيت tmux.قم بتثبيته يدويًا أو قم بالاتصال كجذر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj korisnik nema sudo bez lozinke, tako da tmux ne može biti instaliran. Instalirajte ga ručno ili se povežite kao root."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne bruger har ikke sudo uden adgangskode, så tmux kan ikke installeres. Installer det manuelt eller tilslut som root."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Benutzer verfügt nicht über passwortloses Sudo, daher kann tmux nicht installiert werden. Installieren Sie es manuell oder verbinden Sie sich als Root."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este usuario no tiene sudo sin contraseña, por lo que no se puede instalar tmux. Instálalo manualmente o conéctate como root."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet utilisateur ne dispose pas de sudo sans mot de passe, donc tmux ne peut pas être installé. Installez-le manuellement ou connectez-vous en tant que root."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo utente non dispone di sudo senza password, quindi tmux non può essere installato. Installalo manualmente o connettiti come root."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このユーザーはパスワードなしの sudo を持っていないため、tmux をインストールできません。手動でインストールするか、root として接続します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកប្រើប្រាស់នេះមិនមាន sudo គ្មានពាក្យសម្ងាត់ទេ ដូច្នេះ tmux មិនអាចដំឡើងបានទេ។ដំឡើងវាដោយដៃឬភ្ជាប់ជា root ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사용자는 비밀번호 없는 sudo가 없으므로 tmux을(를) 설치할 수 없습니다.수동으로 설치하거나 루트로 연결하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne brukeren har ikke passordløs sudo, så tmux kan ikke installeres. Installer den manuelt eller koble til som root."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten użytkownik nie ma sudo bez hasła, dlatego nie można zainstalować programu tmux. Zainstaluj go ręcznie lub połącz się jako root."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este usuário não possui sudo sem senha, portanto tmux não pode ser instalado. Instale-o manualmente ou conecte-se como root."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого пользователя нет sudo без пароля, поэтому tmux невозможно установить. Установите его вручную или подключитесь как root."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใช้รายนี้ไม่มี sudo ที่ไม่มีรหัสผ่าน ดังนั้นจึงไม่สามารถติดตั้ง tmux ได้ติดตั้งด้วยตนเองหรือเชื่อมต่อในฐานะรูท"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kullanıcının şifresiz sudo'su yok, dolayısıyla tmux yüklenemiyor. Manuel olarak yükleyin veya root olarak bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей користувач не має sudo без пароля, тому tmux неможливо встановити. Встановіть його вручну або підключіться як root."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该用户没有无密码 sudo，因此无法安装tmux。手动安装或以 root 身份连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該用戶沒有無密碼 sudo，因此無法安裝tmux。手動安裝或以 root 身分連線。"
          }
        }
      }
    },

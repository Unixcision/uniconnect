    "settings.account.unavailable.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in and cloud sync stay off until UniConnect's own service is configured."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل تسجيل الدخول والمزامنة السحابية متوقفين حتى يتم تكوين خدمة UniConnect الخاصة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava i sinhronizacija u oblaku ostaju isključeni dok se ne konfiguriše vlastita usluga UniConnect."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log-in og skysynkronisering forbliver slået fra, indtil UniConnect's egen tjeneste er konfigureret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung und Cloud-Synchronisierung bleiben deaktiviert, bis der eigene Dienst von UniConnect konfiguriert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión y la sincronización en la nube permanecen desactivados hasta que se configure el propio servicio de UniConnect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion et la synchronisation dans le cloud restent désactivées jusqu'à ce que le propre service de UniConnect soit configuré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso e la sincronizzazione cloud rimangono disattivati ​​finché non viene configurato il servizio di UniConnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 独自のサービスが設定されるまで、サインインとクラウド同期はオフのままです。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូល និងការធ្វើសមកាលកម្មលើពពកនឹងបិទរហូតដល់សេវាកម្មផ្ទាល់ខ្លួនរបស់ UniConnect ត្រូវបានកំណត់រចនាសម្ព័ន្ធ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect의 자체 서비스가 구성될 때까지 로그인 및 클라우드 동기화는 꺼진 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pålogging og skysynkronisering forblir av til UniConnects egen tjeneste er konfigurert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie i synchronizacja w chmurze pozostają wyłączone do czasu skonfigurowania własnej usługi UniConnect."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login e a sincronização na nuvem permanecem desativados até que o próprio serviço do UniConnect seja configurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в систему и облачная синхронизация остаются отключенными до тех пор, пока не будет настроена собственная служба UniConnect."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้และการซิงค์บนคลาวด์จะปิดอยู่จนกว่าจะกำหนดค่าบริการของ UniConnect เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açma ve bulut senkronizasyonu, UniConnect'nin kendi hizmeti yapılandırılana kadar kapalı kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід і хмарна синхронізація залишаються вимкненими, доки не буде налаштовано власну службу UniConnect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在配置 UniConnect 自己的服务之前，登录和云同步将保持关闭状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定 UniConnect 自己的服務之前，登入和雲端同步將保持關閉。"
          }
        }
      }
    },

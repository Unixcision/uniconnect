            "value": "Ovaj prozor više nije povezan s boxom. Otvorite ili vratite prozor, pa pokušajte ponovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vindue er ikke længere knyttet til en boks. Åbn eller gendan vinduet, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Fenster ist keiner Box mehr zugeordnet. Öffne das Fenster oder stelle es wieder her und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window is no longer attached to a box. Open or restore the window, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ventana ya no está vinculada a una caja. Abre o restaura la ventana y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fenêtre n’est plus rattachée à une box. Ouvrez ou restaurez la fenêtre, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa finestra non è più collegata a una box. Apri o ripristina la finestra, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィンドウはボックスに接続されていません。ウィンドウを開くか復元して、もう一度お試しください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បង្អួចនេះលែងភ្ជាប់ទៅប្រអប់ទៀតហើយ។ បើក ឬស្ដារបង្អួច រួចព្យាយាមម្តងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창은 더 이상 박스에 연결되어 있지 않습니다. 창을 열거나 복원한 후 다시 시도하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vinduet er ikke lenger knyttet til en boks. Åpne eller gjenopprett vinduet, og prøv på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To okno nie jest już przypisane do boxa. Otwórz lub przywróć okno i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta janela não está mais vinculada a uma box. Abra ou restaure a janela e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это окно больше не связано с Box. Откройте или восстановите окно, затем повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่างนี้ไม่ได้เชื่อมกับกล่องแล้ว เปิดหรือกู้คืนหน้าต่าง แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pencere artık bir kutuya bağlı değil. Pencereyi açın veya geri yükleyin, ardından yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це вікно більше не прив’язане до Box. Відкрийте або відновіть вікно, а потім повторіть спробу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗口已不再附加到 Box。请打开或恢复该窗口，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此視窗已不再附加至 Box。請開啟或復原該視窗，然後再試一次。"
          }
        }
      }
    },

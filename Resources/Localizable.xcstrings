    "cli.sidebar.usage": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso: cmux sidebar <validate|reload|select> [name|--all] [--json]\n\nValida, recarga o selecciona barras laterales izquierdas personalizadas de ~/.config/uniconnect/sidebars.\nLos archivos Swift tienen prioridad sobre los JSON con el mismo nombre base.\n\nComandos:\n  validate [name]   Valida todas las barras laterales personalizadas o una con ese nombre\n  reload [name]     Valida todas las barras laterales y recarga las que sean válidas\n  select <name>     Valida y activa una barra lateral personalizada\n\nEjemplos:\n  cmux sidebar validate\n  cmux sidebar reload --all\n  cmux sidebar select finder.tree"
          }
        }
      }
    },

    "cli.hooks.error.configUninstallUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exists but could not be read. Fix permissions or remove it before uninstalling %@ UniConnect hooks. %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ موجود ولكن لا يمكن قراءته.قم بإصلاح الأذونات أو إزالتها قبل إلغاء تثبيت %@ UniConnect hooks.%@"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ postoji, ali se ne može pročitati. Popravite dozvole ili ih uklonite prije deinstaliranja %@ UniConnect hooks.%@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eksisterer, men kunne ikke læses. Ret tilladelser eller fjern det, før du afinstallerer %@ UniConnect hooks.%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existiert, konnte aber nicht gelesen werden. Korrigieren Sie die Berechtigungen oder entfernen Sie sie, bevor Sie %@ UniConnect hooks deinstallieren.%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe pero no se pudo leer. Corrija los permisos o elimínelos antes de desinstalar %@ UniConnect hooks.%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe mais n'a pas pu être lu. Corrigez les autorisations ou supprimez-les avant de désinstaller %@ UniConnect hooks.%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esiste ma non può essere letto. Correggere le autorizzazioni o rimuoverle prima di disinstallare %@ UniConnect hooks.%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は存在しますが、読み取れませんでした。%@ UniConnect hooks をアンインストールする前に、権限を修正するか削除してください。%@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ មាន ប៉ុន្តែមិនអាចអានបានទេ។ជួសជុលការអនុញ្ញាត ឬលុបវាចេញ មុនពេលលុបការដំឡើង %@ UniConnect hooks ។%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@가 존재하지만 읽을 수 없습니다.%@ UniConnect hooks를 제거하기 전에 권한을 수정하거나 제거하세요.%@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eksisterer, men kunne ikke leses. Fiks tillatelser eller fjern det før du avinstallerer %@ UniConnect hooks.%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ istnieje, ale nie można go odczytać. Napraw uprawnienia lub usuń je przed odinstalowaniem %@ UniConnect hooks.%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe, mas não pôde ser lido. Corrija as permissões ou remova-as antes de desinstalar %@ UniConnect hooks.%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ существует, но не может быть прочитан. Исправьте разрешения или удалите их перед удалением %@ UniConnect hooks.%@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ มีอยู่แล้วแต่ไม่สามารถอ่านได้แก้ไขการอนุญาตหรือลบออกก่อนที่จะถอนการติดตั้ง %@ UniConnect hooks%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ var ancak okunamadı.%@ UniConnect hooks'yi kaldırmadan önce izinleri düzeltin veya kaldırın.%@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ існує, але його не вдалося прочитати. Виправте дозволи або видаліть його перед видаленням %@ UniConnect hooks.%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 存在但无法读取。在卸载 %@ UniConnect hooks 之前修复权限或将其删除。%@"
          }
        },
        "zh-Hant": {

    "dialog.textURL.rules.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@:// link is asking UniConnect to paste rules into the current workspace. UniConnect cannot verify which website or app opened this link.\n\nUniConnect will paste the rules into the terminal and will not write files or press Return. Only continue if you trust these rules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// リンクが現在のワークスペースにルールをペーストするよう UniConnect に要求しています。UniConnect は、このリンクを開いた Web サイトやアプリを確認できません。\n\nUniConnect はルールをターミナルに貼り付け、ファイルへの書き込みや Return の押下は行いません。このルールを信頼している場合のみ続行してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب رابط %@:// من UniConnect لصق القواعد في مساحة العمل الحالية. لا يمكن لـ UniConnect التحقق من موقع الويب أو التطبيق الذي فتح هذا الرابط.\n\nسيقوم UniConnect بلصق القواعد في الطرفية ولن يقوم بكتابة الملفات أو الضغط على Return. استمر فقط إذا كنت تثق بهذه القواعد."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// 링크는 UniConnect에게 규칙을 현재 작업공간에 붙여넣도록 요청합니다. UniConnect는 어떤 웹사이트나 앱이 이 링크를 열었는지 확인할 수 없습니다.\n\nUniConnect는 규칙을 터미널에 붙여넣고 파일을 쓰거나 Return를 누르지 않습니다. 이 규칙을 신뢰하는 경우에만 계속하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace %@:// solicita a UniConnect que pegue reglas en el espacio de trabajo actual. UniConnect no puede verificar qué sitio web o aplicación abrió este enlace.\n\nUniConnect pegará las reglas en el terminal y no escribirá archivos ni presionará Return. Continúe solo si confía en estas reglas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein %@://-Link fordert UniConnect auf, Regeln in den aktuellen Arbeitsbereich einzufügen. UniConnect kann nicht überprüfen, welche Website oder App diesen Link geöffnet hat.\n\nUniConnect fügt die Regeln in das Terminal ein, schreibt keine Dateien und drückt auch nicht Return. Fahren Sie nur fort, wenn Sie diesen Regeln vertrauen."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// link traži od UniConnect da zalijepi pravila u trenutni radni prostor. UniConnect ne može provjeriti koja je web lokacija ili aplikacija otvorila ovu vezu.\n\nUniConnect će zalijepiti pravila u terminal i neće pisati datoteke niti pritisnuti Return. Nastavite samo ako vjerujete ovim pravilima."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et %@://-link beder UniConnect om at indsætte regler i det aktuelle arbejdsområde. UniConnect kan ikke bekræfte, hvilken hjemmeside eller app der åbnede dette link.\n\nUniConnect indsætter reglerne i terminalen og vil ikke skrive filer eller trykke på Return. Fortsæt kun, hvis du stoler på disse regler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка %@:// запрашивает UniConnect вставить правила в текущую рабочую область. UniConnect не может проверить, какой веб-сайт или приложение открыло эту ссылку.\n\nUniConnect вставит правила в терминал, не будет записывать файлы или нажимать Return. Продолжайте, только если вы доверяете этим правилам."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien %@:// demande à UniConnect de coller des règles dans l'espace de travail actuel. UniConnect ne peut pas vérifier quel site Web ou quelle application a ouvert ce lien.\n\nUniConnect collera les règles dans le terminal, n'écrira pas de fichiers et n'appuiera pas sur Return. Ne continuez que si vous faites confiance à ces règles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un collegamento %@:// chiede a UniConnect di incollare le regole nell'area di lavoro corrente. UniConnect non può verificare quale sito Web o app ha aperto questo collegamento.\n\nUniConnect incollerà le regole nel terminale e non scriverà file né premerà Return. Continua solo se ti fidi di queste regole."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@://-kobling ber UniConnect lime inn regler i det gjeldende arbeidsområdet. UniConnect kan ikke bekrefte hvilken nettside eller app som åpnet denne koblingen.\n\nUniConnect vil lime inn reglene i terminalen og vil ikke skrive filer eller trykke Return. Fortsett bare hvis du stoler på disse reglene."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir %@:// bağlantısı, UniConnect'ten kuralları geçerli çalışma alanına yapıştırmasını istiyor. UniConnect bu bağlantıyı hangi web sitesinin veya uygulamanın açtığını doğrulayamıyor.\n\nUniConnect, kuralları terminale yapıştıracak ve dosya yazmayacak veya Return'e basmayacak. Yalnızca bu kurallara güveniyorsanız devam edin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link %@:// prosi UniConnect o wklejenie reguł do bieżącego obszaru roboczego. UniConnect nie może sprawdzić, która witryna lub aplikacja otworzyła ten link.\n\nUniConnect wklei reguły do terminala, nie zapisze plików ani nie naciśnie Return. Kontynuuj tylko wtedy, gdy ufasz tym zasadom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link %@:// está solicitando que UniConnect cole regras no espaço de trabalho atual. UniConnect não pode verificar qual site ou aplicativo abriu este link.\n\nUniConnect colará as regras no terminal e não gravará arquivos nem pressionará Return. Continue apenas se você confiar nessas regras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// 链接要求 UniConnect 将规则粘贴到当前工作区中。 UniConnect 无法验证哪个网站或应用程序打开了此链接。\n\nUniConnect 会将规则粘贴到终端中，并且不会写入文件或按 Return。仅当您信任这些规则时才继续。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "តំណ %@:// កំពុងស្នើសុំឱ្យ UniConnect បិទភ្ជាប់ច្បាប់ទៅក្នុងកន្លែងធ្វើការបច្ចុប្បន្ន។ UniConnect មិនអាចផ្ទៀងផ្ទាត់គេហទំព័រ ឬកម្មវិធីណាមួយដែលបើកតំណនេះទេ។\n\nUniConnect នឹងបិទភ្ជាប់ច្បាប់ទៅក្នុងស្ថានីយ ហើយនឹងមិនសរសេរឯកសារ ឬចុច Return ទេ។ បន្ត ប្រសិនបើអ្នកជឿជាក់លើច្បាប់ទាំងនេះ។"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์ %@:// กำลังขอให้ UniConnect วางกฎลงในพื้นที่ทำงานปัจจุบัน UniConnect ไม่สามารถตรวจสอบได้ว่าเว็บไซต์หรือแอปใดเปิดลิงก์นี้\n\nUniConnect จะวางกฎลงในเทอร์มินัล และจะไม่เขียนไฟล์หรือกด Return ดำเนินการต่อหากคุณเชื่อถือกฎเหล่านี้เท่านั้น"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання %@:// просить UniConnect вставити правила в поточну робочу область. UniConnect не може перевірити, який веб-сайт або додаток відкрив це посилання.\n\nUniConnect вставить правила в термінал і не буде записувати файли або натискати Return. Продовжуйте, лише якщо ви довіряєте цим правилам."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:// 連結要求 UniConnect 將規則貼到目前工作區。 UniConnect 無法驗證哪個網站或應用程式開啟了此連結。\n\nUniConnect 會將規則貼到終端機中，並且不會寫入檔案或按 Return。僅當您信任這些規則時才繼續。"
          }
        }
      }
    },

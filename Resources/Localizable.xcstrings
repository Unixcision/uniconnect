        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre mise à jour ou récupération de Claude est déjà en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro aggiornamento o ripristino Claude è già in esecuzione."

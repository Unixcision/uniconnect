    "dialog.enableNotifications.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات معطلة لـ UniConnect. قم بتفعيلها في إعدادات النظام لرؤية التنبيهات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavještenja su onemogućena za UniConnect. Omogućite ih u Postavkama sistema da biste vidjeli upozorenja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er deaktiveret for UniConnect. Aktiver dem i Systemindstillinger for at se advarsler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind für UniConnect deaktiviert. Aktivieren Sie sie in den Systemeinstellungen, um Hinweise zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled for UniConnect. Enable them in System Settings to see alerts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para UniConnect. Actívalas en Ajustes del Sistema para ver alertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour UniConnect. Activez-les dans les Réglages Système pour voir les alertes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disabilitate per UniConnect. Abilitale nelle Impostazioni di Sistema per visualizzare gli avvisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnectの通知が無効になっています。通知を表示するにはシステム設定で有効にしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជូនដំណឹងត្រូវបានបិទសម្រាប់ UniConnect។ បើកពួកវានៅក្នុងការកំណត់ប្រព័ន្ធ ដើម្បីមើលការជូនដំណឹង។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect에 대한 알림이 비활성화되어 있습니다. 알림을 보려면 시스템 설정에서 활성화하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er deaktivert for UniConnect. Aktiver dem i Systeminnstillinger for å se varsler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są wyłączone dla UniConnect. Włącz je w Ustawieniach systemowych, aby widzieć alerty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o UniConnect. Ative-as nos Ajustes do Sistema para ver os alertas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления для UniConnect отключены. Включите их в Системных настройках, чтобы видеть оповещения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนถูกปิดใช้งานสำหรับ UniConnect เปิดใช้งานในการตั้งค่าระบบเพื่อดูการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect için bildirimler devre dışı. Uyarıları görmek için Sistem Ayarları'nda etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення для UniConnect вимкнено. Увімкніть їх у Системних налаштуваннях, щоб бачити повідомлення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 的通知已被禁用。请在系统设置中启用通知以接收提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 的通知已停用。請在「系統設定」中啟用，以接收提示。"
          }
        }
      }
    },

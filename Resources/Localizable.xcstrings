    "cli.hooks.error.tooManyTargets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many hooks targets: specify at most one positional agent."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك عدد كبير جدًا من أهداف hooks: حدد agent موضعيًا واحدًا على الأكثر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše hooks ciljeva: navedite najviše jedan pozicioni agent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange hooks-mål: Angiv højst én positionel agent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele hooks-Ziele: Geben Sie höchstens ein positionelles agent an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados objetivos hooks: especifique como máximo un agent posicional."

          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد لصق القواعد من رابط خارجي؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln von einem externen Link einfügen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Pegar reglas desde un enlace externo?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsætte regler fra et eksternt link?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colar regras de um link externo?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 링크에서 규칙을 붙여넣으시겠습니까?"
          }
        },
        "bs": {

    "uniconnect.import.windowAction.unchanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the existing window unchanged"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالنافذة الحالية دون تغيير"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostavite postojeći prozor nepromijenjenim"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold det eksisterende vindue uændret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie das vorhandene Fenster unverändert bei"
          }

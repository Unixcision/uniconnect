            "state": "translated",
            "value": "OK"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "terminal.imageTransfer.error.emptyRemoteUploadResult": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file transfer finished without returning a remote file path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia terminó sin devolver una ruta para el archivo remoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル転送は完了しましたが、リモートファイルのパスが返されませんでした。"
          }
        }
      }
    },
    "terminal.imageTransfer.error.incompleteRemoteUploadResult": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file transfer didn't return a remote path for every selected file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia no devolvió una ruta remota para cada archivo seleccionado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したすべてのファイルについてリモートパスが返されませんでした。"
          }
        }
      }
    },
    "terminal.imageTransfer.error.mismatchedFileExplorerSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected File Explorer path belongs to a different session. Refresh File Explorer, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta seleccionada en el explorador de archivos pertenece a otra sesión. Actualiza el explorador de archivos e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルエクスプローラで選択したパスは別のセッションに属しています。ファイルエクスプローラを更新してから、もう一度お試しください。"
          }
        }
      }
    },
    "terminal.imageTransfer.error.missingSSHConnectCommand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This SSH box doesn't have a usable saved connection command. Edit the connection, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta caja SSH no tiene un comando de conexión guardado que se pueda usar. Edita la conexión e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このSSHボックスには使用可能な接続コマンドが保存されていません。接続を編集してから、もう一度お試しください。"
          }
        }
      }
    },
    "terminal.imageTransfer.error.nonUploadableRemoteItems": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only regular files can be attached to a remote session. Folders and mixed selections aren't supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden adjuntar archivos normales a una sesión remota. No se admiten carpetas ni selecciones mixtas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートセッションに添付できるのは通常のファイルだけです。フォルダやファイルとフォルダの混在選択には対応していません。"
          }
        }
      }
    },
    "terminal.imageTransfer.error.rejectedContent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard or dropped item doesn't contain text or a supported file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles o el elemento soltado no contiene texto ni un archivo compatible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードまたはドロップされた項目に、テキストや対応ファイルが含まれていません。"
          }
        }
      }
    },

      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep UniConnect in the menu bar for unread notifications and quick actions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読通知の確認やクイック操作のために、UniConnectをメニューバーに表示します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишати UniConnect у рядку меню для непрочитаних сповіщень та швидких дій."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽지 않은 알림과 빠른 작업을 위해 UniConnect를 메뉴 막대에 유지합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بـ UniConnect في شريط القائمة للإشعارات غير المقروءة والإجراءات السريعة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržite UniConnect na traci menija za nepročitane obavijesti i brze radnje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold UniConnect i menulinjen for ulæste meddelelser og hurtige handlinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie UniConnect in der Menüleiste für ungelesene Benachrichtigungen und schnelle Aktionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén UniConnect en la barra de menús para ver las notificaciones no leídas y acceder a acciones rápidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez UniConnect dans la barre de menu pour les notifications non lues et les actions rapides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni UniConnect nella barra dei menu per notifiche non lette e azioni rapide."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រក្សា UniConnect នៅក្នុងរបារម៉ឺនុយសម្រាប់ការជូនដំណឹងដែលមិនទាន់អាន និងសកម្មភាពរហ័ស។"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold UniConnect i menylinjen for uleste varsler og raske handlinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj UniConnect na pasku menu, aby uzyskać nieprzeczytane powiadomienia i szybkie działania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha UniConnect na barra de menu para notificações não lidas e ações rápidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте UniConnect в строке меню для непрочитанных уведомлений и быстрых действий."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บ UniConnect ไว้ในแถบเมนูสำหรับการแจ้งเตือนที่ยังไม่ได้อ่านและการดำเนินการด่วน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunmamış bildirimler ve hızlı işlemler için UniConnect öğesini menü çubuğunda tutun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 UniConnect 保留在菜单栏中以获取未读通知和快速操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 UniConnect 保留在功能表列中以取得未讀通知和快速操作。"
          }
        }
      }
    },

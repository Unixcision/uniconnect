          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое обновление или восстановление Claude уже запущено."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอัปเดตหรือการกู้คืน Claude อื่นกำลังทำงานอยู่แล้ว"
          }
        },
        "tr": {
          "stringUnit": {

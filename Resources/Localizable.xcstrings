          "stringUnit": {
            "state": "translated",
            "value": "UniConnect no recibió una configuración para la extensión de la barra lateral, así que no se compartieron datos ni acciones del espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect n'a pas reçu de configuration d'extension de barre latérale, donc aucune donnée ou action d'espace de travail n'a été partagée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect non ha ricevuto una configurazione dell'estensione della barra laterale, quindi non sono stati condivisi dati o azioni dell'area di lavoro."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect មិនបានទទួលការកំណត់រចនាសម្ព័ន្ធផ្នែកបន្ថែមរបារចំហៀង ដូច្នេះគ្មានទិន្នន័យ ឬសកម្មភាពណាមួយត្រូវបានចែករំលែកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect이(가) 사이드바 확장 구성을 수신하지 않았으므로 작업공간 데이터나 작업이 공유되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect mottok ikke en konfigurasjon av sidefeltutvidelse, så ingen arbeidsområdedata eller handlinger ble delt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect nie otrzymał konfiguracji rozszerzenia paska bocznego, więc nie udostępniono żadnych danych ani działań obszaru roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect não recebeu uma configuração de extensão da barra lateral, portanto, nenhum dado ou ação do espaço de trabalho foi compartilhado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не получил конфигурацию расширения боковой панели, поэтому никакие данные или действия в рабочей области не были переданы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect ไม่ได้รับการกำหนดค่าส่วนขยายแถบด้านข้าง ดังนั้นจึงไม่มีการแชร์ข้อมูลพื้นที่ทำงานหรือการดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect bir kenar çubuğu uzantısı yapılandırması almadığından hiçbir çalışma alanı verisi veya eylemi paylaşılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect не отримав конфігурацію розширення бічної панелі, тому жодні дані робочої області чи дії не надійшли."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 未收到侧边栏扩展配置，因此未共享工作区数据或操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UniConnect 未收到側邊欄擴充配置，因此未共用工作區資料或操作。"
          }
        }
      }
    },

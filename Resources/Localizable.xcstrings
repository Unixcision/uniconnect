    "uniconnect.import.encryptedFile.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ file saved on %2$@ with %3$lld boxes. Enter the password used to export it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ تم حفظ الملف في %2$@ بمربعات %3$lld.أدخل كلمة المرور المستخدمة لتصديرها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fajl sačuvan na %2$@ sa %3$lld kutijama. Unesite lozinku koja se koristi za izvoz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fil gemt på %2$@ med %3$lld bokse. Indtast adgangskoden, der blev brugt til at eksportere den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-Datei wurde auf %2$@ mit %3$lld-Boxen gespeichert. Geben Sie das zum Exportieren verwendete Passwort ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo de %1$@ guardado el %2$@ con %3$lld cajas. Introduce la contraseña con la que se exportó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fichier enregistré sur %2$@ avec les cases %3$lld. Saisissez le mot de passe utilisé pour l'exporter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ file salvato su %2$@ con %3$lld caselle. Inserisci la password utilizzata per esportarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ファイルは %3$lld ボックスとともに %2$@ に保存されました。エクスポートに使用するパスワードを入力します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ឯកសារត្រូវបានរក្សាទុកនៅលើ %2$@ ជាមួយនឹងប្រអប់ %3$lld ។បញ្ចូលពាក្យសម្ងាត់ដែលប្រើដើម្បីនាំចេញវា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 파일이 %2$@에 %3$lld 상자에 저장되었습니다.내보내기에 사용된 비밀번호를 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fil lagret på %2$@ med %3$lld bokser. Skriv inn passordet som ble brukt til å eksportere det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ plik zapisany w %2$@ z %3$lld polami. Wprowadź hasło użyte do jego wyeksportowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ arquivo salvo em %2$@ com caixas %3$lld. Digite a senha usada para exportá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ файл, сохраненный на %2$@ с полями %3$lld. Введите пароль, используемый для его экспорта."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ บันทึกไฟล์ใน %2$@ พร้อมกล่อง %3$lldป้อนรหัสผ่านที่ใช้ในการส่งออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dosyası %2$@ üzerine %3$lld kutularıyla kaydedildi. Dışa aktarmak için kullanılan şifreyi girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ файл збережено на %2$@ з полями %3$lld. Введіть пароль, використаний для його експорту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 文件保存在 %2$@ 上，并带有 %3$lld 框。输入用于导出的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 檔案儲存在 %2$@ 上，並附有 %3$lld 方塊。輸入用於導出的密碼。"
          }
        }
      }
    },

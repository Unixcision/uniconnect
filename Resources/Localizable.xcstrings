    "uniconnect.localWindow.runtime.savedConversation.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استئناف %@، أو بدء وكيل آخر دون فقدان السجل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavite %@, ili pokrenite drugog agenta bez gubitka historije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genoptag %@, eller start en anden agent uden at miste historikken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie %@ fort oder starten Sie einen anderen Agenten, ohne den Verlauf zu verlieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume %@, or start another agent without losing history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar %@ o iniciar otro agente sin perder el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez %@ ou démarrez un autre agent sans perdre l'historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprendi %@ o avvia un altro agente senza perdere la cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を再開するか、履歴を失わずに別のエージェントを開始します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ត %@ ឬចាប់ផ្តើមភ្នាក់ងារផ្សេងទៀតដោយមិនបាត់បង់ប្រវត្តិ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 재개하거나 기록을 잃지 않고 다른 에이전트를 시작하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett %@, eller start en annen agent uten å miste historikken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wznów %@ lub uruchom innego agenta bez utraty historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retome %@ ou inicie outro agente sem perder o histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновите работу %@ или запустите другого агента без потери истории."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการต่อ %@ หรือเริ่มตัวแทนอื่นโดยไม่สูญเสียประวัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devam ettirin veya geçmişi kaybetmeden başka bir temsilci başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновіть %@ або запустіть іншого агента без втрати історії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复%@，或启动另一个代理而不丢失历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復%@，或啟動另一個代理程式而不遺失歷史記錄。"
          }
        }
      }
    },

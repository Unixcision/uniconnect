    "uniconnect.import.preview.skippedRows": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflicts and rejected declarations cannot be selected. Safe Create and Update rows can still be imported."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحديد التعارضات والإعلانات المرفوضة. لا يزال من الممكن استيراد صفوف الإنشاء والتحديث الآمن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Konflikti i odbijene deklaracije se ne mogu odabrati. Redovi za sigurno kreiranje i ažuriranje i dalje se mogu uvoziti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konflikter og afviste erklæringer kan ikke vælges. Sikker oprettelse og opdateringsrækker kan stadig importeres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konflikte und abgelehnte Deklarationen können nicht ausgewählt werden. Safe Create- und Update-Zeilen können weiterhin importiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden seleccionar conflictos y declaraciones rechazadas. Las filas de creación y actualización seguras aún se pueden importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conflits et les déclarations rejetées ne peuvent pas être sélectionnés. Les lignes de création et de mise à jour sécurisées peuvent toujours être importées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile selezionare conflitti e dichiarazioni respinte. È ancora possibile importare le righe di creazione e aggiornamento sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "競合および拒否された宣言は選択できません。安全な作成行と更新行は引き続きインポートできます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជម្លោះ និងសេចក្តីប្រកាសដែលត្រូវបានបដិសេធមិនអាចជ្រើសរើសបានទេ។ ជួរដេកបង្កើត និងអាប់ដេតដោយសុវត្ថិភាពនៅតែអាចនាំចូលបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충돌 및 거부된 선언은 선택할 수 없습니다. 안전한 만들기 및 업데이트 행은 계속 가져올 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Konflikter og avviste erklæringer kan ikke velges. Safe Create and Update-rader kan fortsatt importeres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wybierać konfliktów i odrzuconych deklaracji. Nadal można importować wiersze bezpiecznego tworzenia i aktualizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflitos e declarações rejeitadas não podem ser selecionados. As linhas de criação e atualização segura ainda podem ser importadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфликты и отклоненные декларации не могут быть выбраны. Строки безопасного создания и обновления по-прежнему можно импортировать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเลือกข้อขัดแย้งและการประกาศที่ถูกปฏิเสธได้ แถวการสร้างและอัปเดตที่ปลอดภัยยังคงสามารถนำเข้าได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyuşmazlıklar ve reddedilen bildirimler seçilemez. Güvenli Oluşturma ve Güncelleme satırları hâlâ içe aktarılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфлікти та відхилені декларації не можна вибрати. Безпечне створення й оновлення рядків усе ще можна імпортувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能选择冲突和被拒绝的声明。仍然可以导入安全创建和更新行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能選擇衝突和被拒絕的聲明。仍然可以匯入安全建立和更新行。"
          }
        }
      }
    },

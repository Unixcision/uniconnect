    "settings.mobile.port.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Apply to change the port. UniConnect checks the port is free first: if it's in use, the current listener keeps running untouched; if it's free, it rebinds and connected devices reconnect on the new port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートを変更するには「適用」をクリックします。UniConnect はまずポートが空いているか確認します。使用中の場合は現在のリスナーをそのまま維持し、空いている場合は再バインドして、接続中のデバイスは新しいポートで再接続します。"
          }
        }
      }
    },

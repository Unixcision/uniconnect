        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym zakresie nie znaleziono żadnego bezpiecznie identyfikowalnego okna Claude."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
